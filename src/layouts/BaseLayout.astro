---
import { ClientRouter } from 'astro:transitions';
import CircleCanvas from '../components/CircleCanvas.astro';
import MiniPlayer from '../components/MiniPlayer.astro';
import LikeSidebar from '../components/LikeSidebar.astro';
import KeyboardController from '../components/KeyboardController.astro';
import MediaSessionController from '../components/MediaSessionController.astro';

const SITE = 'https://infinite-circles.de';
const SITE_DESCRIPTION =
  'Persönliche Seite von Dejan. Musikjournal, Radio, Texte und Links, die es wert sind.';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** "website" for normal pages, "article"/"music.song" for single entries. */
  ogType?: string;
  /** Page-specific schema.org node, merged into the @graph below. */
  schema?: Record<string, unknown>;
  /** Keep a page out of search results (404, thin pages). */
  noindex?: boolean;
}

const {
  title = "Infinite Circles",
  description = SITE_DESCRIPTION,
  ogImage = `${SITE}/icon-512.png`,
  ogType = "website",
  schema,
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, SITE).href;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}

// Die Ringe liefen auf Lesestrecken gedämpft (0.28 statt 0.7). Das machte den
// Hintergrund von Seite zu Seite unterschiedlich; jetzt tragen alle Seiten die
// Fassung der Startseite.

// Site-wide structured data. Page-specific nodes get appended.
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    url: `${SITE}/`,
    name: 'Infinite Circles',
    // Site-level, not page-level — otherwise a song note would describe the whole site.
    description: SITE_DESCRIPTION,
    inLanguage: 'de-DE',
    publisher: { '@id': `${SITE}/#person` },
  },
  {
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: 'Dejan',
    url: `${SITE}/about`,
    address: { '@type': 'PostalAddress', addressLocality: 'Hannover', addressCountry: 'DE' },
  },
];
if (schema) graph.push(schema);

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="Infinite Circles" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Ein fester Wert färbte die Browserleiste auch im hellen Modus dunkelblau. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#82c1f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060c1a" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/* Client-side routing. The body is swapped instead of reloaded, so the
         detached audio element in utils/player.ts keeps playing. */}
    <ClientRouter />
    {/* Fonts: preconnect + load */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=DM+Mono:wght@300;400&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />
    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title="Song of the Day — Infinite Circles" href="/sotd/rss.xml" />
    <title>{title}</title>
    {/* Favicons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    {/* PWA */}
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Infinite Circles" />
    {/* Vor dem ersten Anstrich — und nach jedem Seitentausch erneut.
        Der ClientRouter übernimmt die Attribute des <html> aus dem
        eingehenden Dokument, und dort steht die Klasse nicht drin: sie wird
        ja erst hier zur Laufzeit gesetzt. Nach einem Klick in der Navigation
        stand deshalb gar keine Klasse mehr auf <html> und die Seite fiel auf
        hell zurück.
        is:inline hält es als klassisches Skript, das sofort läuft. Ohne das
        bündelt Astro es als Modul, und Module sind aufgeschoben — die helle
        Fassung blitzte beim Laden kurz auf. */}
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('ic_dark');
            var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var dark = stored === '1' || (stored === null && sysDark);
            var el = document.documentElement;
            el.classList.toggle('dark', dark);
            el.classList.toggle('light', !dark);
          } catch (e) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    {/* Namensgebender Hintergrund — liegt hinter allen Seiten */}
    <CircleCanvas />

    <nav class="site-nav">
      <a class="logo" href="/">Infinite Circles</a>
      <ul class="nav-links">
        <li><a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
        <li><a href="/radio" aria-current={isActive('/radio') ? 'page' : undefined}>Radio</a></li>
        <li><a href="/sotd" aria-current={isActive('/sotd') ? 'page' : undefined}>Song of the Day</a></li>
        <li><a href="/now" aria-current={isActive('/now') ? 'page' : undefined}>Now</a></li>
        <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
      </ul>
      <button class="dm-btn" id="dm-btn" title="Toggle dark mode">◐</button>
    </nav>

    <slot />

    {/* Site-wide playback UI. Lives here rather than on the radio page so the
         stream stays operable wherever the visitor navigates. */}
    <MiniPlayer />
    <LikeSidebar />
    <KeyboardController />
    <MediaSessionController />

    <script>
      // Static build freezes relative dates at deploy time — recompute them for
      // the actual visitor. Opt in with data-rel-date="YYYY-MM-DD".
      import { relativeDayLabel } from '../utils/date';
      import { onPage } from '../utils/lifecycle';

      onPage(() => {
        for (const el of document.querySelectorAll<HTMLElement>('[data-rel-date]')) {
          const iso = el.dataset.relDate;
          if (iso) el.textContent = relativeDayLabel(iso);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  :root {
    /* Ohne das bleiben Scrollbalken, Formularelemente und die Auswahlfarbe
       auch im Dunkelmodus hell. */
    color-scheme: light;
    /* War #4a90d9. Der Verlauf steht per position:fixed im Fenster, oben am
       Bildschirmrand lag also bei jedem Scrollstand der dunkelste Blauton —
       und darauf erreichte selbst volle Tinte nur 5,23:1. Für kleine Schrift
       blieb kein Spielraum. #82c1f2 ist der Wert aus dem Claude-Design-Entwurf
       der Radioseite, nachgemessen aus dem Screenshot. */
    --sky-top: #82c1f2;
    --sky-mid: #87ceeb;
    --sky-bot: #d4eef9;
    --glass-bg: rgba(255,255,255,0.22);
    --glass-bg-strong: rgba(255,255,255,0.38);
    --glass-border: rgba(255,255,255,0.65);
    --glass-border-dim: rgba(255,255,255,0.35);
    --text-deep: #0a1a2e;
    --text-mid: rgba(10,26,46,0.78);
    /* War 0.42, dann 0.58 — beides zu wenig. Nachgemessen über allen drei
       Himmelsstufen und beiden Flächen: 0.70 ist der niedrigste Wert, der
       überall 4,5:1 hält (schlechtester Fall 4,61:1). --text-dim trägt Datum,
       Genre und Interpret, nicht bloß Zierrat. */
    --text-dim: rgba(10,26,46,0.70);
    /* --accent ist die Grafikfarbe: Ränder, Punkte, Wellenform, Fokusring.
       3:1 reichen dort, #1a6bb5 kam auf 2,85:1. --accent-ink ist dieselbe
       Farbe für Text, dunkel genug für 4,5:1 auf jedem Grund (min 4,67:1). */
    --accent: #1866ac;
    --accent-ink: #114a82;
    --accent2: #4a90d9;
    /* Nebenakzente. Sie standen als feste Werte in den Komponenten und waren
       am Dunkelmodus ausgerichtet: Neongrün kam auf hellem Blau auf 1,02:1,
       Neonpink auf 1,23:1, das Fehlerrot auf 2,10:1. */
    --accent-archive: #05512f;
    --accent-like: #7d0f78;
    --danger: #8c1d16;
    /* Überschriftenblau. Kommt von der Now-Seite — dort ist es der Grundton
       der atmenden Animation. Als eigenes Token, damit eine Änderung eine
       Zeile ist und nicht neun Dateien. --heading-lift ist der helle Scheitel
       des Atmens. */
    --heading: var(--accent-ink);
    /* Der Scheitel des Atmens — zurück auf die ursprüngliche Spanne, hell nach
       hell statt der Reise ins Violett. Weiter aufhellen geht nicht: #87ceeb
       aus der allerersten Fassung kam auf dem Himmel auf 1,00:1. */
    --heading-lift: var(--accent);
    --border-light: rgba(255,255,255,0.5);
    --border-mid: rgba(10,26,46,0.12);
    --t: all 0.2s ease;
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-mono: 'DM Mono', 'Courier New', monospace;

    /* Glas-System — theme-unabhängig */
    --glass-blur: 32px;
    /* War 190%. Auf dem alten, kräftigen #4a90d9 fiel das kaum auf; auf dem
       helleren Himmel kippt jede Glasfläche und die Navigationsleiste sichtbar
       ins Türkise, während sie im Entwurf ein neutraler Weißschleier sind.
       Im Dunkelmodus ändert der Wert ohnehin fast nichts. */
    --glass-sat: 100%;
    --r-panel: 20px;
    --r-card: 14px;
    --r-ctrl: 11px;
    --ease-ios: cubic-bezier(0.32, 0.72, 0, 1);

    /* Glas-System — hell */
    --glass-panel: rgba(255,255,255,0.42);
    --glass-sheen: rgba(255,255,255,0.55);
    --glass-hairline: rgba(255,255,255,0.75);
    --glass-inner-lo: rgba(10,26,46,0.07);
    --glass-sep: rgba(10,26,46,0.08);
    --glass-ctrl: rgba(255,255,255,0.45);
    --glass-ctrl-hover: rgba(255,255,255,0.72);
    --glass-shadow:
      0 1px 1px rgba(10,26,46,0.05),
      0 8px 24px rgba(10,26,46,0.09),
      0 24px 64px rgba(10,26,46,0.10);

    /* Mood colors */
    --mood-ambient:    rgba(100, 160, 220, 0.18);
    --mood-deep-house: rgba(180, 120, 60,  0.14);
    --mood-house:      rgba(80,  180, 140, 0.13);
    --mood-techno:     rgba(160, 80,  200, 0.13);
    --mood-default:    rgba(100, 100, 120, 0.10);
  }

  html.dark {
    color-scheme: dark;
    --sky-top: #060c1a;
    --sky-mid: #0d1b35;
    --sky-bot: #0a1228;
    --glass-bg: rgba(10,20,50,0.28);
    --glass-bg-strong: rgba(10,20,50,0.45);
    --glass-border: rgba(255,255,255,0.18);
    --glass-border-dim: rgba(255,255,255,0.10);
    --text-deep: #e8f2ff;
    --text-mid: rgba(200,220,255,0.65);
    /* War 0.55 und lag damit bei 4,21:1. */
    --text-dim: rgba(180,210,255,0.62);
    /* Im Dunkeln trägt der helle Akzent den Text ohne Weiteres (min 7,99:1),
       Grafik- und Textfarbe fallen deshalb zusammen. */
    --accent: #7ab8f0;
    --accent-ink: #7ab8f0;
    --accent2: #4a90d9;
    /* Auf dunklem Grund tragen die Neontöne (12,6:1 und 7,1:1); nur das
       Fehlerrot war mit 4,17:1 knapp und wird aufgehellt. */
    --accent-archive: #00ff87;
    --accent-like: #ff6ef7;
    --danger: #ff8a80;
    /* Im Dunkeln fallen --accent und --accent-ink zusammen, der Scheitel
       braucht deshalb einen eigenen Wert. */
    --heading-lift: #b8dff8;
    --border-light: rgba(255,255,255,0.12);
    --border-mid: rgba(255,255,255,0.1);

    /* Glas-System — dunkel */
    --glass-panel: rgba(16,30,62,0.44);
    --glass-sheen: rgba(255,255,255,0.10);
    --glass-hairline: rgba(255,255,255,0.16);
    --glass-inner-lo: rgba(0,0,0,0.22);
    --glass-sep: rgba(255,255,255,0.07);
    --glass-ctrl: rgba(255,255,255,0.07);
    --glass-ctrl-hover: rgba(255,255,255,0.14);
    --glass-shadow:
      0 1px 1px rgba(0,0,0,0.30),
      0 8px 24px rgba(0,0,0,0.34),
      0 24px 64px rgba(0,0,0,0.40);
  }

  /* Hier stand derselbe Tokensatz ein zweites Mal, unter
     @media (prefers-color-scheme: dark) { html:not(.light) }. Er konnte nie
     greifen: das Skript im <head> läuft vor dem ersten Anstrich und setzt
     immer entweder .light oder .dark auf <html>. Übrig blieb der Fall ohne
     JavaScript — auf einer Seite, deren Zweck drei Abspieler sind. Der Block
     ist raus, jedes Token steht jetzt genau einmal hell und einmal dunkel.
     Preis: ohne JavaScript sieht man die helle Fassung. */

  /* ── Glas-Oberfläche — gemeinsame Basis für Player-Module ────────────────── */
  .glass-surface {
    position: relative;
    isolation: isolate;
    border-radius: var(--r-panel);
    background: var(--glass-panel);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
    box-shadow:
      var(--glass-shadow),
      inset 0 0.5px 0 var(--glass-hairline),
      inset 0 -0.5px 0 var(--glass-inner-lo),
      inset 0 0 0 0.5px var(--glass-border-dim);
  }
  /* specular sheen — Licht fällt von oben ein */
  .glass-surface::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--glass-sheen) 0%, transparent 42%),
      radial-gradient(120% 60% at 50% -20%, var(--glass-sheen) 0%, transparent 70%);
    opacity: 0.7;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-surface { background: var(--glass-bg-strong); }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  body {
    font-family: var(--font-mono);
    color: var(--text-deep);
    line-height: 1.6;
    overflow-x: hidden;
    min-height: 100vh;
    background: var(--sky-top);
    position: relative;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
    z-index: -2;
    pointer-events: none;
  }

  /* NAV */
  /* Der Wähler war blank `nav` und traf damit auch die Wegeleiste der
     Startseite (<nav class="ways">): die bekam Glasfläche, Unterkante,
     backdrop-filter und position:sticky mitgeliefert und stand als blasser
     Kasten hinter den drei Karten. Jetzt trägt nur die Kopfleiste die Klasse. */
  nav.site-nav {
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 4rem;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(28px) saturate(var(--glass-sat));
    -webkit-backdrop-filter: blur(28px) saturate(var(--glass-sat));
    border-bottom: 0.5px solid var(--glass-border);
  }
  .logo {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 300;
    letter-spacing: .12em;
    color: var(--text-deep);
    text-decoration: none;
    transition: var(--t);
  }
  .logo:hover { color: var(--accent-ink); }
  .nav-links { display: flex; gap: 2.2rem; list-style: none; }
  .nav-links a {
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-mid);
    transition: var(--t);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 0.5px solid transparent;
  }
  .nav-links a:hover { color: var(--text-deep); }
  .nav-links a[aria-current="page"] { color: var(--text-deep); border-bottom-color: var(--accent); }
  .dm-btn {
    background: var(--glass-bg);
    border: 0.5px solid var(--glass-border-dim);
    border-radius: 20px;
    padding: 5px 12px;
    color: var(--text-mid);
    font-size: 13px;
    cursor: pointer;
    transition: var(--t);
    font-family: var(--font-mono);
  }
  .dm-btn:hover { color: var(--text-deep); border-color: var(--glass-border); }

  @media (max-width: 768px) {
    nav.site-nav { padding: 0.9rem 1.5rem; }
    /* Sechs Punkte passen auf einem Telefon nicht in eine Zeile — umbrechen
       statt überlaufen lassen. */
    .nav-links { gap: 0.5rem 1.1rem; flex-wrap: wrap; justify-content: flex-end; }
    .nav-links a { font-size: 10px; }
  }

  /* Atmende Überschrift. Liegt global, weil Now und Startseite sie sich
     teilen — in einem seitenlokalen <style> würde Astro den Namen umbenennen
     und die jeweils andere Seite fände sie nicht. Der reduced-motion-Block
     weiter unten friert sie ein; deshalb tragen beide Überschriften zusätzlich
     ein eigenes color, auf das sie dann zurückfallen. */
  @keyframes ic-heading-breathe {
    0%, 100% { color: var(--heading); }
    50%      { color: var(--heading-lift); }
  }

  /* Jede Seitenüberschrift atmet, nicht mehr nur Now und Startseite. Steht
     hier einmal statt in neun Seitenblättern; die Seiten regeln nur noch
     Schriftgrad und Abstände. Takt wie in der ursprünglichen Now-Fassung. */
  h1 {
    color: var(--heading);
    animation: ic-heading-breathe 3.8s ease-in-out infinite;
  }

  /* Shared reveal animation — used across multiple pages */
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* Ein Fokusring für alles, was Fokus bekommen kann. :where() hat Spezifität
     null, also behalten Komponenten mit eigenem Ring — .ar-genre-btn, .way —
     ihren. Vorher war der Ring auf den Radio-Bedienelementen gar nicht da:
     wer per Tastatur navigierte, sah auf /radio nicht, wo er steht. */
  :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

<script>
  import { onPage } from '../utils/lifecycle';

  // Dark mode toggle. The button lives in the swapped body, so the listener has
  // to be attached again after every navigation. The class itself sits on
  // <html>, which survives the swap — no flash, no re-reading localStorage.
  onPage(() => {
    const btn = document.getElementById('dm-btn');
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      document.documentElement.classList.toggle('light', !isDark);
      try { localStorage.setItem('ic_dark', isDark ? '1' : '0'); } catch(e) {}
    });
  });
</script>
