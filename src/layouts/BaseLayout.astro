---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Infinite Circles",
  description = "Personal site of Dejan. Music journal, writing, experiments and links worth keeping."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://infinite-circles.de" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="65f41a88-359f-4090-ac4e-82be88099cbd"></script>
    <script>
      try {
        const stored = localStorage.getItem('ic_dark');
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === '1' || (stored === null && sysDark)) document.documentElement.classList.add('dark');
      } catch(e) {}
    </script>
  </head>
  <body>
    <nav>
      <a class="logo" href="/">Infinite Circles</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/sotd">Song of the Day</a></li>
        <li><a href="/music">Music</a></li>
        <li><a href="/now">Now</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <button class="dm-btn" id="dm-btn" title="Toggle dark mode">◐</button>
    </nav>

    <slot />

  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  :root {
    --sky-top: #4a90d9;
    --sky-mid: #87ceeb;
    --sky-bot: #d4eef9;
    --glass-bg: rgba(255,255,255,0.22);
    --glass-bg-strong: rgba(255,255,255,0.38);
    --glass-border: rgba(255,255,255,0.65);
    --glass-border-dim: rgba(255,255,255,0.35);
    --text-deep: #0a1a2e;
    --text-mid: rgba(10,26,46,0.65);
    --text-dim: rgba(10,26,46,0.42);
    --accent: #1a6bb5;
    --accent2: #4a90d9;
    --border-light: rgba(255,255,255,0.5);
    --border-mid: rgba(10,26,46,0.12);
    --t: all 0.2s ease;
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-mono: 'DM Mono', 'Courier New', monospace;
  }

  html.dark {
    --sky-top: #060c1a;
    --sky-mid: #0d1b35;
    --sky-bot: #0a1228;
    --glass-bg: rgba(10,20,50,0.28);
    --glass-bg-strong: rgba(10,20,50,0.45);
    --glass-border: rgba(255,255,255,0.18);
    --glass-border-dim: rgba(255,255,255,0.10);
    --text-deep: #e8f2ff;
    --text-mid: rgba(200,220,255,0.65);
    --text-dim: rgba(180,210,255,0.38);
    --accent: #7ab8f0;
    --accent2: #4a90d9;
    --border-light: rgba(255,255,255,0.12);
    --border-mid: rgba(255,255,255,0.1);
  }

  @media (prefers-color-scheme: dark) {
    html:not(.light) {
      --sky-top: #060c1a;
      --sky-mid: #0d1b35;
      --sky-bot: #0a1228;
      --glass-bg: rgba(10,20,50,0.28);
      --glass-bg-strong: rgba(10,20,50,0.45);
      --glass-border: rgba(255,255,255,0.18);
      --glass-border-dim: rgba(255,255,255,0.10);
      --text-deep: #e8f2ff;
      --text-mid: rgba(200,220,255,0.65);
      --text-dim: rgba(180,210,255,0.38);
      --accent: #7ab8f0;
      --accent2: #4a90d9;
      --border-light: rgba(255,255,255,0.12);
      --border-mid: rgba(255,255,255,0.1);
    }
  }

body {
  font-family: var(--font-mono);
  color: var(--text-deep);
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
  background: var(--sky-top);
  position: relative;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
  z-index: -2;
  pointer-events: none;
}
  /* NAV */
  nav {
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 4rem;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border-bottom: 0.5px solid var(--glass-border);
  }
  .logo {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 300;
    letter-spacing: .12em;
    color: var(--text-deep);
    text-decoration: none;
    transition: var(--t);
  }
  .logo:hover { color: var(--accent); }
  .nav-links { display: flex; gap: 2.2rem; list-style: none; }
  .nav-links a {
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-mid);
    transition: var(--t);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 0.5px solid transparent;
  }
  .nav-links a:hover { color: var(--text-deep); }
  .nav-links a[aria-current="page"] { color: var(--text-deep); border-bottom-color: var(--accent); }
  .dm-btn {
    background: var(--glass-bg);
    border: 0.5px solid var(--glass-border-dim);
    border-radius: 20px;
    padding: 5px 12px;
    color: var(--text-mid);
    font-size: 13px;
    cursor: pointer;
    transition: var(--t);
    font-family: var(--font-mono);
  }
  .dm-btn:hover { color: var(--text-deep); border-color: var(--glass-border); }

  @media (max-width: 768px) {
    nav { padding: 0.9rem 1.5rem; }
    .nav-links { gap: 1.2rem; }
    .nav-links a { font-size: 9px; }
  }
</style>

<script>
  // Dark mode toggle
  const btn = document.getElementById('dm-btn');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    document.documentElement.classList.toggle('light', !isDark);
    try { localStorage.setItem('ic_dark', isDark ? '1' : '0'); } catch(e) {}
  });

  // Active nav link
  const path = window.location.pathname;
  document.querySelectorAll('.nav-links a').forEach(a => {
    const href = a.getAttribute('href');
    if (href === path || (href !== '/' && path.startsWith(href!))) {
      a.setAttribute('aria-current', 'page');
    }
  });
</script>