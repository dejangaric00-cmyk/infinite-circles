---
// src/components/UndergroundStations.astro
//
// Karteikarten-Redesign. Daten, Player-Anbindung und Zustandslogik sind
// unverändert aus der Vorversion übernommen — neu sind Markup-Struktur,
// CSS und eine Filterleiste (Genre + Stadt) über dem Raster.
//
// Beibehaltene Haken für utils/player.ts: .station-card[data-url|data-name|
// data-state], .play-btn, .btn-icon, .btn-label, .error-msg, .waveform,
// #ugNowBar, #ugNowName, #ugStopAll.

// Herkunft steht als Ländercode vor der Stadt, nicht als Flaggen-Emoji: die
// Emoji rendern je nach System unterschiedlich breit und brechen die Laufweite
// der Monoschrift. Sender ohne Ort lassen country leer.
interface PlayableStation {
  type: 'playable';
  id: string;
  name: string;
  country: string;
  city: string;
  /** Nur für die Filterleiste, wenn der Ortsname feiner ist als der Filter —
      Deptford liegt in London, die Karte nennt aber den Stadtteil. */
  area?: string;
  genre: string[];
  url: string;
  site: string;
  color: string;
}

interface LinkStation {
  type: 'link';
  id: string;
  name: string;
  country: string;
  city: string;
  genre: string[];
  site: string;
  color: string;
  desc: string;
}

/** „DE · Berlin" — oder nur eines von beidem, wenn das andere fehlt. */
