  },
  // ─── TIER 2 — Airtime Pro (meistens stabil) ───────────────────────────────
  {
    id: 'rinse',
    name: 'Rinse FM',
    city: 'London',
    flag: '🇬🇧',
    genre: ['House', 'Grime', 'Garage'],
    url: 'https://rinse.out.airtime.pro/rinse_a',
    site: 'https://rinse.fm',
    color: '#ff0055',
