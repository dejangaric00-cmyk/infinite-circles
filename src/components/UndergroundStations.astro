const linkOnly: LinkStation[] = [
  ...brokenStreams,
  {
    type: 'link',
    id: 'dublab',
    name: 'dublab',
    city: 'Los Angeles',
    country: 'US',
    genre: ['Experimental', 'Future Music'],
    // Bleibt Link-Karte: dokumentierter Endpunkt ist reines http, die CSP in
    // netlify.toml erlaubt media-src nur über https.
    site: 'https://dublab.com',
    color: '#00897b',
    desc: 'Non-profit radio aus LA seit 1999.',
  },
];

// Filterleiste: erst Genres, dann Städte. Aus den Daten abgeleitet, damit sie
// nicht auseinanderlaufen, wenn oben ein Sender dazukommt.
const genreFilters = ['Techno', 'House', 'Ambient', 'Experimental', 'Eclectic', 'Jazz'];
const cityFilters = ['London', 'Berlin', 'Internet'];
const filters = ['Alle', ...genreFilters, ...cityFilters];
---

<section class="underground-section">

  <header class="ug-head">
    <p class="ug-kicker">
      III · Stationen · {playable.length} · zeigt <span id="ugCount">alle</span>
    </p>
    <div class="ug-row">
      <h2 class="ug-h2">Verzeichnis</h2>
      <div class="ug-filters" role="group" aria-label="Sender filtern">
        {filters.map((f, i) => (
          <button type="button" class="ug-chip" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f}
          </button>
        ))}
      </div>
    </div>
  </header>

  <div class="stations-grid" role="list">
    {playable.map((s) => (
      <article
        class="station-card"
        data-station-id={s.id}
        data-url={s.url}
        data-site={s.site}
        data-name={s.name}
        data-city={s.area ?? s.city}
        data-genres={s.genre.join(' ').toLowerCase()}
        data-state="idle"
        style={`--sc: ${s.color}`}
        role="listitem"
      >
        <div class="card-top">
          <span class="location-badge">{place(s)}</span>
          <span class="state-badge">
            <span class="live-badge">
              <span class="live-dot-anim"></span>
              <span>on air</span>
            </span>
            <span class="idle-badge">live</span>
          </span>
        </div>

        <h3 class="station-name">{s.name}</h3>

        <div class="card-rule"></div>

        <div class="genre-line">{s.genre.join(' · ')}</div>

        <p class="error-msg">
          Stream nicht erreichbar —{' '}
          <a href={s.site} target="_blank" rel="noopener noreferrer">Website öffnen ↗</a>
        </p>

        <div class="card-footer">
          <button class="play-btn" type="button">
            <span class="btn-icon">▶</span>
            <span class="btn-label">Listen</span>
          </button>
          <div class="footer-right">
            <div class="waveform" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <a class="site-link" href={s.site} target="_blank" rel="noopener noreferrer">Site ↗</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  {/* Bleibt stehen, auch wenn nichts läuft: der Balken ist die Fußkante des
       Rasters. Leer trägt er den Hinweis, der Stopp-Knopf erscheint erst mit
       einem laufenden Stream. */}
  <div class="now-playing-bar" id="ugNowBar" data-idle="true">
    <div class="npb-left">
      <span class="npb-label">Now tuned</span>
      <span class="npb-dash">—</span>
      <strong class="npb-name" id="ugNowName"></strong>
      <span class="npb-empty">kein Stream aktiv</span>
    </div>
    <button class="npb-stop" id="ugStopAll" type="button">■ Stop</button>
  </div>

  <header class="links-head">
    <p class="ug-kicker">IV · Verweise</p>
    <div class="ug-row">
      <h2 class="ug-h3">Labels &amp; Ressourcen</h2>
      <span class="ug-kicker">kein eigener Stream</span>
    </div>
  </header>

  <div class="link-list" role="list">
    {linkOnly.map((s) => (
      <a
        class="link-row"
        href={s.site}
        target="_blank"
        rel="noopener noreferrer"
        style={`--sc: ${s.color}`}
        role="listitem"
      >
        <span class="lr-name">{s.name}</span>
        <span class="lr-desc">{s.desc}</span>
        <span class="lr-meta">
          {place(s)} · {s.genre.join(' · ')} <span class="lr-arrow">↗</span>
        </span>
      </a>
    ))}
  </div>

  {/* Die Kürzel sitzen global im KeyboardController — hier stehen sie, damit
       sie überhaupt jemand findet, ohne erst „?" zu drücken. */}
  <div class="foot-grid">
    <div class="foot-col">
      <p class="ug-kicker">Tastatur</p>
      <dl class="kb-list">
        <dt><kbd>Space</kbd></dt><dd>Play / Pause</dd>
        <dt><kbd>→</kbd></dt><dd>Skip (Archive.org)</dd>
        <dt><kbd>+</kbd> <kbd>−</kbd></dt><dd>Lautstärke ± 10 %</dd>
        <dt><kbd>1</kbd> – <kbd>4</kbd></dt><dd>SomaFM-Station wechseln</dd>
        <dt><kbd>?</kbd></dt><dd>Übersicht öffnen / schließen</dd>
      </dl>
    </div>
    <div class="foot-col">
      <p class="ug-kicker">Hinweis</p>
      <p class="streams-note">
        Stream-URLs ändern sich. Bei dauerhaften Fehlern die Station-Website öffnen,
        dort DevTools → Network → Media, und die aktuelle URL kopieren. Sender ohne
        offenen Stream stehen unter <em>Labels &amp; Ressourcen</em> — dort führt die
        Karte bewusst nur nach außen statt einen toten Play-Knopf zu zeigen.
      </p>
    </div>
  </div>
</section>

<style>
  .underground-section {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  /* ── Kopf mit Filterleiste ──
     Gleiches Muster wie .sec-head auf der Radioseite: Ziffer und Kennung als
     Zeile darüber, Titel und Randnotiz an einer Haarlinie. */
  .ug-head { display: flex; flex-direction: column; gap: 0.4rem; }
  .ug-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 0.5px solid var(--border-mid);
    padding-bottom: 0.7rem;
  }
  .ug-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-feature-settings: 'tnum';
  }
  .ug-h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    margin: 0;
    color: var(--text-deep);
  }
  .ug-h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    margin: 0;
    color: var(--text-deep);
  }

  .ug-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; }
  .ug-chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-chip, var(--border-mid));
    border-radius: var(--r-ctrl);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: var(--t);
  }
  .ug-chip:hover { color: var(--text-deep); border-color: var(--accent); }
  .ug-chip[aria-pressed='true'] {
    color: var(--text-deep);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* ── Karteikarten ── */
  .stations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.9rem;
  }

  .station-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.1rem 0.9rem;
    background: var(--glass-bg);
    border: 1px solid var(--border-light);
    border-radius: var(--r-card);
    backdrop-filter: blur(10px);
    transition: border-color 0.2s, background 0.2s;
  }
  .station-card:hover { background: var(--glass-bg-strong); border-color: var(--accent); }
  .station-card[data-state='playing'],
  .station-card[data-state='paused'] {
    background: var(--glass-bg-strong);
    border-color: var(--accent);
  }
  .station-card[data-state='error'] { border-color: color-mix(in srgb, var(--danger) 45%, transparent); }
  .station-card[hidden] { display: none; }

  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .location-badge { white-space: nowrap; }

  .live-badge { display: none; align-items: center; gap: 0.3rem; color: var(--accent-ink); }
  [data-state='playing'] .live-badge { display: flex; }
  [data-state='playing'] .idle-badge { display: none; }
  [data-state='loading'] .idle-badge::after { content: '…'; }
  .live-dot-anim {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }

  .station-name {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.05;
    margin: 0;
    color: var(--text-deep);
  }

  .card-rule { height: 0.5px; background: var(--border-mid); }

  .genre-line {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .error-msg {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--danger);
    margin: 0;
    line-height: 1.5;
  }
  .error-msg a { color: var(--danger); text-decoration: underline; }
  [data-state='error'] .error-msg { display: block; }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: auto;
    padding-top: 0.3rem;
  }
  .footer-right { display: flex; align-items: center; gap: 0.7rem; }

  .play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-ctrl, var(--border-mid));
    border-radius: var(--r-ctrl);
    background: transparent;
    color: var(--text-deep);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    cursor: pointer;
    transition: var(--t);
    white-space: nowrap;
  }
  .play-btn:hover { border-color: var(--accent); background: var(--glass-bg-strong); }
  [data-state='loading'] .play-btn { border-color: var(--accent); cursor: wait; }
  [data-state='playing'] .play-btn { border-color: var(--accent); background: var(--glass-bg-strong); }
  [data-state='error'] .play-btn { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, transparent); }
  .btn-icon { font-size: 0.58rem; }

  /* Vier Striche als Puls der laufenden Karte. Im Ruhezustand unsichtbar —
     sichtbar standen sie als vier Punkte vor „Site ↗" und sahen aus wie ein
     Darstellungsfehler. Platz bleibt reserviert, damit nichts springt. */
  .waveform {
    display: flex; align-items: flex-end; gap: 2px; height: 14px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  [data-state='loading'] .waveform,
  [data-state='playing'] .waveform { opacity: 1; }
  .waveform span {
    flex: 0 0 2px;
    height: 100%;
    background: var(--accent);
    transform: scaleY(0.25);
    transform-origin: bottom;
  }
  [data-state='loading'] .waveform span,
  [data-state='playing'] .waveform span {
    animation: wave-play 0.9s ease-in-out infinite alternate;
  }
  [data-state='playing'] .waveform span:nth-child(1) { animation-delay: 0s; animation-duration: 0.8s; }
  [data-state='playing'] .waveform span:nth-child(2) { animation-delay: 0.12s; animation-duration: 0.95s; }
  [data-state='playing'] .waveform span:nth-child(3) { animation-delay: 0.24s; animation-duration: 0.7s; }
  [data-state='playing'] .waveform span:nth-child(4) { animation-delay: 0.36s; animation-duration: 1s; }
  @keyframes wave-play { from { transform: scaleY(0.25); } to { transform: scaleY(1); } }

  .site-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
