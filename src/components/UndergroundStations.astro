  }
  /* Leerzustand: Hinweis statt Name, kein Stopp-Knopf für nichts. */
  .now-playing-bar:not([data-idle]) .npb-empty { display: none; }
  .now-playing-bar[data-idle] .npb-name,
  .now-playing-bar[data-idle] .npb-stop { display: none; }
  .npb-stop {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
