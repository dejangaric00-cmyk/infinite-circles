</style>

<script>
  import { load, pause, subscribe, registerSourceHandlers, getState } from '../utils/player';
  import { onPage, disposer } from '../utils/lifecycle';

  onPage(() => {
    const nowBar  = document.getElementById('ugNowBar')  as HTMLElement;
    const nowName = document.getElementById('ugNowName') as HTMLElement;
    const stopBtn = document.getElementById('ugStopAll') as HTMLButtonElement;
    const countEl = document.getElementById('ugCount')   as HTMLElement;

    if (!nowBar) return; // component not on this page

    const off = disposer();

    function setCardState(card: HTMLElement, state: 'idle'|'loading'|'playing'|'paused'|'error') {
      card.dataset.state = state;
      const icon  = card.querySelector<HTMLElement>('.btn-icon');
      const label = card.querySelector<HTMLElement>('.btn-label');
      if (!icon || !label) return;
      switch (state) {
        case 'idle':    icon.textContent = '▶'; label.textContent = 'Listen'; break;
        case 'loading': icon.textContent = '…'; label.textContent = 'Lädt'; break;
        case 'playing': icon.textContent = '❚❚'; label.textContent = 'Pause'; break;
        // Bewusst "Listen", nicht "Weiter": ein Klick baut den Live-Stream neu
        // auf, statt aus einem veralteten Puffer weiterzulaufen.
        case 'paused':  icon.textContent = '▶'; label.textContent = 'Listen'; break;
        case 'error':   icon.textContent = '✕'; label.textContent = 'Error'; break;
      }
    }

    function cards(): HTMLElement[] {
      return Array.from(document.querySelectorAll<HTMLElement>('.station-card'));
    }

    // ── Filterleiste ───────────────────────────────────────────────────────
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.ug-chip'));

    function applyFilter(f: string) {
      const needle = f.toLowerCase();
      let shown = 0;
      for (const card of cards()) {
        const hit =
          f === 'Alle' ||
          card.dataset.city === f ||
          (card.dataset.genres ?? '').includes(needle);
        card.hidden = !hit;
        if (hit) shown++;
      }
      if (countEl) {
        countEl.textContent = shown === cards().length ? 'alle' : `${shown} von ${cards().length}`;
      }
      for (const chip of chips) {
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === f));
      }
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => applyFilter(chip.dataset.filter ?? 'Alle'));
    }

    // ── Wiedergabe ─────────────────────────────────────────────────────────
    function stopAll() {
      pause();
    }

    function playStation(card: HTMLElement) {
      const url  = card.dataset.url  ?? '';
      const name = card.dataset.name ?? '';
      const s = getState();

      // Second click on the running card stops it.
      if (s.source === 'underground' && s.stationSlug === url && s.playing) {
        pause();
        return;
      }

      setCardState(card, 'loading');
      void load({
        source: 'underground',
        src: url,
        stationSlug: url,
        stationName: name,
        track: { title: name, artist: 'underground radio' },
      });
    }

    off.add(subscribe((s) => {
      const mine = s.source === 'underground';

      for (const card of cards()) {
        if (card.dataset.state === 'error') continue;
        if (mine && card.dataset.url === s.stationSlug) {
          setCardState(card, s.playing ? 'playing' : s.loading ? 'loading' : 'paused');
        } else {
          setCardState(card, 'idle');
        }
      }

      // data-idle statt hidden: .now-playing-bar setzt display:flex und würde
      // das hidden-Attribut aus dem Browser-Stylesheet überstimmen.
      if (nowBar && nowName) {
        if (mine && s.playing) {
          nowName.textContent = s.stationName;
          nowBar.removeAttribute('data-idle');
        } else {
          nowName.textContent = '';
          nowBar.setAttribute('data-idle', 'true');
        }
      }
    }));

    // Deliberately outside the disposer: playback continues after leaving this
    // page, so the error handler has to survive too. Re-registering overwrites.
    registerSourceHandlers('underground', {
      onError: () => {
        const slug = getState().stationSlug;
        const card = cards().find(c => c.dataset.url === slug);
        if (card) setCardState(card, 'error');
        if (nowBar) nowBar.setAttribute('data-idle', 'true');
      },
    });

    for (const card of cards()) {
      card.querySelector<HTMLButtonElement>('.play-btn')?.addEventListener('click', () => {
        if (card.dataset.state === 'error') { setCardState(card, 'idle'); return; }
        playStation(card);
      });
    }

    stopBtn?.addEventListener('click', stopAll);

    return off.run;
  });
</script>
