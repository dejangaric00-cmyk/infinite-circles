    border: 1px solid var(--line-ctrl, var(--border-mid));
    border-radius: var(--r-ctrl);
    background: transparent;
    color: var(--text-deep);
    cursor: pointer;
    transition: var(--t);
    white-space: nowrap;
  }
  .npb-stop:hover { border-color: var(--accent); background: var(--glass-bg-strong); }

  /* ── Labels & Ressourcen ── */
  .links-head {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.2rem;
  }
