---
// src/components/UndergroundStations.astro
// Underground Radio Stations — kuratierte Streams für elektronische Musik
//
// STREAM-STATUS LEGENDE:
//  ✅ verified  = URL aus offizieller Quelle bestätigt, funktioniert im Browser
//  ⚡ airtime   = Airtime-Pro-Muster, funktioniert meist — bei Fehler: Website öffnen
//  ⚠  http-only = Nur HTTP (blockiert auf HTTPS-Seiten in Produktion; lokal ok)
//
// STREAMS AKTUALISIEREN: Öffne die Station-Website, öffne DevTools → Network → Media,
// drücke Play → kopiere die .mp3 / .aac URL.

interface Station {
  id: string;
  name: string;
  city: string;
  flag: string;
  genre: string[];
  url: string;
  site: string;
  color: string;     // Accent-Farbe der Karte (für Glow & Waveform)
  status: 'verified' | 'airtime' | 'http-only';
}

const stations: Station[] = [
