// Stationen ohne nutzbaren Direktstream. Als Zeile in einer Haarlinien-Liste
// statt als Karte — so entsteht gar nicht erst ein Play-Knopf, der scheitert.
const brokenStreams: LinkStation[] = [
  {
    type: 'link',
    id: 'fnoob',
    name: 'Fnoob Techno',
    city: '',
    country: 'UK',
    genre: ['Techno', 'Dark'],
    site: 'https://fnoob.com',
    color: '#7b2fff',
    // Stream-ID auf radiomast.io liefert 404 — Kennung wurde neu vergeben.
    desc: 'Direktstream zurzeit nicht erreichbar.',
  },
  {
    type: 'link',
    id: 'thelot',
    name: 'The Lot Radio',
    city: 'New York',
    country: 'US',
    genre: ['House', 'Techno'],
    site: 'https://www.thelotradio.com',
    color: '#f5a623',
    // Erreichbar, aber als HLS-Playlist — `new Audio()` spielt .m3u8 nur in
    // Safari nativ ab. Erst hochstufen, wenn der Player HLS beherrscht.
    desc: 'Aus einem Schiffscontainer in Greenpoint. Läuft über HLS.',
  },
  {
    type: 'link',
    id: 'radiojuicy',
    name: 'Radio Juicy',
    city: 'Berlin',
    country: 'DE',
    genre: ['Lo-Fi', 'Beats'],
    site: 'https://www.radiojuicy.com',
    color: '#e91e8c',
    desc: 'Streamserver antwortet nicht mehr.',
  },
  {
    type: 'link',
    id: 'dubninja',
    name: 'Dub Ninja',
    city: 'London',
    country: 'UK',
    genre: ['Electronic', 'AI DJ'],
    site: 'https://dub.ninja',
    color: '#2e8b8b',
    desc: 'Kein offener Stream — Wiedergabe nur auf der Seite.',
  },
