---

<section class="underground-section">

  <!-- ── Playable Stations ──────────────────────────────────────────────── -->

  <div class="now-playing-bar" id="ugNowBar" hidden>
    <div class="npb-left">
      <span class="npb-dot"></span>
      <span class="npb-label">Now Tuned:</span>
      <strong class="npb-name" id="ugNowName">—</strong>
    </div>
    <button class="npb-stop" id="ugStopAll" type="button">■ Stop</button>
  </div>

  <div class="stations-grid" role="list">
    {playable.map((s) => (
      <article
        class="station-card"
        data-station-id={s.id}
        data-url={s.url}
        data-site={s.site}
        data-name={s.name}
        data-state="idle"
        style={`--sc: ${s.color}`}
        role="listitem"
      >
        <div class="card-top">
          <span class="location-badge">
            <span>{s.flag}</span>
            <span class="location-city">{s.city}</span>
          </span>
          <div class="live-badge">
            <span class="live-dot-anim"></span>
            <span>LIVE</span>
          </div>
        </div>

        <h3 class="station-name">{s.name}</h3>

        <div class="genre-pills">
          {s.genre.map((g) => <span class="genre-pill">{g}</span>)}
        </div>

        <div class="waveform" aria-hidden="true">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>

        <p class="error-msg">
          Stream nicht erreichbar —{' '}
          <a href={s.site} target="_blank" rel="noopener noreferrer">Website öffnen ↗</a>
        </p>

        <div class="card-footer">
          <button class="play-btn" type="button">
            <span class="btn-icon">▶</span>
            <span class="btn-label">Play</span>
          </button>
          <a class="site-link" href={s.site} target="_blank" rel="noopener noreferrer">↗</a>
        </div>
      </article>
    ))}
  </div>

  <!-- ── Link-only Stations ─────────────────────────────────────────────── -->
  <div class="section-label section-label--links">Labels &amp; Ressourcen</div>

  <div class="link-grid" role="list">
    {linkOnly.map((s) => (
      <a
        class="link-card"
        href={s.site}
        target="_blank"
        rel="noopener noreferrer"
        style={`--sc: ${s.color}`}
        role="listitem"
      >
        <div class="lc-top">
          <span class="lc-location">
            <span>{s.flag}</span>
            <span>{s.city}</span>
          </span>
          <span class="lc-arrow">↗</span>
        </div>

        <div class="lc-name">{s.name}</div>
        <div class="lc-desc">{s.desc}</div>

        <div class="lc-pills">
          {s.genre.map((g) => <span class="genre-pill">{g}</span>)}
        </div>
      </a>
    ))}
  </div>

  <p class="streams-note">
    Stream-URLs können sich ändern. Bei dauerhaften Fehlern: Station-Website öffnen →
    DevTools → Network → Media → aktuelle URL kopieren.
  </p>
</section>

<style>
  .underground-section {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    opacity: 0.6;
    text-align: center;
    margin-bottom: 0.9rem;
  }

  .section-label--links {
    margin-top: 2.5rem;
  }

  /* ── Now Playing Bar ── */
  .now-playing-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.6rem 1rem; margin-bottom: 1rem;
    background: var(--glass-bg-strong);
    border: 0.5px solid var(--border-mid);
    border-radius: 8px;
    backdrop-filter: blur(12px);
  }
  .npb-left {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);
  }
  .npb-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); animation: blink 1s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
  .npb-name { color: var(--text-deep); font-weight: 500; }
  .npb-stop {
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem; border: 0.5px solid var(--border-mid);
    border-radius: 20px; background: transparent; color: var(--text-dim);
    cursor: pointer; transition: all 0.2s;
  }
  .npb-stop:hover { background: rgba(255,100,100,0.12); border-color: rgba(255,100,100,0.5); color: #ff7777; }

  /* ── Playable Grid ── */
  .stations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 580px) { .stations-grid { grid-template-columns: 1fr; } }

  /* ── Playable Card ── */
  .station-card {
    position: relative;
    display: flex; flex-direction: column; gap: 0.45rem;
    padding: 1rem;
    background: var(--glass-bg);
    border: 0.5px solid var(--border-mid);
    border-radius: 8px;
    backdrop-filter: blur(10px);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    overflow: hidden;
  }
  .station-card::before {
    content: '';
    position: absolute; inset-block: 0; left: 0;
    width: 2px; background: var(--sc); opacity: 0.4;
    border-radius: 0 1px 1px 0; transition: opacity 0.2s;
  }
  .station-card:hover { background: var(--glass-bg-strong); }
  .station-card:hover::before { opacity: 1; }
  .station-card[data-state="playing"] {
    border-color: var(--sc);
    background: var(--glass-bg-strong);
    box-shadow: 0 0 20px -6px var(--sc);
  }
  .station-card[data-state="playing"]::before { opacity: 1; width: 3px; }
  .station-card[data-state="error"] { border-color: rgba(255,100,100,0.3); }

  .card-top {
    display: flex; align-items: center; justify-content: space-between;
  }
  .location-badge {
    display: flex; align-items: center; gap: 0.3rem;
    font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim);
  }
  .live-badge {
    display: none; align-items: center; gap: 0.3rem;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em;
    color: var(--sc); opacity: 0; transition: opacity 0.3s;
  }
  [data-state="playing"] .live-badge { display: flex; opacity: 1; }
  .live-dot-anim {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--sc); animation: blink 1s step-end infinite;
  }

  .station-name {
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500;
    color: var(--text-deep); margin: 0; line-height: 1.3;
  }

  .genre-pills { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .genre-pill {
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 0.12rem 0.4rem;
    border-radius: 20px; border: 0.5px solid var(--border-mid); color: var(--text-dim);
    transition: border-color 0.2s, color 0.2s;
  }
  [data-state="playing"] .genre-pill { border-color: var(--sc); color: var(--text-deep); }

  .waveform {
    display: flex; align-items: center; gap: 3px; height: 24px; margin: 0.2rem 0;
  }
  .waveform span {
    flex: 0 0 3px; height: 100%; background: var(--sc); border-radius: 2px;
    transform: scaleY(0.2); transform-origin: center;
    transition: transform 0.3s, opacity 0.3s; opacity: 0.3;
  }
  [data-state="loading"] .waveform span {
    opacity: 0.5; animation: wave-idle 1.6s ease-in-out infinite;
  }
  [data-state="loading"] .waveform span:nth-child(1){animation-delay:0s}
  [data-state="loading"] .waveform span:nth-child(2){animation-delay:.15s}
  [data-state="loading"] .waveform span:nth-child(3){animation-delay:.3s}
  [data-state="loading"] .waveform span:nth-child(4){animation-delay:.45s}
  [data-state="loading"] .waveform span:nth-child(5){animation-delay:.6s}
  [data-state="loading"] .waveform span:nth-child(6){animation-delay:.75s}
  @keyframes wave-idle { 0%,100%{transform:scaleY(0.2)} 50%{transform:scaleY(0.6)} }
  [data-state="playing"] .waveform span {
    opacity: 1; animation: wave-play 0.9s ease-in-out infinite alternate;
  }
  [data-state="playing"] .waveform span:nth-child(1){animation-delay:0s;animation-duration:.8s}
  [data-state="playing"] .waveform span:nth-child(2){animation-delay:.12s;animation-duration:.95s}
  [data-state="playing"] .waveform span:nth-child(3){animation-delay:.24s;animation-duration:.7s}
  [data-state="playing"] .waveform span:nth-child(4){animation-delay:.36s;animation-duration:1s}
  [data-state="playing"] .waveform span:nth-child(5){animation-delay:.18s;animation-duration:.85s}
  [data-state="playing"] .waveform span:nth-child(6){animation-delay:.06s;animation-duration:.75s}
  @keyframes wave-play { from{transform:scaleY(0.3)} to{transform:scaleY(1)} }

  .error-msg {
    display: none; font-family: var(--font-mono); font-size: 0.65rem;
    color: #ff7777; margin: 0; line-height: 1.5;
  }
  .error-msg a { color: #ff9999; text-decoration: underline; }
  [data-state="error"] .error-msg { display: block; }

  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: auto; padding-top: 0.4rem;
  }
  .play-btn {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border: 0.5px solid var(--border-mid); border-radius: 20px;
    background: transparent; color: var(--text-dim);
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em;
    cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .play-btn:hover { background: var(--glass-bg-strong); border-color: var(--sc); color: var(--text-deep); }
  [data-state="loading"] .play-btn { border-color: var(--sc); cursor: wait; }
  [data-state="playing"] .play-btn { background: var(--sc); border-color: var(--sc); color: #fff; }
  [data-state="error"] .play-btn { color: #ff7777; border-color: rgba(255,100,100,0.3); }
  .btn-icon { font-size: 0.6rem; }
  .site-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border: 0.5px solid var(--border-mid);
    border-radius: 50%; color: var(--text-dim); font-size: 0.68rem;
    text-decoration: none; transition: all 0.2s; flex-shrink: 0;
  }
  .site-link:hover { background: var(--glass-bg-strong); border-color: var(--sc); color: var(--text-deep); }

  /* ── Link-only Grid ── */
  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 580px) { .link-grid { grid-template-columns: 1fr; } }

  /* ── Link Card ── */
  .link-card {
    position: relative;
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: 0.9rem 1rem;
    background: var(--glass-bg);
    border: 0.5px solid var(--border-mid);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    overflow: hidden;
  }
  .link-card::before {
    content: '';
    position: absolute; inset-block: 0; left: 0;
    width: 2px; background: var(--sc); opacity: 0.3;
    border-radius: 0 1px 1px 0; transition: opacity 0.2s;
  }
  .link-card:hover {
    background: var(--glass-bg-strong);
    border-color: var(--sc);
  }
  .link-card:hover::before { opacity: 1; }

  .lc-top {
    display: flex; align-items: center; justify-content: space-between;
  }
  .lc-location {
    display: flex; align-items: center; gap: 0.3rem;
    font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim);
  }
  .lc-arrow {
    font-size: 0.75rem; color: var(--text-dim);
    transition: color 0.2s, transform 0.2s;
  }
  .link-card:hover .lc-arrow { color: var(--sc); transform: translate(1px, -1px); }

  .lc-name {
    font-family: var(--font-mono); font-size: 0.85rem; font-weight: 500;
    color: var(--text-deep); line-height: 1.3;
  }
  .lc-desc {
    font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--text-dim); line-height: 1.5;
  }
  .lc-pills { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.1rem; }

  /* ── Note ── */
  .streams-note {
    margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.62rem;
    color: var(--text-dim); opacity: 0.5; line-height: 1.6; text-align: center;
  }
</style>

<script>
  let activeAudio: HTMLAudioElement | null = null;
  let activeCard:  HTMLElement | null = null;

  const nowBar  = document.getElementById('ugNowBar')  as HTMLElement;
  const nowName = document.getElementById('ugNowName') as HTMLElement;
  const stopBtn = document.getElementById('ugStopAll') as HTMLButtonElement;

  function setCardState(card: HTMLElement, state: 'idle'|'loading'|'playing'|'error') {
    card.dataset.state = state;
    const icon  = card.querySelector<HTMLElement>('.btn-icon');
    const label = card.querySelector<HTMLElement>('.btn-label');
    if (!icon || !label) return;
    switch (state) {
      case 'idle':    icon.textContent = '▶'; label.textContent = 'Play'; break;
      case 'loading': icon.textContent = '…'; label.textContent = 'Loading'; break;
      case 'playing': icon.textContent = '■'; label.textContent = 'Stop'; break;
      case 'error':   icon.textContent = '✕'; label.textContent = 'Error'; break;
    }
  }

  function stopAll() {
    if (activeAudio) { activeAudio.pause(); activeAudio.src = ''; activeAudio = null; }
    if (activeCard)  { setCardState(activeCard, 'idle'); activeCard = null; }
    if (nowBar) nowBar.hidden = true;
  }

  function playStation(card: HTMLElement) {
    if (activeCard === card) { stopAll(); return; }
    stopAll();

    const url  = card.dataset.url  ?? '';
    const name = card.dataset.name ?? '';

    setCardState(card, 'loading');
    activeCard = card;
    if (nowBar && nowName) { nowName.textContent = name; nowBar.hidden = false; }

    const audio = new Audio();
    audio.volume = 0.8;
    activeAudio = audio;

    let timeout: ReturnType<typeof setTimeout>;

    const onError = () => {
      if (activeAudio !== audio) return;
      clearTimeout(timeout);
      setCardState(card, 'error');
      activeAudio = null; activeCard = null;
      if (nowBar) nowBar.hidden = true;
    };

    audio.addEventListener('canplay', () => {
      if (activeAudio !== audio) return;
      clearTimeout(timeout);
      setCardState(card, 'playing');
      audio.play().catch(onError);
    }, { once: true });

    audio.addEventListener('error', onError, { once: true });

    timeout = setTimeout(() => {
      if (activeAudio === audio && card.dataset.state === 'loading') {
        setCardState(card, 'playing');
        audio.play().catch(onError);
      }
    }, 10000);

    audio.src = url;
    audio.load();
  }

  document.querySelectorAll<HTMLElement>('.station-card').forEach((card) => {
    card.querySelector<HTMLButtonElement>('.play-btn')?.addEventListener('click', () => {
      if (card.dataset.state === 'error') { setCardState(card, 'idle'); return; }
      playStation(card);
    });
  });

  stopBtn?.addEventListener('click', stopAll);
  document.addEventListener('astro:before-swap', stopAll);
</script>
