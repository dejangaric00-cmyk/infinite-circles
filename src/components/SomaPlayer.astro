---
// src/components/SomaPlayer.astro
---

<div class="soma-wrap">
  <div class="soma-header">
    <span class="soma-badge"><span class="live-dot" id="live-dot"></span>live</span>
    <span class="soma-source">soma fm · community radio</span>
  </div>

  <div class="station-grid">
    <button class="station-btn active" data-stream="https://ice1.somafm.com/dronezone-128-mp3" data-name="drone zone">
      <span class="station-name">Drone Zone</span>
      <span class="station-genre">ambient · dub · space</span>
    </button>
    <button class="station-btn" data-stream="https://ice1.somafm.com/deepspaceone-128-mp3" data-name="deep space one">
      <span class="station-name">Deep Space One</span>
      <span class="station-genre">deep ambient · experimental</span>
    </button>
    <button class="station-btn" data-stream="https://ice1.somafm.com/groovesalad-128-mp3" data-name="groove salad">
      <span class="station-name">Groove Salad</span>
      <span class="station-genre">ambient groove · downtempo</span>
    </button>
    <button class="station-btn" data-stream="https://ice1.somafm.com/thetrip-128-mp3" data-name="the trip">
      <span class="station-name">The Trip</span>
      <span class="station-genre">psychedelic · progressive</span>
    </button>
  </div>

  <div class="now-playing-track" id="soma-np-bar">
    <img class="np-cover" id="soma-np-cover" src="" alt="" aria-hidden="true">
    <div class="np-text">
      <span class="np-track" id="soma-np-track">—</span>
      <span class="np-artist" id="soma-np-artist"></span>
      <span class="np-album" id="soma-np-album"></span>
    </div>
  </div>

  <canvas class="soma-viz" id="soma-viz" aria-hidden="true"></canvas>

  <div class="player-bar">
    <button class="play-btn" id="play-btn" aria-label="Play/Pause">
      <svg id="icon-play" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><polygon points="2,1 11,6 2,11"/></svg>
      <svg id="icon-pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" style="display:none"><rect x="1.5" y="1" width="3" height="10" rx="1"/><rect x="7.5" y="1" width="3" height="10" rx="1"/></svg>
    </button>
    <div class="now-info">
      <span class="now-label">// now</span>
      <span class="now-station" id="now-station">drone zone</span>
    </div>
    <div class="volume-wrap">
      <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true" style="opacity:.4"><path d="M1 4h2l3-3v10L3 8H1V4zm7.5.5a3 3 0 010 3"/></svg>
      <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="0.8" aria-label="Lautstärke">
    </div>
  </div>

  <audio id="soma-audio" preload="none"></audio>
</div>

<style>
.now-playing-track {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.6rem 1rem;
  border-bottom: 0.5px solid var(--border-mid);
  background: transparent;
  min-width: 0;
}

.np-cover {
  width: 38px;
  height: 38px;
  border-radius: 4px;
  object-fit: cover;
  flex-shrink: 0;
  background: var(--glass-bg-strong);
  display: none;
  transition: opacity 0.4s ease;
}

.np-cover.loaded {
  display: block;
  opacity: 1;
}

.np-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  flex: 1;
}

.np-track {
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: var(--text-deep);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.np-artist {
  font-family: var(--font-mono);
  font-size: 8.5px;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.np-album {
  font-family: var(--font-mono);
  font-size: 8px;
  color: var(--text-dim);
  opacity: 0.55;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  font-style: italic;
}

.soma-viz {
  display: block;
  width: 100%;
  height: 48px;
  border-bottom: 0.5px solid var(--border-mid);
  background: transparent;
}

.soma-wrap {
  border: 0.5px solid var(--border-mid);
  border-radius: 8px;
  overflow: hidden;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.soma-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.55rem 1rem;
  border-bottom: 0.5px solid var(--border-mid);
}

.soma-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--accent);
}

.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.35;
  transition: opacity 0.3s;
}

.live-dot.active {
  opacity: 1;
  animation: pulse-dot 1.8s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.soma-source {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .08em;
  color: var(--text-dim);
}

.station-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 0.5px solid var(--border-mid);
}

.station-btn {
  all: unset;
  cursor: pointer;
  padding: 0.7rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 2px;
  border-right: 0.5px solid var(--border-mid);
  border-bottom: 0.5px solid var(--border-mid);
  transition: background 0.15s;
}

.station-btn:nth-child(even) { border-right: none; }
.station-btn:nth-child(3),
.station-btn:nth-child(4) { border-bottom: none; }

.station-btn:hover {
  background: var(--glass-bg-strong);
}

.station-btn.active {
  background: var(--glass-bg-strong);
}

.station-name {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: .04em;
  transition: color 0.15s;
}

.station-btn.active .station-name {
  color: var(--accent);
}

.station-genre {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--text-dim);
  letter-spacing: .03em;
  opacity: 0.7;
}

.player-bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.65rem 1rem;
}

.play-btn {
  all: unset;
  cursor: pointer;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 0.5px solid var(--border-mid);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-deep);
  flex-shrink: 0;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
}

.play-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.play-btn.playing {
  border-color: var(--accent);
  color: var(--accent);
}

.now-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-width: 0;
}

.now-label {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .12em;
  color: var(--accent);
  flex-shrink: 0;
  opacity: 0.7;
}

.now-station {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-deep);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: .04em;
}

.volume-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 60px;
  height: 2px;
  background: var(--border-mid);
  border-radius: 2px;
  outline: none;
  cursor: pointer;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
  cursor: pointer;
}

input[type="range"]::-moz-range-thumb {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
  border: none;
  cursor: pointer;
}

@media (max-width: 500px) {
  .station-grid { grid-template-columns: 1fr; }
  .station-btn { border-right: none !important; }
  .station-btn:nth-child(3) { border-bottom: 0.5px solid var(--border-mid) !important; }
  .station-btn:last-child { border-bottom: none !important; }
}
</style>

<script>
  const audio = document.getElementById('soma-audio') as HTMLAudioElement;
  const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
  const iconPlay = document.getElementById('icon-play') as SVGElement;
  const iconPause = document.getElementById('icon-pause') as SVGElement;
  const nowStation = document.getElementById('now-station') as HTMLSpanElement;
  const liveDot = document.getElementById('live-dot') as HTMLSpanElement;
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  const stationBtns = document.querySelectorAll<HTMLButtonElement>('.station-btn');

  let isPlaying = false;

  audio.volume = 0.8;

  function setPlaying(playing: boolean) {
    isPlaying = playing;
    playBtn.classList.toggle('playing', playing);
    iconPlay.style.display = playing ? 'none' : 'block';
    iconPause.style.display = playing ? 'block' : 'none';
    liveDot.classList.toggle('active', playing);
  }

  playBtn.addEventListener('click', () => {
    if (!isPlaying) {
      const active = document.querySelector<HTMLButtonElement>('.station-btn.active');
      if (active && (!audio.src || audio.src === window.location.href)) {
        audio.src = active.dataset.stream ?? '';
        audio.load();
      }
      audio.play().then(() => setPlaying(true)).catch(() => {});
    } else {
      audio.pause();
      setPlaying(false);
    }
  });

  stationBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      stationBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      audio.src = btn.dataset.stream ?? '';
      audio.load();
      nowStation.textContent = btn.dataset.name ?? '';
      audio.play().then(() => setPlaying(true)).catch(() => {});
    });
  });

  volumeSlider.addEventListener('input', () => {
    audio.volume = parseFloat(volumeSlider.value);
  });

  audio.addEventListener('play', () => setPlaying(true));
  audio.addEventListener('pause', () => setPlaying(false));
  audio.addEventListener('error', () => setPlaying(false));

  // ── Visualizer ─────────────────────────────────────────────────────
  const vizCanvas = document.getElementById('soma-viz') as HTMLCanvasElement;
  const vizCtx    = vizCanvas?.getContext('2d');
  const BAR_COUNT = 48;

  // Resize canvas to match CSS size
  function resizeViz() {
    if (!vizCanvas) return;
    vizCanvas.width  = vizCanvas.offsetWidth  * devicePixelRatio;
    vizCanvas.height = vizCanvas.offsetHeight * devicePixelRatio;
  }
  resizeViz();
  window.addEventListener('resize', resizeViz, { passive: true });

  // Accent color from CSS variable
  function getAccent(): string {
    return getComputedStyle(document.documentElement)
      .getPropertyValue('--accent').trim() || '#1a6bb5';
  }

  // ─ Real AudioContext path ───────────────────────────────────────────
  let analyser: AnalyserNode | null = null;
  let freqData: Uint8Array | null   = null;
  let audioCtx: AudioContext | null = null;
  let usingRealData = false;

  function tryConnectAnalyser() {
    if (audioCtx) return; // bereits verbunden — nie ein zweites Mal aufrufen!
    try {
      audioCtx  = new AudioContext();
      const src = audioCtx.createMediaElementSource(audio);
      analyser  = audioCtx.createAnalyser();
      analyser.fftSize = BAR_COUNT * 4;
      analyser.smoothingTimeConstant = 0.82;
      src.connect(analyser);
      analyser.connect(audioCtx.destination);
      freqData = new Uint8Array(analyser.frequencyBinCount);
      usingRealData = true;
    } catch {
      usingRealData = false;
    }
  }

  // ─ Organic fake fallback ───────────────────────────────────────
  // Layered sine waves → feels like real music, not random noise
  const fakePhases  = Array.from({ length: BAR_COUNT }, (_, i) => Math.random() * Math.PI * 2);
  const fakeSpeeds  = Array.from({ length: BAR_COUNT }, (_, i) => 0.018 + (i / BAR_COUNT) * 0.022 + Math.random() * 0.01);
  const fakeProfile = Array.from({ length: BAR_COUNT }, (_, i) => {
    // Bass heavy left, treble right, natural roll-off
    const x = i / BAR_COUNT;
    return 0.15 + 0.85 * Math.exp(-Math.pow((x - 0.18) * 2.2, 2))
                + 0.45 * Math.exp(-Math.pow((x - 0.55) * 3.0, 2))
                + 0.25 * Math.exp(-Math.pow((x - 0.80) * 4.0, 2));
  });
  let fakeT = 0;

  function getFakeBar(i: number): number {
    const p = fakePhases[i];
    const s = fakeSpeeds[i];
    const v = 0.5
      + 0.28 * Math.sin(fakeT * s           + p)
      + 0.14 * Math.sin(fakeT * s * 2.3     + p * 1.7)
      + 0.08 * Math.sin(fakeT * s * 0.5     + p * 0.6)
      + 0.06 * Math.sin(fakeT * (i * 0.04)  + p * 2.1);
    return Math.max(0.04, Math.min(1, v * fakeProfile[i]));
  }

  // ─ Draw loop ──────────────────────────────────────────────────────
  const smoothed = new Float32Array(BAR_COUNT).fill(0.04);

  function drawViz() {
    requestAnimationFrame(drawViz);
    if (!vizCanvas || !vizCtx) return;

    const W = vizCanvas.width;
    const H = vizCanvas.height;
    vizCtx.clearRect(0, 0, W, H);

    const playing = isPlaying;
    const accent  = getAccent();

    if (playing) fakeT++;

    const gap     = 2 * devicePixelRatio;
    const barW    = (W - gap * (BAR_COUNT - 1)) / BAR_COUNT;
    const maxH    = H * 0.88;
    const centerY = H / 2;

    for (let i = 0; i < BAR_COUNT; i++) {
      let target: number;

      if (playing && usingRealData && analyser && freqData) {
        analyser.getByteFrequencyData(freqData);
        // Map bars to frequency bins (log-ish scale, focus on bass/mid)
        const binIdx = Math.floor(Math.pow(i / BAR_COUNT, 0.7) * freqData.length * 0.75);
        target = freqData[binIdx] / 255;
      } else if (playing) {
        target = getFakeBar(i);
      } else {
        target = 0.04; // idle — tiny base line
      }

      // Smooth
      const speed = target > smoothed[i] ? 0.18 : 0.10;
      smoothed[i] += (target - smoothed[i]) * speed;

      const bH  = Math.max(2 * devicePixelRatio, smoothed[i] * maxH);
      const x   = i * (barW + gap);
      const y   = centerY - bH / 2;

      // Gradient: accent at top, dimmer at bottom
      const grad = vizCtx.createLinearGradient(0, y, 0, y + bH);
      grad.addColorStop(0,   accent + 'cc');
      grad.addColorStop(0.5, accent + '99');
      grad.addColorStop(1,   accent + '44');

      vizCtx.fillStyle = grad;
      vizCtx.beginPath();
      vizCtx.roundRect(x, y, barW, bH, 1.5);
      vizCtx.fill();
    }
  }

  drawViz();

  // Try real analyser when playback starts
  let analyserConnected = false;
  audio.addEventListener('play', () => {
    if (!analyserConnected) {
      tryConnectAnalyser();
      analyserConnected = true;
    }
    if (audioCtx?.state === 'suspended') audioCtx.resume();
  });

  // ── SomaFM Now Playing API ────────────────────────────────────────────────
  // https://somafm.com/channels.json → channels[].lastPlaying
  const SOMA_CHANNEL_MAP: Record<string, string> = {
    'https://ice1.somafm.com/dronezone-128-mp3':   'dronezone',
    'https://ice1.somafm.com/deepspaceone-128-mp3': 'deepspaceone',
    'https://ice1.somafm.com/groovesalad-128-mp3':  'groovesalad',
    'https://ice1.somafm.com/thetrip-128-mp3':      'thetrip',
  };

  const npTrack  = document.getElementById('soma-np-track')  as HTMLElement;
  const npArtist = document.getElementById('soma-np-artist') as HTMLElement;
  const npAlbum  = document.getElementById('soma-np-album')  as HTMLElement;
  const npCover  = document.getElementById('soma-np-cover')  as HTMLImageElement;

  async function fetchNowPlaying() {
    const activeBtn = document.querySelector<HTMLButtonElement>('.station-btn.active');
    if (!activeBtn) return;
    const channelId = SOMA_CHANNEL_MAP[activeBtn.dataset.stream ?? ''];
    if (!channelId) return;
    try {
      const resp = await fetch(`https://somafm.com/songs/${channelId}.json`, {
        signal: AbortSignal.timeout(5000)
      });
      if (!resp.ok) return;
      const data = await resp.json();
      const song = data?.songs?.[0];
      if (!song) return;
      if (npTrack)  npTrack.textContent  = song.title  || '—';
      if (npArtist) npArtist.textContent = song.artist || '';
      if (npAlbum)  npAlbum.textContent  = song.album  || '';
      // Cover Art — albumart kann relativ sein, daher zu absoluter URL normalisieren
      if (npCover) {
        const raw = song.albumart || '';
        const src = raw.startsWith('http') ? raw
                  : raw.startsWith('/')    ? 'https://somafm.com' + raw
                  : '';
        if (src) {
          npCover.classList.remove('loaded');
          const img = new Image();
          img.onload = () => { npCover.src = src; npCover.classList.add('loaded'); };
          img.onerror = () => { npCover.classList.remove('loaded'); };
          img.src = src;
        } else {
          npCover.classList.remove('loaded');
        }
      }
    } catch { /* silent */ }
  }

  // Poll every 30s, and immediately on station switch
  fetchNowPlaying();
  setInterval(fetchNowPlaying, 30000);

  // Re-fetch when station changes
  stationBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (npTrack)  npTrack.textContent  = '—';
      if (npArtist) npArtist.textContent = '';
      if (npAlbum)  npAlbum.textContent  = '';
      if (npCover)  { npCover.classList.remove('loaded'); }
      setTimeout(fetchNowPlaying, 1000);
    });
  });
</script>
