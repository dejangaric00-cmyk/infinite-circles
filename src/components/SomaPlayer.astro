---
// src/components/SomaPlayer.astro
//
// Register links, Plattenfeld rechts. Die Bedienelemente sitzen im Jetzt-Feld,
// nicht mehr in einer eigenen Leiste unter der Karte — der Kopfbalken mit dem
// LIVE-Abzeichen ist weggefallen, die Angabe steht jetzt im Abschnittskopf.
// Lautstärke als Zahl statt als Regler: Klick +10 %, Scrollen ±10 %.
---

<div class="soma-wrap">
  <div class="soma-body">
    <div class="station-grid glass-surface">
      <button class="station-btn active" data-stream="https://ice5.somafm.com/dronezone-128-mp3" data-name="drone zone" data-slug="dronezone" data-genre="ambient · dub · space">
        <span class="st-num">01</span>
        <span class="st-text">
          <span class="station-name">Drone Zone</span>
          <span class="station-genre">ambient · dub · space</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/deepspaceone-128-mp3" data-name="deep space one" data-slug="deepspaceone" data-genre="deep ambient · experimental">
        <span class="st-num">02</span>
        <span class="st-text">
          <span class="station-name">Deep Space One</span>
          <span class="station-genre">deep ambient · experimental</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/groovesalad-128-mp3" data-name="groove salad" data-slug="groovesalad" data-genre="ambient groove · downtempo">
        <span class="st-num">03</span>
        <span class="st-text">
          <span class="station-name">Groove Salad</span>
          <span class="station-genre">ambient groove · downtempo</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/thetrip-128-mp3" data-name="the trip" data-slug="thetrip" data-genre="psychedelic · progressive">
        <span class="st-num">04</span>
        <span class="st-text">
          <span class="station-name">The Trip</span>
          <span class="station-genre">psychedelic · progressive</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/fluid-128-mp3" data-name="fluid" data-slug="fluid" data-genre="new age · ambient · chill">
        <span class="st-num">05</span>
        <span class="st-text">
          <span class="station-name">Fluid</span>
          <span class="station-genre">new age · ambient · chill</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/illstreet-128-mp3" data-name="illinois street lounge" data-slug="illstreet" data-genre="vintage lounge · cocktail">
        <span class="st-num">06</span>
        <span class="st-text">
          <span class="station-name">Illinois Street Lounge</span>
          <span class="station-genre">vintage lounge · cocktail</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/thistle-128-mp3" data-name="thistle radio" data-slug="thistle" data-genre="celtic · folk · world">
        <span class="st-num">07</span>
        <span class="st-text">
          <span class="station-name">Thistle Radio</span>
          <span class="station-genre">celtic · folk · world</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
      <button class="station-btn" data-stream="https://ice5.somafm.com/lush-128-mp3" data-name="lush" data-slug="lush" data-genre="indie · shoegaze · dream pop">
        <span class="st-num">08</span>
        <span class="st-text">
          <span class="station-name">Lush</span>
          <span class="station-genre">indie · shoegaze · dream pop</span>
        </span>
        <span class="st-mark">on air</span>
      </button>
    </div>

    <div class="now-playing-track glass-surface" id="soma-np-bar">
      <span class="np-kicker"><span class="np-dot" id="live-dot"></span>jetzt</span>
      <img class="np-cover" id="soma-np-cover" src="" alt="" aria-hidden="true">
      <div class="np-text">
        <span class="np-track" id="soma-np-track">—</span>
        <span class="np-album" id="soma-np-album"></span>
        <span class="np-artist" id="soma-np-artist"></span>
      </div>

      <div class="np-rule"></div>

      <div class="np-controls">
        <button class="play-btn" id="play-btn" aria-label="Play/Pause">
          <svg id="icon-play" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><polygon points="2,1 11,6 2,11"/></svg>
          <svg id="icon-pause" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" style="display:none"><rect x="1.5" y="1" width="3" height="10" rx="1"/><rect x="7.5" y="1" width="3" height="10" rx="1"/></svg>
        </button>
        <span class="np-state">
          <span id="np-state-word">bereit</span>
          <span class="np-state-sep">·</span>
          <span id="now-station">ambient · dub · space</span>
        </span>
        <button class="vol-btn" id="volume-btn" type="button"
          title="Klick: +10 % · Scrollen: ±10 %"
          aria-label="Lautstärke">Vol&nbsp;<span id="volume-val">80</span>&nbsp;%</button>
      </div>
    </div>
  </div>
</div>

<style>
.soma-wrap { --sep: 1px solid var(--border-mid); }

/* ── Register + Jetzt-Feld ──
   Zwei eigenständige Karten nebeneinander, nicht eine geteilte: das Feld
   rechts endet unter seinen Bedienelementen, statt sich auf die Höhe der
   acht Kanäle zu strecken und eine leere Fläche aufzuspannen. */
.soma-body {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 0.9rem;
  align-items: start;
}

.station-grid { display: flex; flex-direction: column; overflow: hidden; }

/* Zeile statt Kachel: Nummer, Name, Genre, rechts die Kennzeichnung. */
.station-btn {
  all: unset; cursor: pointer;
  display: grid;
  grid-template-columns: 26px 1fr auto;
  align-items: baseline;
  gap: 0.9rem;
  padding: 0.7rem 1.2rem;
  border-bottom: var(--sep);
  transition: background 0.3s var(--ease-ios);
}
.station-btn:last-child { border-bottom: none; }
.station-btn:hover { background: var(--glass-ctrl); }
.station-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
/* Die aktive Zeile trägt im Entwurf keine Fläche — Ziffer und „on air" in
   Akzentfarbe sind die Kennzeichnung. */

.st-num {
  font-family: var(--font-mono); font-size: 10px; color: var(--text-dim);
  font-feature-settings: 'tnum';
}
.station-btn.active .st-num { color: var(--accent-ink); }

.st-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.station-name {
  font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.15;
  color: var(--text-deep); letter-spacing: .01em;
}
.station-genre {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .12em;
  text-transform: uppercase; color: var(--text-dim);
}

.st-mark {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .16em;
  text-transform: uppercase; color: var(--accent-ink);
  opacity: 0; transition: opacity 0.3s var(--ease-ios);
}
.station-btn.active .st-mark { opacity: 1; }

/* ── Jetzt läuft ────────────────────────────────────────────────────────── */
.now-playing-track {
  display: flex; flex-direction: column; gap: 0.7rem;
  padding: 1.1rem 1.2rem 1rem;
  min-width: 0;
}
.np-kicker {
  display: flex; align-items: center; gap: 6px;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .2em;
  text-transform: uppercase; color: var(--accent-ink);
}
.np-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--accent); opacity: 0.3;
  transition: opacity 0.3s var(--ease-ios);
}
.np-dot.active { opacity: 1; animation: pulse-dot 2.4s ease-in-out infinite; }
@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

.np-cover {
  width: 96px; height: 96px; border-radius: 4px;
  object-fit: cover;
  background: var(--glass-ctrl);
  display: none; opacity: 0;
  box-shadow: 0 1px 2px rgba(0,0,0,0.12), 0 6px 16px rgba(0,0,0,0.12);
  transition: opacity 0.5s var(--ease-ios);
}
.np-cover.loaded { display: block; opacity: 1; }
.np-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
.np-track {
  font-family: var(--font-serif); font-size: 1.55rem; line-height: 1.15;
  color: var(--text-deep);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.np-album {
  font-family: var(--font-serif); font-style: italic; font-size: 1rem;
  color: var(--text-mid); line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.np-artist {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--text-dim);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.np-album:empty, .np-artist:empty { display: none; }

/* ── Bedienelemente im Feld ─────────────────────────────────────────────── */
.np-rule { height: 0.5px; background: var(--glass-sep); margin: 0.3rem 0 0.1rem; }

.np-controls {
  display: flex; align-items: center; gap: 0.75rem;
  min-width: 0;
}
/* Umrandet statt gefüllt — der Ring ist die einzige Fläche, die der Knopf braucht. */
.play-btn {
  all: unset; cursor: pointer;
  width: 38px; height: 38px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-deep); flex-shrink: 0;
  box-shadow: inset 0 0 0 0.5px var(--text-dim);
  transition: color 0.3s var(--ease-ios), box-shadow 0.3s var(--ease-ios), background 0.3s var(--ease-ios);
}
.play-btn:hover { background: var(--glass-ctrl); box-shadow: inset 0 0 0 0.5px var(--accent); }
.play-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.play-btn.playing {
  color: var(--accent-ink);
  box-shadow: inset 0 0 0 1px var(--accent);
}

.np-state {
  flex: 1; min-width: 0;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--text-dim);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.np-state-sep { opacity: 0.5; margin: 0 0.3em; }
#np-state-word { color: var(--accent-ink); }

.vol-btn {
  all: unset; cursor: pointer; flex-shrink: 0;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--text-dim);
  font-feature-settings: 'tnum';
  transition: color 0.2s var(--ease-ios);
}
.vol-btn:hover { color: var(--text-deep); }
.vol-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

@media (max-width: 640px) {
  .soma-body { grid-template-columns: 1fr; }
  .np-cover { width: 72px; height: 72px; }
}
</style>

<script>
  import { load, toggle, setVolume, setTrack, subscribe, getState } from '../utils/player';
  import { onPage, disposer } from '../utils/lifecycle';

  onPage(() => {
    const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
    const iconPlay = document.getElementById('icon-play') as SVGElement;
    const iconPause = document.getElementById('icon-pause') as SVGElement;
    const nowStation = document.getElementById('now-station') as HTMLSpanElement;
    const stateWord = document.getElementById('np-state-word') as HTMLSpanElement;
    const liveDot = document.getElementById('live-dot') as HTMLSpanElement;
    const volBtn = document.getElementById('volume-btn') as HTMLButtonElement;
    const volVal = document.getElementById('volume-val') as HTMLSpanElement;
    const stationBtns = document.querySelectorAll<HTMLButtonElement>('.station-btn');

    const npTrack  = document.getElementById('soma-np-track')  as HTMLElement;
    const npArtist = document.getElementById('soma-np-artist') as HTMLElement;
    const npAlbum  = document.getElementById('soma-np-album')  as HTMLElement;
    const npCover  = document.getElementById('soma-np-cover')  as HTMLImageElement;

    if (!playBtn) return; // component not on this page

    const off = disposer();

    // ── Lautstärke als Zahl ────────────────────────────────────────────────
    function paintVolume(v: number) {
      volVal.textContent = String(Math.round(v * 100));
    }
    /** Steps of ten, wrapping back to zero past the top. */
    function stepVolume(dir: number) {
      const cur = Math.round(getState().volume * 10);
      const next = ((cur + dir) % 11 + 11) % 11;
      setVolume(next / 10);
    }
    paintVolume(getState().volume);

    volBtn.addEventListener('click', () => stepVolume(1));
    volBtn.addEventListener('wheel', (e) => {
      e.preventDefault();
      stepVolume(e.deltaY < 0 ? 1 : -1);
    }, { passive: false });
    volBtn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp' || e.key === 'ArrowRight') { e.preventDefault(); stepVolume(1); }
      if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') { e.preventDefault(); stepVolume(-1); }
    });

    function activeBtn(): HTMLButtonElement | null {
      return document.querySelector<HTMLButtonElement>('.station-btn.active');
    }

    function markActive(btn: HTMLButtonElement) {
      stationBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      nowStation.textContent = btn.dataset.genre ?? btn.dataset.name ?? '';
    }

    // ── URL State ──────────────────────────────────────────────────────────────
    function applyUrlStation() {
      const slug = new URLSearchParams(window.location.search).get('station');
      if (!slug) return;
      const target = Array.from(stationBtns).find(b => b.dataset.slug === slug);
      if (target && !target.classList.contains('active')) markActive(target);
    }
    applyUrlStation();

    function setUrlStation(slug: string) {
      const url = new URL(window.location.href);
      url.searchParams.set('station', slug);
      history.replaceState(null, '', url.toString());
    }

    // Adopt whatever the engine is already playing — matters when arriving on
    // this page while a station is running.
    {
      const s = getState();
      if (s.source === 'soma' && s.stationSlug) {
        const running = Array.from(stationBtns).find(b => b.dataset.slug === s.stationSlug);
        if (running) markActive(running);
      }
    }

    function playStation(btn: HTMLButtonElement) {
      markActive(btn);
      setUrlStation(btn.dataset.slug ?? '');
      clearNowPlaying();
      void load({
        source: 'soma',
        src: btn.dataset.stream ?? '',
        stationSlug: btn.dataset.slug ?? '',
        stationName: btn.dataset.name ?? '',
        track: { title: '—', artist: btn.dataset.name ?? 'soma fm', album: '' },
      });
      setTimeout(fetchNowPlaying, 1000);
    }

    playBtn.addEventListener('click', () => {
      // Another source is running, or nothing was loaded yet — start this station.
      if (getState().source !== 'soma') {
        const btn = activeBtn();
        if (btn) playStation(btn);
        return;
      }
      toggle();
    });

    stationBtns.forEach(btn => {
      btn.addEventListener('click', () => playStation(btn));
    });

    // ── Render from engine state ───────────────────────────────────────────────
    off.add(subscribe((s) => {
      const mine = s.source === 'soma';
      const isPlaying = mine && s.playing;

      playBtn.classList.toggle('playing', isPlaying);
      iconPlay.style.display = isPlaying ? 'none' : 'block';
      iconPause.style.display = isPlaying ? 'block' : 'none';
      liveDot.classList.toggle('active', isPlaying);
      stateWord.textContent = isPlaying ? 'läuft' : mine && s.loading ? 'lädt' : 'bereit';

      paintVolume(s.volume);
    }));

    // ── SomaFM Now Playing — only polls while playing ─────────────────────────
    async function fetchNowPlaying() {
      const active = document.querySelector<HTMLButtonElement>('.station-btn.active');
      if (!active) return;
      const channelId = active.dataset.slug ?? '';
      if (!channelId) return;
      try {
        const resp = await fetch(`https://somafm.com/songs/${channelId}.json`, {
          signal: AbortSignal.timeout(5000)
        });
        if (!resp.ok) return;
        const data = await resp.json();
        const song = data?.songs?.[0];
        if (!song) return;
        const title  = song.title  || '—';
        const artist = song.artist || '';
        const album  = song.album  || '';

        if (npTrack)  npTrack.textContent  = title;
        if (npArtist) npArtist.textContent = artist;
        if (npAlbum)  npAlbum.textContent  = album;

        const raw = song.albumart || '';
        const cover = raw.startsWith('http') ? raw
                    : raw.startsWith('/') ? 'https://somafm.com' + raw : '';

        // Hand the metadata to the engine — MiniPlayer and MediaSession read it
        // from there, on this page or any other.
        setTrack({ title, artist, album, cover });

        if (npCover) {
          if (cover) {
            npCover.classList.remove('loaded');
            const img = new Image();
            img.onload  = () => { npCover.src = cover; npCover.classList.add('loaded'); };
            img.onerror = () => { npCover.classList.remove('loaded'); };
            img.src = cover;
          } else {
            npCover.classList.remove('loaded');
          }
        }
      } catch { /* silent */ }
    }

    function clearNowPlaying() {
      if (npTrack)  npTrack.textContent  = '—';
      if (npArtist) npArtist.textContent = '';
      if (npAlbum)  npAlbum.textContent  = '';
      if (npCover)  npCover.classList.remove('loaded');
    }

    // Repaint from engine state when arriving mid-stream on a later visit
    {
      const s = getState();
      if (s.source === 'soma' && s.track.title !== '—') {
        if (npTrack)  npTrack.textContent  = s.track.title;
        if (npArtist) npArtist.textContent = s.track.artist;
        if (npAlbum)  npAlbum.textContent  = s.track.album;
        if (npCover && s.track.cover) { npCover.src = s.track.cover; npCover.classList.add('loaded'); }
      }
    }

    fetchNowPlaying();

    // Poll only while soma is actually playing — zero requests when idle
    let npInterval: ReturnType<typeof setInterval> | null = null;
    off.add(subscribe((s) => {
      const active = s.source === 'soma' && s.playing;
      if (active && !npInterval) {
        npInterval = setInterval(fetchNowPlaying, 30000);
      } else if (!active && npInterval) {
        clearInterval(npInterval);
        npInterval = null;
      }
    }));
    off.add(() => { if (npInterval) { clearInterval(npInterval); npInterval = null; } });

    return off.run;
  });
</script>
