---
// src/components/ArchiveRadio.astro
//
// Karteikarten-Redesign. Skript, IDs, Klassennamen und die Player-/archive-
// Anbindung sind unverändert — neu sind Markup-Struktur und CSS: Genre-Filter
// als umrandete Marken, Titel in Serifen-Kursiv, Bedienelemente als Striche
// statt Neonflächen, Verlauf rechts an einer Haarlinie.
---

<div class="ar-wrap glass-surface">
  {/* Kopfzeile und Statusanzeige liegen im Abschnittskopf der Seite
       (src/pages/radio/index.astro) — die Karte beginnt mit den Marken. */}

  {/* ── Genre Filter ── */}
  <div class="ar-genres" id="ar-genres">
    <button class="ar-genre-btn active" data-genre="all">all</button>
    <button class="ar-genre-btn" data-genre="dub-techno">dub techno</button>
    <button class="ar-genre-btn" data-genre="minimal">minimal</button>
    <button class="ar-genre-btn" data-genre="deep-house">deep house</button>
    <button class="ar-genre-btn" data-genre="ambient">ambient</button>
    <button class="ar-genre-btn" data-genre="electro">electro</button>
    <button class="ar-genre-btn" data-genre="netlabels">netlabels</button>
    <button class="ar-genre-btn" data-genre="drone">drone</button>
    <button class="ar-genre-btn" data-genre="dark-ambient">dark ambient</button>
    <button class="ar-genre-btn" data-genre="industrial">industrial</button>
    <button class="ar-genre-btn" data-genre="idm">IDM</button>
    <button class="ar-genre-btn" data-genre="breakbeat">breakbeat</button>
    <button class="ar-genre-btn" data-genre="downtempo">downtempo</button>
    <button class="ar-genre-btn" data-genre="experimental">experimental</button>
    <button class="ar-genre-btn" data-genre="noise">noise</button>
    <button class="ar-genre-btn" data-genre="jungle">jungle</button>
    <button class="ar-genre-btn" data-genre="acid">acid</button>
    <button class="ar-genre-btn" data-genre="detroit">detroit techno</button>
    <button class="ar-genre-btn" data-genre="field-recordings">field recordings</button>
  </div>

  <div class="ar-columns">
    <div class="ar-body">
      <div class="ar-loading" id="rp-loading">Archive.org wird durchsucht…</div>

      <div id="rp-main" style="display:none">
        <div class="ar-track-block">
          <div class="ar-track" id="rp-track">—</div>
          <div class="ar-artist" id="rp-artist">—</div>
        </div>

        <div class="ar-rule"></div>

        <div class="ar-controls">
          <button class="ar-btn" id="rp-play-btn" type="button">
            <span class="ar-btn-icon">▶</span><span class="ar-btn-label">Play</span>
          </button>
          <button class="ar-btn" id="rp-skip-btn" type="button">
            <span class="ar-btn-icon">⏭</span><span class="ar-btn-label">Skip</span>
          </button>
          <button class="ar-btn" id="rp-like-btn" type="button">
            <span class="ar-btn-icon">♡</span><span class="ar-btn-label">Like</span>
          </button>
        </div>

        <div class="ar-seek-row">
          <span class="ar-time" id="ar-current">0:00</span>
          <div class="ar-seek-wrap">
            <div class="ar-seek-bg">
              <div class="ar-seek-fill" id="ar-seek-fill"></div>
            </div>
            <input type="range" id="ar-seek" min="0" max="100" value="0" step="0.1"
              class="ar-seek-input" aria-label="Position">
          </div>
          <span class="ar-time" id="ar-duration">—</span>
        </div>

        <div class="ar-track-info">
          <span>Archive.org</span>&ensp;·&ensp;
          <a class="ar-archive-link" id="rp-link" href="#" target="_blank" rel="noopener">Original öffnen ↗</a>
        </div>
      </div>
    </div>

    {/* ── Song History ── */}
    {/* Steht auch leer da: die Spalte trägt die halbe Karte, ihr Wegblenden
         würde das Raster jedes Mal springen lassen. */}
    <div class="ar-history" id="ar-history">
      <div class="ar-history-header">
        <span class="ar-history-label">Zuletzt gespielt</span>
        <button class="ar-history-clear" id="ar-history-clear">clear</button>
      </div>
      <div class="ar-history-items" id="ar-history-items"></div>
      <p class="ar-history-empty" id="ar-history-empty">Noch nichts gespielt.</p>
    </div>
  </div>
</div>

<style>
.ar-wrap {
  overflow: hidden;
  --sep: 1px solid var(--border-mid);
}

/* ── Genre-Filter: umrandete Marken statt gefüllter Pillen ──────────────── */
.ar-genres {
  display: flex; flex-wrap: wrap; gap: 5px;
  padding: 0.75rem 1.2rem;
  border-bottom: var(--sep);
}
.ar-genre-btn {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .13em;
  text-transform: uppercase; color: var(--text-dim);
  padding: 4px 10px; white-space: nowrap;
  border-radius: var(--r-ctrl);
  box-shadow: inset 0 0 0 1px var(--line-chip, var(--border-mid));
  transition: color 0.28s var(--ease-ios), box-shadow 0.28s var(--ease-ios), background 0.28s var(--ease-ios);
}
.ar-genre-btn:hover { color: var(--text-deep); box-shadow: inset 0 0 0 1px var(--accent); }
.ar-genre-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.ar-genre-btn.active {
  color: var(--text-deep);
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  box-shadow: inset 0 0 0 1px var(--accent);
}

/* ── Zwei Spalten: Stück links, Verlauf rechts ──────────────────────────── */
.ar-columns { display: grid; grid-template-columns: 1.5fr 1fr; align-items: start; }

.ar-body { padding: 1.1rem 1.2rem 0.9rem; }
.ar-loading {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim);
  padding: 0.25rem 0;
}
.ar-track-block { display: flex; flex-direction: column; gap: 4px; }
.ar-track {
  font-family: var(--font-serif); font-size: 1.65rem;
  font-weight: 300; font-style: italic;
  color: var(--text-deep); line-height: 1.15;
}
.ar-artist {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .16em; text-transform: uppercase; color: var(--text-mid);
}
.ar-rule { height: 0.5px; background: var(--border-mid); margin: 0.9rem 0; }

.ar-controls { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }

/* Drei gleich gebaute Marken statt zweier Ringe und einer Pille — dieselbe
   Form wie „Listen" auf den Senderkarten. */
.ar-btn {
  all: unset; cursor: pointer;
  display: inline-flex; align-items: center; gap: 0.4rem;
  padding: 0.5rem 1rem;
  border-radius: var(--r-ctrl);
  box-shadow: inset 0 0 0 1px var(--line-ctrl, var(--border-mid));
  font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: .13em;
  text-transform: uppercase; color: var(--text-deep); white-space: nowrap;
  transition: color 0.28s var(--ease-ios), box-shadow 0.28s var(--ease-ios), background 0.28s var(--ease-ios);
}
.ar-btn:hover { background: var(--glass-ctrl); box-shadow: inset 0 0 0 1px var(--accent); }
.ar-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.ar-btn-icon { font-size: 0.58rem; color: var(--accent-ink); }
.ar-btn.playing { box-shadow: inset 0 0 0 1px var(--accent); background: var(--glass-ctrl); }
.ar-btn.liked {
  box-shadow: inset 0 0 0 1px var(--accent);
  background: var(--glass-ctrl);
}

.ar-seek-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.85rem; }
.ar-time {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .08em; color: var(--text-dim);
  flex-shrink: 0; min-width: 30px; font-variant-numeric: tabular-nums;
}
.ar-time:last-child { text-align: right; }
.ar-seek-wrap { flex: 1; position: relative; height: 18px; display: flex; align-items: center; cursor: pointer; }
.ar-seek-bg {
  position: absolute; left: 0; right: 0; height: 1px;
  background: var(--border-mid); overflow: hidden; pointer-events: none;
  transition: height 0.25s var(--ease-ios);
}
.ar-seek-wrap:hover .ar-seek-bg { height: 3px; }
.ar-seek-fill { height: 100%; background: var(--accent); width: 0%; transition: width 0.25s linear; }
.ar-seek-input {
  position: absolute; left: 0; right: 0; width: 100%; height: 18px;
  opacity: 0; cursor: pointer; margin: 0; padding: 0;
  -webkit-appearance: none; appearance: none;
}
.ar-seek-input:focus-visible + .ar-seek-bg,
.ar-seek-wrap:focus-within .ar-seek-bg { outline: 2px solid var(--accent); outline-offset: 3px; }

.ar-track-info {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .13em; text-transform: uppercase;
  color: var(--text-dim);
  padding-top: 0.8rem;
  border-top: var(--sep);
}
.ar-archive-link { color: var(--text-mid); text-decoration: none; }
.ar-archive-link:hover { color: var(--accent-ink); }

/* ── Verlauf ────────────────────────────────────────────────────────────── */
.ar-history {
  border-left: var(--sep);
  padding: 1.1rem 1.2rem 0.9rem;
}
.ar-history-header {
  display: flex; align-items: baseline; justify-content: space-between;
  border-bottom: var(--sep);
  padding-bottom: 0.5rem;
  margin-bottom: 0.3rem;
}
.ar-history-label {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--text-dim);
}
.ar-history-clear {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .13em; text-transform: uppercase; color: var(--text-dim);
  opacity: 0.6; transition: opacity 0.15s, color 0.15s;
}
.ar-history-clear:hover { opacity: 1; color: var(--accent-ink); }
.ar-history-items {
  display: flex; flex-direction: column;
  max-height: 190px; overflow-y: auto;
}
.ar-history-empty {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .14em; text-transform: uppercase; color: var(--text-dim);
  opacity: 0.7; margin: 0.6rem 0 0;
}
.ar-history-empty[hidden] { display: none; }
.ar-history-clear[hidden] { display: none; }
/* :global, weil renderHistory() die Zeilen per createElement baut — solche
   Knoten tragen Astros data-astro-cid nicht, die gescopten Regeln griffen
   nie und die Zeilen liefen ungestylt aus der Karte heraus. */
.ar-history-items :global(.ar-history-item) {
  display: grid; grid-template-columns: minmax(0, 1fr) auto;
  align-items: baseline; gap: 0.75rem;
  padding: 0.5rem 0;
  border-bottom: var(--sep);
  cursor: pointer;
  transition: background 0.28s var(--ease-ios);
}
.ar-history-items :global(.ar-history-item:last-child) { border-bottom: none; }
.ar-history-items :global(.ar-history-item:hover) { background: var(--glass-ctrl); }
.ar-history-items :global(.ar-history-title) {
  font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.35;
  color: var(--text-deep); min-width: 0; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
.ar-history-items :global(.ar-history-meta) {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--text-dim); white-space: nowrap;
  font-feature-settings: 'tnum';
}

@media (max-width: 640px) {
  .ar-columns { grid-template-columns: 1fr; }
  .ar-history { border-left: none; border-top: var(--sep); }
}
</style>

<script>
import {
  playDoc, isLiked, toggleLike, addToHistory,
  loadHistory, clearHistory, fmtTime, fmtAgo,
  HISTORY_CHANGED, ARCHIVE_NEXT, GENRE_QUERIES,
  type ArchiveDoc, type StoredTrack,
} from '../utils/archive';
import {
  subscribe, subscribeTime, registerSourceHandlers,
  toggle as playerToggle, pause as playerPause, seekToPercent, getState,
} from '../utils/player';
import { onPage, disposer } from '../utils/lifecycle';

// Skip requests can arrive from the MiniPlayer, the media keys or the keyboard
// on any page. The queue lives inside the setup closure below, so a module-level
// dispatcher forwards to whichever setup ran last.
let nextHandler: (() => void) | null = null;
window.addEventListener(ARCHIVE_NEXT, () => nextHandler?.());

onPage(() => {
  let activeGenre = 'all';

  let rpTracks: ArchiveDoc[] = [];
  let rpIdx = 0;
  let rpPlaying = false;
  let rpCurrentId = '';

  const $ = (id: string) => document.getElementById(id);
  const rpPlayBtn   = $('rp-play-btn')   as HTMLButtonElement;
  const rpSkipBtn   = $('rp-skip-btn')   as HTMLButtonElement;
  const rpLikeBtn   = $('rp-like-btn')   as HTMLButtonElement;
  const rpStatus    = $('rp-status')     as HTMLElement;
  const rpTrackEl   = $('rp-track')      as HTMLElement;
  const rpArtistEl  = $('rp-artist')     as HTMLElement;
  const rpLinkEl    = $('rp-link')       as HTMLAnchorElement;
  const rpLoading   = $('rp-loading')    as HTMLElement;
  const rpMain      = $('rp-main')       as HTMLElement;
  const arCurrent   = $('ar-current')    as HTMLElement;
  const arDuration  = $('ar-duration')   as HTMLElement;
  const arSeekFill  = $('ar-seek-fill')  as HTMLElement;
  const arSeekInput = $('ar-seek')       as HTMLInputElement;
  const arHistory   = $('ar-history')    as HTMLElement;
  const arHistItems = $('ar-history-items') as HTMLElement;
  const arHistClear = $('ar-history-clear') as HTMLButtonElement;
  const arHistEmpty = $('ar-history-empty') as HTMLElement;
  const genreBtns  = document.querySelectorAll<HTMLButtonElement>('.ar-genre-btn');

  if (!rpPlayBtn) return; // component not on this page

  const off = disposer();

  function setStatus(s: string) { if (rpStatus) rpStatus.textContent = s; }
  function setTrack(title: string, artist: string) {
    if (rpTrackEl)  rpTrackEl.textContent  = title.length > 60 ? title.slice(0, 60) + '…' : title;
    if (rpArtistEl) rpArtistEl.textContent = artist;
  }

  // ── Genre filter ──────────────────────────────────────────────────────────────
  genreBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const genre = btn.dataset.genre ?? 'all';
      if (genre === activeGenre) return;
      activeGenre = genre;
      genreBtns.forEach(b => b.classList.toggle('active', b.dataset.genre === genre));
      // Stop current playback and reload with new genre
      if (getState().source === 'archive') playerPause();
      await rpInit();
    });
  });

  // ── History ───────────────────────────────────────────────────────────────────
  function renderHistory() {
    const history = loadHistory();
    if (!arHistory || !arHistItems) return;
    if (arHistEmpty) arHistEmpty.hidden = history.length > 0;
    if (arHistClear) arHistClear.hidden = history.length === 0;
    if (!history.length) { arHistItems.replaceChildren(); return; }
    // Built node by node, never through innerHTML: title and creator come from
    // archive.org metadata and are foreign input.
    const frag = document.createDocumentFragment();

    for (const x of history as StoredTrack[]) {
      const row = document.createElement('div');
      row.className = 'ar-history-item';

      const titleEl = document.createElement('span');
      titleEl.className = 'ar-history-title';
      titleEl.textContent = x.title;
      titleEl.title = x.artist ? `${x.title} — ${x.artist}` : x.title;

      // Nur das Alter: der Interpret steckt bei Archive.org fast immer schon
      // im Titel und würde die Zeile ein zweites Mal umbrechen.
      const metaEl = document.createElement('span');
      metaEl.className = 'ar-history-meta';
      metaEl.textContent = fmtAgo(x.ts);

      row.addEventListener('click', () => {
        if (x.id) void playTrack({ identifier: x.id, title: x.title, creator: x.artist });
      });

      row.append(titleEl, metaEl);
      frag.appendChild(row);
    }

    arHistItems.replaceChildren(frag);
  }

  // ── Seek bar ──────────────────────────────────────────────────────────────────
  function seekReset() {
    if (arSeekFill)  arSeekFill.style.width = '0%';
    if (arSeekInput) arSeekInput.value = '0';
    if (arCurrent)   arCurrent.textContent  = '0:00';
    if (arDuration)  arDuration.textContent = '—';
  }

  off.add(subscribeTime((currentTime, duration) => {
    if (getState().source !== 'archive') return;
    const pct = duration ? (currentTime / duration) * 100 : 0;
    if (arSeekFill)  arSeekFill.style.width = pct + '%';
    if (arSeekInput) arSeekInput.value = String(pct);
    if (arCurrent)   arCurrent.textContent  = fmtTime(currentTime);
    if (arDuration)  arDuration.textContent = fmtTime(duration);
  }));

  arSeekInput?.addEventListener('input', () => {
    if (getState().source !== 'archive') return;
    seekToPercent(parseFloat(arSeekInput.value));
    if (arSeekFill) arSeekFill.style.width = arSeekInput.value + '%';
  });

  // ── Fetch ─────────────────────────────────────────────────────────────────────
  async function fetchTracks(): Promise<any[]> {
    const queries = GENRE_QUERIES[activeGenre] ?? GENRE_QUERIES['all'];
    const q     = queries[Math.floor(Math.random() * queries.length)];
    const start = Math.floor(Math.random() * 30);
    const url   = `https://archive.org/advancedsearch.php?q=${q}&fl[]=identifier&fl[]=title&fl[]=creator&rows=40&start=${start}&output=json`;
    const resp  = await fetch(url, { signal: AbortSignal.timeout(10000) });
    if (!resp.ok) throw new Error('fetch failed');
    const data = await resp.json();
    return data?.response?.docs ?? [];
  }

  let rpCurrentDoc: ArchiveDoc | null = null;

  /** Icon und Beschriftung sitzen in eigenen Spans — textContent würde beide
      überschreiben und den Knopf auf ein nacktes Zeichen zurückwerfen. */
  function paintBtn(btn: HTMLButtonElement | null, icon: string, label: string) {
    if (!btn) return;
    const i = btn.querySelector('.ar-btn-icon');
    const l = btn.querySelector('.ar-btn-label');
    if (i) i.textContent = icon;
    if (l) l.textContent = label;
  }

  function syncLikeBtn() {
    if (!rpLikeBtn) return;
    const liked = isLiked(rpCurrentId);
    paintBtn(rpLikeBtn, liked ? '♥' : '♡', liked ? 'Liked' : 'Like');
    rpLikeBtn.classList.toggle('liked', liked);
  }

  /** Paint track info without engaging the engine. */
  function previewTrack(doc: ArchiveDoc | null) {
    if (!doc) return;
    rpCurrentDoc = doc;
    rpCurrentId  = doc.identifier ?? '';
    setTrack(doc.title ?? rpCurrentId, doc.creator ?? 'Archive.org');
    if (rpLinkEl) rpLinkEl.href = `https://archive.org/details/${rpCurrentId}`;
    syncLikeBtn();
    seekReset();
  }

  const MAX_SKIPS = 5;
  let failStreak = 0;

  function noteFailure(message: string) {
    failStreak++;
    if (failStreak >= MAX_SKIPS) {
      failStreak = 0;
      setStatus('Nichts abspielbar — tippen für neu');
      return;
    }
    setStatus(message);
    setTimeout(() => void rpNext(), 1200);
  }

  /** Resolve and start a track through the engine. */
  async function playTrack(doc: ArchiveDoc) {
    previewTrack(doc);
    setStatus('Lädt…');
    const res = await playDoc(doc, true);
    if (!res.ok) noteFailure(res.reason === 'no-audio' ? 'Kein Audio — weiter' : 'Nicht verfügbar — weiter');
  }

  // ── Render from engine state ──────────────────────────────────────────────────
  off.add(subscribe((s) => {
    const mine = s.source === 'archive';
    rpPlaying = mine && s.playing;

    paintBtn(rpPlayBtn, rpPlaying ? '❚❚' : '▶', rpPlaying ? 'Pause' : 'Play');
    if (rpPlayBtn) rpPlayBtn.classList.toggle('playing', rpPlaying);

    if (!mine) return;

    const id = s.track.link.split('/details/')[1] ?? '';
    if (id && id !== rpCurrentId) {
      rpCurrentId  = id;
      rpCurrentDoc = { identifier: id, title: s.track.title, creator: s.track.artist };
      seekReset();
    }
    setTrack(s.track.title, s.track.artist);
    if (rpLinkEl && s.track.link) rpLinkEl.href = s.track.link;
    syncLikeBtn();
    setStatus(rpPlaying ? '● spielt' : 'bereit');

    if (rpPlaying) failStreak = 0;
  }));

  registerSourceHandlers('archive', {
    onEnded: () => { failStreak = 0; void rpNext(); },
    onError: () => noteFailure('Fehler — weiter'),
  });

  // ── Init ──────────────────────────────────────────────────────────────────────
  async function rpInit() {
    if (rpLoading) rpLoading.style.display = 'block';
    if (rpMain)    rpMain.style.display    = 'none';
    try {
      const docs = await fetchTracks();
      rpTracks = docs.length ? docs.sort(() => Math.random() - 0.5) : getFallback();
    } catch { rpTracks = getFallback(); }
    rpIdx = 0;
    if (rpLoading) rpLoading.style.display = 'none';
    if (rpMain)    rpMain.style.display    = 'block';

    if (getState().source === 'archive') {
      setStatus(getState().playing ? '● spielt' : 'bereit');
    } else {
      setStatus('bereit');
      previewTrack(rpTracks[0]);
    }
    renderHistory();
  }

  function getFallback(): ArchiveDoc[] {
    return [
      { identifier: 'HumanMusicProject', title: 'Electronic Session',  creator: 'Netlabel' },
      { identifier: 'KSCO-1650',         title: 'Archive Session',     creator: 'Archive.org' },
    ].sort(() => Math.random() - 0.5);
  }

  // ── Toggle ────────────────────────────────────────────────────────────────────
  function rpToggle() {
    if (getState().source === 'archive') {
      playerToggle();
      if (!rpPlaying && rpCurrentId) {
        addToHistory(rpCurrentId, rpTrackEl?.textContent ?? '—', rpArtistEl?.textContent ?? '');
      }
      return;
    }
    if (rpCurrentDoc) void playTrack(rpCurrentDoc);
  }

  // ── Next ──────────────────────────────────────────────────────────────────────
  async function rpNext() {
    if (!rpTracks.length) { rpTracks = getFallback(); rpIdx = -1; }
    rpIdx = (rpIdx + 1) % rpTracks.length;
    if (rpIdx === 0) {
      try { const docs = await fetchTracks(); if (docs.length) rpTracks = docs.sort(() => Math.random() - 0.5); } catch {}
    }
    await playTrack(rpTracks[rpIdx]);
  }

  // ── Like ──────────────────────────────────────────────────────────────────────
  function rpLike() {
    if (!rpCurrentId) return;
    toggleLike(rpCurrentId, rpTrackEl?.textContent ?? '—', rpArtistEl?.textContent ?? '—');
    syncLikeBtn();
  }

  // ── Wire up ───────────────────────────────────────────────────────────────────
  rpPlayBtn?.addEventListener('click', rpToggle);
  rpSkipBtn?.addEventListener('click', () => void rpNext());
  rpLikeBtn?.addEventListener('click', rpLike);
  rpStatus?.addEventListener('click', () => { if (!rpPlaying) void rpInit(); });
  arHistClear?.addEventListener('click', () => clearHistory());
  off.listen(window, HISTORY_CHANGED, renderHistory);

  nextHandler = () => void rpNext();

  void rpInit();

  return off.run;
});
