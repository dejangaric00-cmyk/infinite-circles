---
// src/components/ArchiveRadio.astro
---

<div class="ar-wrap">
  <div class="ar-header">
    <div class="ar-left">
      <span class="ar-dot" id="ar-dot"></span>
      <span class="ar-badge">Archive.org · dub-techno · minimal</span>
    </div>
    <span class="ar-status" id="rp-status">Loading…</span>
  </div>

  <div class="ar-body">
    <div class="ar-loading" id="rp-loading">Searching Archive.org…</div>

    <div id="rp-main" style="display:none">
      <div class="ar-track-block">
        <div class="ar-track" id="rp-track">—</div>
        <div class="ar-artist" id="rp-artist">—</div>
      </div>

      <div class="ar-controls">
        <button class="ar-play-btn" id="rp-play-btn" onclick="rpToggle()">▶</button>
        <button class="ar-skip-btn" onclick="rpNext()">⏭</button>
        <button class="ar-like-btn" id="rp-like-btn" onclick="rpLike()">♡ like</button>
        <div class="ar-wave" id="rp-wave">
          <span class="rpwb"></span><span class="rpwb"></span>
          <span class="rpwb"></span><span class="rpwb"></span>
          <span class="rpwb"></span>
        </div>
      </div>

      <!-- Seekbar + Zeit -->
      <div class="ar-seek-row">
        <span class="ar-time" id="ar-current">0:00</span>
        <div class="ar-seek-wrap">
          <div class="ar-seek-bg">
            <div class="ar-seek-fill" id="ar-seek-fill"></div>
          </div>
          <input
            type="range" id="ar-seek" min="0" max="100" value="0" step="0.1"
            class="ar-seek-input" aria-label="Position"
          >
        </div>
        <span class="ar-time" id="ar-duration">—</span>
      </div>

      <div class="ar-track-info">
        <span>Archive.org</span>&ensp;·&ensp;
        <a class="ar-archive-link" id="rp-link" href="#" target="_blank" rel="noopener">Open original →</a>
      </div>
    </div>
  </div>

  <!-- Liked -->
  <div class="ar-liked-list" id="rp-liked-list">
    <div class="ar-liked-header">♥ Liked</div>
    <div class="ar-liked-items" id="rp-liked-items"></div>
  </div>

  <!-- Zuletzt gespielt -->
  <div class="ar-history-list" id="ar-history-list">
    <div class="ar-history-header">◷ Zuletzt gespielt</div>
    <div class="ar-history-items" id="ar-history-items"></div>
  </div>
</div>

<style>
.ar-wrap {
  border: 0.5px solid var(--border-mid);
  border-radius: 8px;
  overflow: hidden;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.ar-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.55rem 1rem;
  border-bottom: 0.5px solid var(--border-mid);
}
.ar-left { display: flex; align-items: center; gap: 7px; }
.ar-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #00ff87; opacity: 0.4;
  animation: ar-idle 2.5s ease-in-out infinite;
}
.ar-dot.playing {
  opacity: 1;
  animation: ar-pulse 1.8s ease-in-out infinite;
  box-shadow: 0 0 8px #00ff87;
}
@keyframes ar-idle  { 0%,100%{opacity:0.35} 50%{opacity:0.7} }
@keyframes ar-pulse { 0%,100%{opacity:1} 50%{opacity:0.45} }
.ar-badge {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .12em; text-transform: uppercase; color: var(--text-dim);
}
#rp-status {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .06em; color: var(--text-dim);
}
.ar-body { padding: 0.85rem 1rem 0.7rem; }
.ar-loading {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .06em; color: var(--text-dim); padding: 0.25rem 0;
}
.ar-track-block { margin-bottom: 0.85rem; }
.ar-track {
  font-family: var(--font-serif); font-size: 18px;
  font-weight: 300; font-style: italic;
  color: var(--text-deep); line-height: 1.25; margin-bottom: 3px;
}
.ar-artist {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .06em; color: var(--text-dim);
}
.ar-controls {
  display: flex; align-items: center; gap: 0.6rem;
  margin-bottom: 0.85rem;
}
.ar-play-btn {
  all: unset; cursor: pointer;
  width: 32px; height: 32px; border-radius: 50%;
  background: #00ff87;
  display: flex; align-items: center; justify-content: center;
  color: #000; font-size: 12px; font-family: var(--font-mono);
  flex-shrink: 0;
  transition: transform 0.15s, box-shadow 0.15s;
}
.ar-play-btn:hover { transform: scale(1.07); box-shadow: 0 0 14px rgba(0,255,135,0.45); }
.ar-skip-btn {
  all: unset; cursor: pointer;
  width: 28px; height: 28px; border-radius: 50%;
  border: 0.5px solid var(--border-mid);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim); font-size: 12px; font-family: var(--font-mono);
  flex-shrink: 0;
  transition: border-color 0.15s, color 0.15s;
}
.ar-skip-btn:hover { border-color: #00ff87; color: var(--text-deep); }
.ar-like-btn {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .06em;
  color: var(--text-dim); padding: 4px 10px;
  border: 0.5px solid var(--border-mid); border-radius: 20px;
  transition: color 0.15s, border-color 0.15s;
}
.ar-like-btn:hover { color: #ff6ef7; border-color: #ff6ef7; }
.ar-like-btn.liked { color: #ff6ef7; border-color: #ff6ef7; }
.ar-wave {
  display: flex; align-items: flex-end; gap: 2.5px;
  height: 20px; margin-left: 4px;
}
.rpwb {
  display: block; width: 2.5px; background: #00ff87;
  border-radius: 1px; height: 4px; opacity: 0.25;
}
.rpwb.active {
  opacity: 0.75;
  animation: ar-bar 1s ease-in-out infinite;
}
.rpwb:nth-child(1){animation-delay:0s;height:6px}
.rpwb:nth-child(2){animation-delay:.12s;height:12px}
.rpwb:nth-child(3){animation-delay:.24s;height:8px}
.rpwb:nth-child(4){animation-delay:.08s;height:15px}
.rpwb:nth-child(5){animation-delay:.18s;height:10px}
@keyframes ar-bar { 0%,100%{transform:scaleY(0.3);opacity:0.4} 50%{transform:scaleY(1);opacity:0.9} }

/* ── Seekbar ── */
.ar-seek-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.75rem;
}
.ar-time {
  font-family: var(--font-mono);
  font-size: 8.5px;
  letter-spacing: .04em;
  color: var(--text-dim);
  flex-shrink: 0;
  min-width: 28px;
}
.ar-time:last-child { text-align: right; }
.ar-seek-wrap {
  flex: 1;
  position: relative;
  height: 16px;
  display: flex;
  align-items: center;
  cursor: pointer;
}
.ar-seek-bg {
  position: absolute;
  left: 0; right: 0;
  height: 2px;
  background: var(--border-mid);
  border-radius: 2px;
  overflow: hidden;
  pointer-events: none;
}
.ar-seek-fill {
  height: 100%;
  background: #00ff87;
  border-radius: 2px;
  width: 0%;
  transition: width 0.25s linear;
}
.ar-seek-input {
  position: absolute;
  left: 0; right: 0;
  width: 100%;
  height: 16px;
  opacity: 0;
  cursor: pointer;
  margin: 0;
  padding: 0;
  -webkit-appearance: none;
  appearance: none;
}

.ar-track-info {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-dim); letter-spacing: .04em;
  padding-top: 0.6rem;
  border-top: 0.5px solid var(--border-mid);
}
.ar-archive-link { color: var(--accent); text-decoration: none; }
.ar-archive-link:hover { text-decoration: underline; }

/* ── Liked ── */
.ar-liked-list {
  display: none;
  border-top: 0.5px solid var(--border-mid);
  padding: 0.7rem 1rem;
}
.ar-liked-list.has-items { display: block; }
.ar-liked-header {
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .14em;
  text-transform: uppercase; color: #ff6ef7; opacity: 0.8; margin-bottom: 0.5rem;
}
.ar-liked-items { display: flex; flex-direction: column; gap: 3px; max-height: 90px; overflow-y: auto; }

/* ── History ── */
.ar-history-list {
  display: none;
  border-top: 0.5px solid var(--border-mid);
  padding: 0.7rem 1rem;
}
.ar-history-list.has-items { display: block; }
.ar-history-header {
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--accent2); opacity: 0.7; margin-bottom: 0.5rem;
}
.ar-history-items { display: flex; flex-direction: column; gap: 3px; max-height: 110px; overflow-y: auto; }

.ar-liked-item, .ar-history-item {
  font-family: var(--font-mono); font-size: 9px; color: var(--text-dim);
  padding: 3px 8px; background: var(--glass-bg);
  border-radius: 4px; border: 0.5px solid var(--border-mid); line-height: 1.5;
  display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem;
}
.ar-item-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ar-item-time { flex-shrink: 0; opacity: 0.5; font-size: 8px; }
</style>

<script>
const RP_SK  = 'ic_rp_liked_v1';
const HX_SK  = 'ic_rp_history_v1';
let rpTracks: any[] = [], rpIdx = 0, rpAudio: HTMLAudioElement | null = null;
let rpPlaying = false, rpCurrentId = '';

// ── Helpers ──────────────────────────────────────────────────────
function rpLoadLiked()   { try { return JSON.parse(localStorage.getItem(RP_SK)  || '[]'); } catch { return []; } }
function rpSaveLiked(a: any[])   { localStorage.setItem(RP_SK,  JSON.stringify(a)); }
function rpLoadHistory() { try { return JSON.parse(localStorage.getItem(HX_SK) || '[]'); } catch { return []; } }
function rpSaveHistory(a: any[]) { localStorage.setItem(HX_SK, JSON.stringify(a)); }

function rpSetStatus(s: string) {
  const el = document.getElementById('rp-status'); if (el) el.textContent = s;
}
function rpSetTrack(t: string, a: string) {
  const te = document.getElementById('rp-track'), ae = document.getElementById('rp-artist');
  if (te) te.textContent = t; if (ae) ae.textContent = a;
}

function fmtTime(sec: number): string {
  if (!isFinite(sec) || isNaN(sec)) return '—';
  const m = Math.floor(sec / 60), s = Math.floor(sec % 60);
  return `${m}:${s.toString().padStart(2, '0')}`;
}

// ── Seek bar ─────────────────────────────────────────────────────
function seekUpdate() {
  if (!rpAudio) return;
  const pct = rpAudio.duration ? (rpAudio.currentTime / rpAudio.duration) * 100 : 0;
  const fill = document.getElementById('ar-seek-fill') as HTMLElement | null;
  const inp   = document.getElementById('ar-seek')      as HTMLInputElement | null;
  const cur   = document.getElementById('ar-current')   as HTMLElement | null;
  const dur   = document.getElementById('ar-duration')  as HTMLElement | null;
  if (fill) fill.style.width = pct + '%';
  if (inp)  inp.value = String(pct);
  if (cur)  cur.textContent = fmtTime(rpAudio.currentTime);
  if (dur)  dur.textContent = fmtTime(rpAudio.duration);
}

function seekReset() {
  const fill = document.getElementById('ar-seek-fill') as HTMLElement | null;
  const inp   = document.getElementById('ar-seek')      as HTMLInputElement | null;
  const cur   = document.getElementById('ar-current')   as HTMLElement | null;
  const dur   = document.getElementById('ar-duration')  as HTMLElement | null;
  if (fill) fill.style.width = '0%';
  if (inp)  inp.value = '0';
  if (cur)  cur.textContent = '0:00';
  if (dur)  dur.textContent = '—';
}

document.getElementById('ar-seek')?.addEventListener('input', (e) => {
  if (!rpAudio || !rpAudio.duration) return;
  const pct = parseFloat((e.target as HTMLInputElement).value);
  rpAudio.currentTime = (pct / 100) * rpAudio.duration;
  const fill = document.getElementById('ar-seek-fill') as HTMLElement | null;
  if (fill) fill.style.width = pct + '%';
});

// ── Fetch ─────────────────────────────────────────────────────────
async function rpFetchTracks() {
  rpSetStatus('Searching…');
  const queries = [
    'collection:etree+subject:(techno)+mediatype:audio',
    'collection:etree+subject:(electronic)+mediatype:audio',
    'licenseurl:*creativecommons*+subject:(dub+techno)+mediatype:audio',
    'licenseurl:*creativecommons*+subject:(minimal)+mediatype:audio',
    'licenseurl:*creativecommons*+subject:(house)+mediatype:audio',
    'collection:netlabels+subject:(techno)+mediatype:audio',
    'collection:netlabels+subject:(electronic)+mediatype:audio',
  ];
  const q = queries[Math.floor(Math.random() * queries.length)];
  const cbName = '_rpCb_' + Date.now() + '_' + Math.floor(Math.random() * 9999);
  const url = `https://archive.org/advancedsearch.php?q=${q}&fl[]=identifier&fl[]=title&fl[]=creator&rows=40&start=${Math.floor(Math.random() * 20)}&output=json&callback=${cbName}`;
  return new Promise<any[]>((resolve, reject) => {
    (window as any)[cbName] = (data: any) => { delete (window as any)[cbName]; resolve(data?.response?.docs || []); };
    const s = document.createElement('script');
    s.src = url; s.onerror = () => { delete (window as any)[cbName]; reject(); };
    document.head.appendChild(s);
    setTimeout(() => { delete (window as any)[cbName]; reject(); }, 10000);
  });
}

async function rpGetFiles(identifier: string) {
  const url = `https://cors.archive.org/metadata/${identifier}`;
  const resp = await fetch(url);
  const data = await resp.json();
  return (data?.files || []).filter((f: any) => f.name && /\.(mp3|ogg|flac)$/i.test(f.name));
}

function rpFallbackTracks() {
  return [
    { identifier: 'OTTO2023',       title: 'Electronic Session',  creator: 'Netlabel' },
    { identifier: 'netlabel-001',   title: 'Netlabel Electronic', creator: 'Various'  },
  ].sort(() => Math.random() - 0.5);
}

// ── Load / Play ──────────────────────────────────────────────────
async function rpInit() {
  document.getElementById('rp-loading')!.style.display = 'block';
  document.getElementById('rp-main')!.style.display = 'none';
  try {
    const docs = await rpFetchTracks();
    if (!docs.length) throw new Error('empty');
    rpTracks = docs.sort(() => Math.random() - 0.5);
  } catch { rpTracks = rpFallbackTracks(); }
  rpIdx = 0;
  document.getElementById('rp-loading')!.style.display = 'none';
  document.getElementById('rp-main')!.style.display = 'block';
  rpSetStatus('Ready');
  await rpLoadTrack(rpTracks[0]);
  rpUpdateLikedList();
  rpUpdateHistoryList();
}

async function rpLoadTrack(doc: any) {
  if (!doc) return;
  rpCurrentId = doc.identifier || '';
  const title  = doc.title   || doc.identifier || 'Unknown';
  const artist = doc.creator || 'Archive.org';
  rpSetTrack(title.length > 60 ? title.slice(0, 60) + '…' : title, artist);
  const link = document.getElementById('rp-link') as HTMLAnchorElement | null;
  if (link) link.href = 'https://archive.org/details/' + rpCurrentId;
  const liked = rpLoadLiked(), isLiked = liked.some((x: any) => x.id === rpCurrentId);
  const lb = document.getElementById('rp-like-btn');
  if (lb) { lb.textContent = isLiked ? '♥ liked' : '♡ like'; lb.className = 'ar-like-btn' + (isLiked ? ' liked' : ''); }
  seekReset();
  try {
    const files = await rpGetFiles(doc.identifier);
    if (files.length) {
      const f = files[Math.floor(Math.random() * Math.min(3, files.length))];
      rpSetAudio('https://cors.archive.org/download/' + doc.identifier + '/' + encodeURIComponent(f.name));
      rpSetStatus('● Ready');
    } else { rpSetStatus('No audio — skip'); }
  } catch { rpSetStatus('Unavailable — skip'); }
}

function rpSetAudio(src: string) {
  if (rpAudio) { rpAudio.pause(); rpAudio = null; rpPlaying = false; }
  rpAudio = new Audio(src);
  rpAudio.ontimeupdate = seekUpdate;
  rpAudio.onloadedmetadata = seekUpdate;
  rpAudio.onended = () => rpNext();
  rpAudio.onerror = () => { rpSetStatus('Error — skipping'); setTimeout(rpNext, 1500); };
  document.querySelectorAll('.rpwb').forEach(b => b.classList.remove('active'));
  const pb = document.getElementById('rp-play-btn'); if (pb) pb.textContent = '▶';
  const dot = document.getElementById('ar-dot'); if (dot) dot.classList.remove('playing');
}

function rpSetPlaying(playing: boolean) {
  rpPlaying = playing;
  const pb  = document.getElementById('rp-play-btn');
  const dot = document.getElementById('ar-dot');
  if (pb)  pb.textContent = playing ? '❚❚' : '▶';
  document.querySelectorAll('.rpwb').forEach(b => b.classList.toggle('active', playing));
  if (dot) dot.classList.toggle('playing', playing);
  rpSetStatus(playing ? '● Playing' : 'Ready');

  // History: beim ersten Start eines Tracks eintragen
  if (playing) rpAddToHistory();
}

function rpToggle() {
  if (!rpAudio) return;
  if (rpPlaying) { rpAudio.pause(); rpSetPlaying(false); }
  else { rpAudio.play().then(() => rpSetPlaying(true)).catch(() => rpSetStatus('Click play')); }
}

async function rpNext() {
  if (rpAudio) { rpAudio.pause(); rpAudio = null; }
  rpSetPlaying(false);
  rpIdx = (rpIdx + 1) % rpTracks.length;
  if (rpIdx === 0) {
    try { const docs = await rpFetchTracks(); if (docs.length) rpTracks = docs.sort(() => Math.random() - 0.5); } catch {}
  }
  await rpLoadTrack(rpTracks[rpIdx]);
  if (rpAudio) rpAudio.play().then(() => rpSetPlaying(true)).catch(() => {});
}

// ── Like ─────────────────────────────────────────────────────────
function rpLike() {
  if (!rpCurrentId) return;
  const liked = rpLoadLiked(), i = liked.findIndex((x: any) => x.id === rpCurrentId);
  const t = document.getElementById('rp-track')?.textContent  || '—';
  const a = document.getElementById('rp-artist')?.textContent || '—';
  const lb = document.getElementById('rp-like-btn');
  if (i >= 0) { liked.splice(i, 1); if (lb) { lb.textContent = '♡ like'; lb.className = 'ar-like-btn'; } }
  else { liked.unshift({ id: rpCurrentId, title: t, artist: a, ts: Date.now() }); if (lb) { lb.textContent = '♥ liked'; lb.className = 'ar-like-btn liked'; } }
  rpSaveLiked(liked); rpUpdateLikedList();
}

function rpUpdateLikedList() {
  const liked = rpLoadLiked();
  const list  = document.getElementById('rp-liked-list');
  const items = document.getElementById('rp-liked-items');
  if (!list || !items) return;
  if (liked.length) {
    list.classList.add('has-items');
    items.innerHTML = liked.map((x: any) =>
      `<div class="ar-liked-item"><span class="ar-item-title">♥ ${x.title.length > 42 ? x.title.slice(0,42)+'…' : x.title}</span><span class="ar-item-time">${x.artist}</span></div>`
    ).join('');
  } else { list.classList.remove('has-items'); }
}

// ── History ──────────────────────────────────────────────────────
function rpAddToHistory() {
  const title  = document.getElementById('rp-track')?.textContent  || '—';
  const artist = document.getElementById('rp-artist')?.textContent || '—';
  if (!rpCurrentId || title === '—') return;
  const history = rpLoadHistory();
  // Nicht doppelt eintragen wenn gleicher Track
  if (history.length && history[0].id === rpCurrentId) return;
  history.unshift({ id: rpCurrentId, title, artist, ts: Date.now() });
  if (history.length > 20) history.pop();
  rpSaveHistory(history);
  rpUpdateHistoryList();
}

function rpUpdateHistoryList() {
  const history = rpLoadHistory();
  const list    = document.getElementById('ar-history-list');
  const items   = document.getElementById('ar-history-items');
  if (!list || !items) return;
  if (history.length) {
    list.classList.add('has-items');
    items.innerHTML = history.map((x: any) => {
      const ago = fmtAgo(x.ts);
      return `<div class="ar-history-item"><span class="ar-item-title">◷ ${x.title.length > 40 ? x.title.slice(0,40)+'…' : x.title}</span><span class="ar-item-time">${ago}</span></div>`;
    }).join('');
  } else { list.classList.remove('has-items'); }
}

function fmtAgo(ts: number): string {
  const diff = Math.floor((Date.now() - ts) / 60000);
  if (diff < 1)  return 'jetzt';
  if (diff < 60) return `vor ${diff}min`;
  const h = Math.floor(diff / 60);
  if (h < 24)    return `vor ${h}h`;
  return `vor ${Math.floor(h/24)}d`;
}

// Expose globals für onclick
(window as any).rpToggle = rpToggle;
(window as any).rpNext   = rpNext;
(window as any).rpLike   = rpLike;

rpInit();
</script>
