---
// src/components/ArchiveRadio.astro
---

<div class="ar-wrap glass-surface">
  <div class="ar-header">
    <div class="ar-left">
      <span class="ar-badge-row">
        <span class="ar-dot" id="ar-dot"></span>
        <span class="ar-badge" id="ar-badge">archive.org · netlabels</span>
      </span>
    </div>
    <span class="ar-status" id="rp-status">· Feeds</span>
  </div>

  <!-- ── Genre Filter ── -->
  <div class="ar-genres" id="ar-genres">
    <button class="ar-genre-btn active" data-genre="all">all</button>
    <button class="ar-genre-btn" data-genre="dub-techno">dub techno</button>
    <button class="ar-genre-btn" data-genre="minimal">minimal</button>
    <button class="ar-genre-btn" data-genre="deep-house">deep house</button>
    <button class="ar-genre-btn" data-genre="ambient">ambient</button>
    <button class="ar-genre-btn" data-genre="electro">electro</button>
    <button class="ar-genre-btn" data-genre="netlabels">netlabels</button>
    <button class="ar-genre-btn" data-genre="drone">drone</button>
    <button class="ar-genre-btn" data-genre="dark-ambient">dark ambient</button>
    <button class="ar-genre-btn" data-genre="industrial">industrial</button>
    <button class="ar-genre-btn" data-genre="idm">IDM</button>
    <button class="ar-genre-btn" data-genre="breakbeat">breakbeat</button>
    <button class="ar-genre-btn" data-genre="downtempo">downtempo</button>
    <button class="ar-genre-btn" data-genre="experimental">experimental</button>
    <button class="ar-genre-btn" data-genre="noise">noise</button>
    <button class="ar-genre-btn" data-genre="jungle">jungle</button>
    <button class="ar-genre-btn" data-genre="acid">acid</button>
    <button class="ar-genre-btn" data-genre="detroit">detroit techno</button>
    <button class="ar-genre-btn" data-genre="field-recordings">field recordings</button>
  </div>

  <div class="ar-body">
    <div class="ar-loading" id="rp-loading">Searching Archive.org…</div>

    <div id="rp-main" style="display:none">
      <div class="ar-track-block">
        <div class="ar-track" id="rp-track">—</div>
        <div class="ar-artist" id="rp-artist">—</div>
      </div>

      <div class="ar-controls">
        <button class="ar-play-btn" id="rp-play-btn">▶</button>
        <button class="ar-skip-btn" id="rp-skip-btn">⏭</button>
        <button class="ar-like-btn" id="rp-like-btn">♡ like</button>
        <div class="ar-wave" id="rp-wave">
          <span class="rpwb"></span><span class="rpwb"></span>
          <span class="rpwb"></span><span class="rpwb"></span>
          <span class="rpwb"></span>
        </div>
      </div>

      <div class="ar-seek-row">
        <span class="ar-time" id="ar-current">0:00</span>
        <div class="ar-seek-wrap">
          <div class="ar-seek-bg">
            <div class="ar-seek-fill" id="ar-seek-fill"></div>
          </div>
          <input type="range" id="ar-seek" min="0" max="100" value="0" step="0.1"
            class="ar-seek-input" aria-label="Position">
        </div>
        <span class="ar-time" id="ar-duration">—</span>
      </div>

      <div class="ar-track-info">
        <span>Archive.org</span>&ensp;·&ensp;
        <a class="ar-archive-link" id="rp-link" href="#" target="_blank" rel="noopener">Open original →</a>
      </div>
    </div>
  </div>

  <!-- ── Song History ── -->
  <div class="ar-history" id="ar-history" style="display:none">
    <div class="ar-history-header">
      <span class="ar-history-label">◷ Zuletzt gespielt</span>
      <button class="ar-history-clear" id="ar-history-clear">clear</button>
    </div>
    <div class="ar-history-items" id="ar-history-items"></div>
  </div>
</div>

<style>
.ar-wrap {
  overflow: hidden;
  --ar-green: #00ff87;
  --sep: 0.5px solid var(--glass-sep);
}
.ar-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.7rem 1.1rem 0.6rem;
}
.ar-left { display: flex; align-items: center; }
.ar-badge-row { display: flex; align-items: center; gap: 8px; }
.ar-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--ar-green); opacity: 0.35;
  transition: opacity 0.3s var(--ease-ios), box-shadow 0.3s var(--ease-ios);
}
.ar-dot.playing {
  opacity: 1;
  animation: ar-pulse 2.4s ease-in-out infinite;
  box-shadow: 0 0 0 3px rgba(0,255,135,0.18), 0 0 10px rgba(0,255,135,0.5);
}
@keyframes ar-pulse { 0%,100%{opacity:1} 50%{opacity:0.45} }
.ar-badge {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .12em; text-transform: uppercase; color: var(--text-dim);
}
#rp-status {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .06em; color: var(--text-dim);
  cursor: pointer; transition: color 0.2s var(--ease-ios);
}
#rp-status:hover { color: var(--text-deep); }

/* ── Genre-Filter ── */
.ar-genres {
  display: flex; flex-wrap: wrap; gap: 5px;
  padding: 0.35rem 1.1rem 0.8rem;
}
.ar-genre-btn {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .08em;
  color: var(--text-mid);
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
  background: var(--glass-ctrl);
  box-shadow:
    inset 0 0.5px 0 var(--glass-hairline),
    inset 0 0 0 0.5px var(--glass-border-dim);
  transition:
    color 0.28s var(--ease-ios),
    background 0.28s var(--ease-ios),
    box-shadow 0.28s var(--ease-ios),
    transform 0.18s var(--ease-ios);
}
.ar-genre-btn:hover { color: var(--text-deep); background: var(--glass-ctrl-hover); }
.ar-genre-btn:active { transform: scale(0.94); }
.ar-genre-btn:focus-visible { outline: 2px solid var(--ar-green); outline-offset: 2px; }
.ar-genre-btn.active {
  color: var(--ar-green);
  background: rgba(0,255,135,0.10);
  box-shadow:
    inset 0 0.5px 0 var(--glass-hairline),
    inset 0 0 0 0.5px rgba(0,255,135,0.4),
    0 2px 10px rgba(0,255,135,0.16);
}

.ar-body { padding: 0.95rem 1.1rem 0.8rem; border-top: var(--sep); }
.ar-loading {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .06em; color: var(--text-dim); padding: 0.25rem 0;
}
.ar-track-block { margin-bottom: 0.9rem; }
.ar-track {
  font-family: var(--font-serif); font-size: 19px;
  font-weight: 300; font-style: italic;
  color: var(--text-deep); line-height: 1.25; margin-bottom: 3px;
  letter-spacing: -0.01em;
}
.ar-artist {
  font-family: var(--font-mono); font-size: 9px;
  letter-spacing: .06em; color: var(--text-mid);
}
.ar-controls {
  display: flex; align-items: center; gap: 0.55rem;
  margin-bottom: 0.9rem;
}
.ar-play-btn {
  all: unset; cursor: pointer;
  width: 38px; height: 38px; border-radius: 50%;
  background: linear-gradient(180deg, #4dffab 0%, var(--ar-green) 55%, #00d971 100%);
  display: flex; align-items: center; justify-content: center;
  color: #04231a; font-size: 12px; font-family: var(--font-mono);
  flex-shrink: 0;
  box-shadow:
    inset 0 0.5px 0 rgba(255,255,255,0.65),
    0 1px 2px rgba(0,0,0,0.18),
    0 4px 16px rgba(0,255,135,0.30);
  transition: transform 0.2s var(--ease-ios), box-shadow 0.28s var(--ease-ios);
}
.ar-play-btn:hover {
  transform: scale(1.06);
  box-shadow:
    inset 0 0.5px 0 rgba(255,255,255,0.65),
    0 2px 4px rgba(0,0,0,0.18),
    0 6px 24px rgba(0,255,135,0.45);
}
.ar-play-btn:active { transform: scale(0.94); }
.ar-play-btn:focus-visible { outline: 2px solid var(--ar-green); outline-offset: 3px; }
.ar-skip-btn {
  all: unset; cursor: pointer;
  width: 32px; height: 32px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-mid); font-size: 12px;
  flex-shrink: 0;
  background: var(--glass-ctrl);
  box-shadow:
    inset 0 0.5px 0 var(--glass-hairline),
    inset 0 0 0 0.5px var(--glass-border-dim);
  transition:
    background 0.28s var(--ease-ios), color 0.28s var(--ease-ios),
    transform 0.18s var(--ease-ios);
}
.ar-skip-btn:hover { background: var(--glass-ctrl-hover); color: var(--text-deep); }
.ar-skip-btn:active { transform: scale(0.9); }
.ar-skip-btn:focus-visible { outline: 2px solid var(--ar-green); outline-offset: 2px; }
.ar-like-btn {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .06em;
  color: var(--text-mid); padding: 6px 12px;
  border-radius: 999px;
  background: var(--glass-ctrl);
  box-shadow:
    inset 0 0.5px 0 var(--glass-hairline),
    inset 0 0 0 0.5px var(--glass-border-dim);
  transition:
    color 0.28s var(--ease-ios), background 0.28s var(--ease-ios),
    box-shadow 0.28s var(--ease-ios), transform 0.18s var(--ease-ios);
}
.ar-like-btn:hover { color: #ff6ef7; background: var(--glass-ctrl-hover); }
.ar-like-btn:active { transform: scale(0.94); }
.ar-like-btn:focus-visible { outline: 2px solid #ff6ef7; outline-offset: 2px; }
.ar-like-btn.liked {
  color: #ff6ef7;
  background: rgba(255,110,247,0.10);
  box-shadow:
    inset 0 0.5px 0 var(--glass-hairline),
    inset 0 0 0 0.5px rgba(255,110,247,0.4),
    0 2px 10px rgba(255,110,247,0.16);
}
.ar-wave {
  display: flex; align-items: flex-end; gap: 3px;
  height: 20px; margin-left: 6px;
}
.rpwb {
  display: block; width: 3px; background: var(--ar-green);
  border-radius: 999px; height: 4px; opacity: 0.25;
}
.rpwb.active { opacity: 0.75; animation: ar-bar 1s ease-in-out infinite; }
.rpwb:nth-child(1){animation-delay:0s;height:6px}
.rpwb:nth-child(2){animation-delay:.12s;height:12px}
.rpwb:nth-child(3){animation-delay:.24s;height:8px}
.rpwb:nth-child(4){animation-delay:.08s;height:15px}
.rpwb:nth-child(5){animation-delay:.18s;height:10px}
@keyframes ar-bar { 0%,100%{transform:scaleY(0.3);opacity:0.4} 50%{transform:scaleY(1);opacity:0.9} }

.ar-seek-row {
  display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.8rem;
}
.ar-time {
  font-family: var(--font-mono); font-size: 8.5px;
  letter-spacing: .04em; color: var(--text-dim);
  flex-shrink: 0; min-width: 28px; font-variant-numeric: tabular-nums;
}
.ar-time:last-child { text-align: right; }
.ar-seek-wrap {
  flex: 1; position: relative; height: 18px;
  display: flex; align-items: center; cursor: pointer;
}
.ar-seek-bg {
  position: absolute; left: 0; right: 0; height: 4px;
  background: var(--glass-sep); border-radius: 999px; overflow: hidden;
  pointer-events: none;
  box-shadow: inset 0 0 0 0.5px var(--glass-border-dim);
  transition: height 0.25s var(--ease-ios);
}
.ar-seek-wrap:hover .ar-seek-bg { height: 7px; }
.ar-seek-fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, rgba(0,255,135,0.75), var(--ar-green));
  width: 0%; transition: width 0.25s linear;
}
.ar-seek-input {
  position: absolute; left: 0; right: 0; width: 100%; height: 18px;
  opacity: 0; cursor: pointer; margin: 0; padding: 0;
  -webkit-appearance: none; appearance: none;
}
.ar-seek-input:focus-visible + .ar-seek-bg,
.ar-seek-wrap:focus-within .ar-seek-bg { outline: 2px solid var(--ar-green); outline-offset: 3px; }
.ar-track-info {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-dim); letter-spacing: .04em;
  padding-top: 0.7rem;
  border-top: var(--sep);
}
.ar-archive-link { color: var(--accent); text-decoration: none; }
.ar-archive-link:hover { text-decoration: underline; }

/* ── Song History ── */
.ar-history {
  border-top: var(--sep);
  padding: 0.7rem 1.1rem 0.85rem;
}
.ar-history-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 0.5rem;
}
.ar-history-label {
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--text-dim); opacity: 0.6;
}
.ar-history-clear {
  all: unset; cursor: pointer;
  font-family: var(--font-mono); font-size: 8px;
  letter-spacing: .08em; color: var(--text-dim);
  opacity: 0.4; transition: opacity 0.15s;
}
.ar-history-clear:hover { opacity: 0.9; }
.ar-history-items {
  display: flex; flex-direction: column; gap: 2px;
  max-height: 120px; overflow-y: auto;
}
.ar-history-item {
  display: flex; align-items: baseline;
  justify-content: space-between; gap: 0.75rem;
  padding: 0.35rem 0.5rem;
  margin: 0 -0.5rem;
  border-radius: var(--r-ctrl);
  cursor: pointer;
  background: transparent;
  transition: background 0.28s var(--ease-ios), transform 0.18s var(--ease-ios);
}
.ar-history-item:hover { background: var(--glass-ctrl); }
.ar-history-item:active { transform: scale(0.985); }
.ar-history-title {
  font-family: var(--font-mono); font-size: 9px;
  color: var(--text-deep); overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; flex: 1;
}
.ar-history-meta {
  font-family: var(--font-mono); font-size: 8px;
  color: var(--text-dim); flex-shrink: 0; opacity: 0.6;
  white-space: nowrap;
}
</style>

<script>
const RP_SK = 'ic_rp_liked_v2';
const HX_SK = 'ic_rp_history_v2';

// ── Genre → query map ─────────────────────────────────────────────────────────
const GENRE_QUERIES: Record<string, string[]> = {
  'all': [
    'subject:(dub+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(minimal+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(deep+house)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(ambient)+mediatype:audio+collection:netlabels',
    'subject:(electro)+mediatype:audio+collection:netlabels',
    'subject:(IDM)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(drone)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(downtempo)+mediatype:audio+collection:netlabels',
  ],
  'dub-techno': [
    'subject:(dub+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(dub+techno)+mediatype:audio+collection:netlabels',
    'subject:(dub)+subject:(techno)+mediatype:audio',
  ],
  'minimal': [
    'subject:(minimal+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(minimal)+mediatype:audio+collection:netlabels',
    'subject:(minimal+house)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'deep-house': [
    'subject:(deep+house)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(deep+house)+mediatype:audio+collection:netlabels',
    'subject:(house)+subject:(deep)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'ambient': [
    'subject:(ambient)+mediatype:audio+collection:netlabels',
    'subject:(ambient)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(ambient+electronic)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'electro': [
    'subject:(electro)+mediatype:audio+collection:netlabels',
    'subject:(electro)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(electronica)+mediatype:audio+collection:netlabels',
  ],
  'netlabels': [
    'mediatype:audio+collection:netlabels',
    'subject:(electronic)+mediatype:audio+collection:netlabels',
    'subject:(dance)+mediatype:audio+collection:netlabels',
  ],
  'drone': [
    'subject:(drone)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(drone+music)+mediatype:audio',
    'subject:(drone+ambient)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'dark-ambient': [
    'subject:(dark+ambient)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(dark+ambient)+mediatype:audio+collection:netlabels',
    'subject:(dark+electronic)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'industrial': [
    'subject:(industrial)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(industrial)+mediatype:audio+collection:netlabels',
    'subject:(post-industrial)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'idm': [
    'subject:(IDM)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(intelligent+dance+music)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(IDM)+mediatype:audio+collection:netlabels',
  ],
  'breakbeat': [
    'subject:(breakbeat)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(breaks)+mediatype:audio+collection:netlabels',
    'subject:(breakbeat)+mediatype:audio+collection:netlabels',
  ],
  'downtempo': [
    'subject:(downtempo)+mediatype:audio+collection:netlabels',
    'subject:(downtempo)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(trip-hop)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'experimental': [
    'subject:(experimental)+mediatype:audio+collection:netlabels',
    'subject:(experimental+electronic)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(avant-garde)+mediatype:audio+licenseurl:*creativecommons*',
  ],
  'noise': [
    'subject:(noise)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(harsh+noise)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(noise+music)+mediatype:audio+collection:netlabels',
  ],
  'jungle': [
    'subject:(jungle)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(drum+and+bass)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(jungle)+mediatype:audio+collection:netlabels',
  ],
  'acid': [
    'subject:(acid+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(acid+house)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(acid)+mediatype:audio+collection:netlabels',
  ],
  'detroit': [
    'subject:(detroit+techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(detroit)+subject:(techno)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(techno)+mediatype:audio+collection:netlabels',
  ],
  'field-recordings': [
    'subject:(field+recordings)+mediatype:audio+licenseurl:*creativecommons*',
    'subject:(field+recording)+mediatype:audio',
    'subject:(soundscape)+mediatype:audio+licenseurl:*creativecommons*',
  ],
};

const GENRE_LABELS: Record<string, string> = {
  'all':              'archive.org · netlabels',
  'dub-techno':       'archive.org · dub techno',
  'minimal':          'archive.org · minimal',
  'deep-house':       'archive.org · deep house',
  'ambient':          'archive.org · ambient',
  'electro':          'archive.org · electro',
  'netlabels':        'archive.org · netlabels',
  'drone':            'archive.org · drone',
  'dark-ambient':     'archive.org · dark ambient',
  'industrial':       'archive.org · industrial',
  'idm':              'archive.org · IDM',
  'breakbeat':        'archive.org · breakbeat',
  'downtempo':        'archive.org · downtempo',
  'experimental':     'archive.org · experimental',
  'noise':            'archive.org · noise',
  'jungle':           'archive.org · jungle',
  'acid':             'archive.org · acid',
  'detroit':          'archive.org · detroit techno',
  'field-recordings': 'archive.org · field recordings',
};

let activeGenre = 'all';

let rpTracks: any[] = [];
let rpIdx = 0;
let rpAudio: HTMLAudioElement | null = null;
let rpPlaying = false;
let rpCurrentId = '';

const $ = (id: string) => document.getElementById(id);
const rpPlayBtn   = $('rp-play-btn')   as HTMLButtonElement;
const rpSkipBtn   = $('rp-skip-btn')   as HTMLButtonElement;
const rpLikeBtn   = $('rp-like-btn')   as HTMLButtonElement;
const rpDot       = $('ar-dot')        as HTMLElement;
const rpStatus    = $('rp-status')     as HTMLElement;
const rpTrackEl   = $('rp-track')      as HTMLElement;
const rpArtistEl  = $('rp-artist')     as HTMLElement;
const rpLinkEl    = $('rp-link')       as HTMLAnchorElement;
const rpLoading   = $('rp-loading')    as HTMLElement;
const rpMain      = $('rp-main')       as HTMLElement;
const arCurrent   = $('ar-current')    as HTMLElement;
const arDuration  = $('ar-duration')   as HTMLElement;
const arSeekFill  = $('ar-seek-fill')  as HTMLElement;
const arSeekInput = $('ar-seek')       as HTMLInputElement;
const arHistory   = $('ar-history')    as HTMLElement;
const arHistItems = $('ar-history-items') as HTMLElement;
const arHistClear = $('ar-history-clear') as HTMLButtonElement;
const arBadge     = $('ar-badge')      as HTMLElement;
const genreBtns   = document.querySelectorAll<HTMLButtonElement>('.ar-genre-btn');

// ── Storage ──────────────────────────────────────────────────────────────────
function loadLiked(): any[]   { try { return JSON.parse(localStorage.getItem(RP_SK) || '[]'); } catch { return []; } }
function saveLiked(a: any[])  { localStorage.setItem(RP_SK, JSON.stringify(a)); }
function loadHistory(): any[] { try { return JSON.parse(localStorage.getItem(HX_SK) || '[]'); } catch { return []; } }
function saveHistory(a: any[]){ localStorage.setItem(HX_SK, JSON.stringify(a)); }

// ── Utilities ─────────────────────────────────────────────────────────────────
function fmtTime(sec: number): string {
  if (!isFinite(sec) || isNaN(sec)) return '—';
  const m = Math.floor(sec / 60), s = Math.floor(sec % 60);
  return `${m}:${s.toString().padStart(2, '0')}`;
}
function fmtAgo(ts: number): string {
  const d = Math.floor((Date.now() - ts) / 60000);
  if (d < 1)  return 'jetzt';
  if (d < 60) return `${d}min`;
  const h = Math.floor(d / 60);
  if (h < 24) return `${h}h`;
  return `${Math.floor(h / 24)}d`;
}
function setStatus(s: string) { if (rpStatus) rpStatus.textContent = s; }
function setTrack(title: string, artist: string) {
  if (rpTrackEl)  rpTrackEl.textContent  = title.length > 60 ? title.slice(0, 60) + '…' : title;
  if (rpArtistEl) rpArtistEl.textContent = artist;
}

// ── Genre filter ──────────────────────────────────────────────────────────────
genreBtns.forEach(btn => {
  btn.addEventListener('click', async () => {
    const genre = btn.dataset.genre ?? 'all';
    if (genre === activeGenre) return;
    activeGenre = genre;
    genreBtns.forEach(b => b.classList.toggle('active', b.dataset.genre === genre));
    if (arBadge) arBadge.textContent = GENRE_LABELS[genre] ?? 'archive.org';
    // Stop current playback and reload with new genre
    if (rpAudio) { rpAudio.pause(); rpAudio = null; }
    setPlaying(false);
    await rpInit();
  });
});

// ── History ───────────────────────────────────────────────────────────────────
function addToHistory(id: string, title: string, artist: string) {
  if (!id || title === '—') return;
  const history = loadHistory();
  if (history.length && history[0].id === id) return;
  history.unshift({ id, title, artist, ts: Date.now() });
  if (history.length > 15) history.pop();
  saveHistory(history);
  renderHistory();
}

function renderHistory() {
  const history = loadHistory();
  if (!arHistory || !arHistItems) return;
  if (!history.length) { arHistory.style.display = 'none'; return; }
  arHistory.style.display = 'block';
  arHistItems.innerHTML = history.map((x: any) => `
    <div class="ar-history-item" data-id="${x.id}" data-title="${x.title}" data-artist="${x.artist}">
      <span class="ar-history-title">${x.title.length > 44 ? x.title.slice(0, 44) + '…' : x.title}</span>
      <span class="ar-history-meta">${x.artist ? x.artist.slice(0, 18) : ''} · ${fmtAgo(x.ts)}</span>
    </div>
  `).join('');

  arHistItems.querySelectorAll<HTMLElement>('.ar-history-item').forEach(el => {
    el.addEventListener('click', () => {
      const id     = el.dataset.id     ?? '';
      const title  = el.dataset.title  ?? '';
      const artist = el.dataset.artist ?? '';
      if (id) rpJumpTo({ identifier: id, title, creator: artist });
    });
  });
}

// ── Seek bar ──────────────────────────────────────────────────────────────────
function seekUpdate() {
  if (!rpAudio) return;
  const pct = rpAudio.duration ? (rpAudio.currentTime / rpAudio.duration) * 100 : 0;
  if (arSeekFill)  arSeekFill.style.width = pct + '%';
  if (arSeekInput) arSeekInput.value = String(pct);
  if (arCurrent)   arCurrent.textContent  = fmtTime(rpAudio.currentTime);
  if (arDuration)  arDuration.textContent = fmtTime(rpAudio.duration);
}
function seekReset() {
  if (arSeekFill)  arSeekFill.style.width = '0%';
  if (arSeekInput) arSeekInput.value = '0';
  if (arCurrent)   arCurrent.textContent  = '0:00';
  if (arDuration)  arDuration.textContent = '—';
}
arSeekInput?.addEventListener('input', () => {
  if (!rpAudio || !rpAudio.duration) return;
  rpAudio.currentTime = (parseFloat(arSeekInput.value) / 100) * rpAudio.duration;
  if (arSeekFill) arSeekFill.style.width = arSeekInput.value + '%';
});

// ── Fetch ─────────────────────────────────────────────────────────────────────
async function fetchTracks(): Promise<any[]> {
  const queries = GENRE_QUERIES[activeGenre] ?? GENRE_QUERIES['all'];
  const q     = queries[Math.floor(Math.random() * queries.length)];
  const start = Math.floor(Math.random() * 30);
  const url   = `https://archive.org/advancedsearch.php?q=${q}&fl[]=identifier&fl[]=title&fl[]=creator&rows=40&start=${start}&output=json`;
  const resp  = await fetch(url, { signal: AbortSignal.timeout(10000) });
  if (!resp.ok) throw new Error('fetch failed');
  const data = await resp.json();
  return data?.response?.docs ?? [];
}

async function getAudioFile(identifier: string): Promise<string | null> {
  const resp = await fetch(`https://archive.org/metadata/${identifier}/files`, { signal: AbortSignal.timeout(8000) });
  if (!resp.ok) return null;
  const data  = await resp.json();
  const files: any[] = data?.result ?? [];
  const mp3s  = files.filter((f: any) => f.name && /\.mp3$/i.test(f.name) && f.source !== 'derivative');
  const oggs  = files.filter((f: any) => f.name && /\.ogg$/i.test(f.name));
  const pick  = mp3s.length ? mp3s : oggs;
  if (!pick.length) return null;
  const f = pick[Math.floor(Math.random() * Math.min(3, pick.length))];
  return `https://archive.org/download/${identifier}/${encodeURIComponent(f.name)}`;
}

// ── Play state ────────────────────────────────────────────────────────────────
function setPlaying(playing: boolean) {
  rpPlaying = playing;
  if (rpPlayBtn) rpPlayBtn.textContent = playing ? '❚❚' : '▶';
  document.querySelectorAll('.rpwb').forEach(b => b.classList.toggle('active', playing));
  if (rpDot) rpDot.classList.toggle('playing', playing);
  setStatus(playing ? '● Playing' : 'Ready');
  window.dispatchEvent(new CustomEvent('ic:playstate', {
    detail: { player: 'archive', playing, title: rpTrackEl?.textContent ?? '—', artist: rpArtistEl?.textContent ?? '' }
  }));
}

// ── Load track ────────────────────────────────────────────────────────────────
async function loadTrack(doc: any, autoplay = false) {
  if (!doc) return;
  rpCurrentId      = doc.identifier ?? '';
  const title      = doc.title   ?? doc.identifier ?? 'Unknown';
  const artist     = doc.creator ?? 'Archive.org';

  setTrack(title, artist);
  if (rpLinkEl) rpLinkEl.href = `https://archive.org/details/${rpCurrentId}`;

  const isLiked = loadLiked().some((x: any) => x.id === rpCurrentId);
  if (rpLikeBtn) {
    rpLikeBtn.textContent = isLiked ? '♥ liked' : '♡ like';
    rpLikeBtn.className   = 'ar-like-btn' + (isLiked ? ' liked' : '');
  }

  seekReset();
  setStatus('Loading…');
  if (rpAudio) { rpAudio.pause(); rpAudio = null; rpPlaying = false; }

  try {
    const src = await getAudioFile(rpCurrentId);
    if (!src) { setStatus('No audio — skip'); return; }
    const audio      = new Audio(src);
    rpAudio          = audio;
    (window as any).__icArchiveAudio = audio;
    audio.ontimeupdate     = seekUpdate;
    audio.onloadedmetadata = seekUpdate;
    audio.onended          = () => rpNext();
    audio.onerror          = () => { setStatus('Error — skipping'); setTimeout(rpNext, 1500); };
    setStatus('● Ready');
    if (autoplay) audio.play().then(() => {
      setPlaying(true);
      addToHistory(rpCurrentId, title, artist);
    }).catch(() => {});
  } catch { setStatus('Unavailable'); }
}

// ── Jump to specific track (history / LikeSidebar) ────────────────────────────
async function rpJumpTo(doc: any) {
  if (rpAudio) { rpAudio.pause(); rpAudio = null; }
  setPlaying(false);
  await loadTrack(doc, true);
}

(window as any).__icArchiveJumpTo = rpJumpTo;

// ── Init ──────────────────────────────────────────────────────────────────────
async function rpInit() {
  if (rpLoading) rpLoading.style.display = 'block';
  if (rpMain)    rpMain.style.display    = 'none';
  try {
    const docs = await fetchTracks();
    rpTracks = docs.length ? docs.sort(() => Math.random() - 0.5) : getFallback();
  } catch { rpTracks = getFallback(); }
  rpIdx = 0;
  if (rpLoading) rpLoading.style.display = 'none';
  if (rpMain)    rpMain.style.display    = 'block';
  setStatus('Ready');
  await loadTrack(rpTracks[0]);
  renderHistory();
}

function getFallback(): any[] {
  return [
    { identifier: 'HumanMusicProject', title: 'Electronic Session',  creator: 'Netlabel' },
    { identifier: 'KSCO-1650',         title: 'Archive Session',     creator: 'Archive.org' },
  ].sort(() => Math.random() - 0.5);
}

// ── Toggle ────────────────────────────────────────────────────────────────────
function rpToggle() {
  if (!rpAudio) return;
  if (rpPlaying) {
    rpAudio.pause(); setPlaying(false);
  } else {
    rpAudio.play().then(() => {
      setPlaying(true);
      addToHistory(rpCurrentId, rpTrackEl?.textContent ?? '—', rpArtistEl?.textContent ?? '');
    }).catch(() => setStatus('Click play'));
  }
}

// ── Next ──────────────────────────────────────────────────────────────────────
async function rpNext() {
  if (rpAudio) { rpAudio.pause(); rpAudio = null; }
  setPlaying(false);
  rpIdx = (rpIdx + 1) % rpTracks.length;
  if (rpIdx === 0) {
    try { const docs = await fetchTracks(); if (docs.length) rpTracks = docs.sort(() => Math.random() - 0.5); } catch {}
  }
  await loadTrack(rpTracks[rpIdx], true);
}

// ── Like ──────────────────────────────────────────────────────────────────────
function rpLike() {
  if (!rpCurrentId) return;
  const liked  = loadLiked();
  const idx    = liked.findIndex((x: any) => x.id === rpCurrentId);
  const title  = rpTrackEl?.textContent  ?? '—';
  const artist = rpArtistEl?.textContent ?? '—';
  if (idx >= 0) {
    liked.splice(idx, 1);
    if (rpLikeBtn) { rpLikeBtn.textContent = '♡ like'; rpLikeBtn.className = 'ar-like-btn'; }
  } else {
    liked.unshift({ id: rpCurrentId, title, artist, ts: Date.now() });
    if (rpLikeBtn) { rpLikeBtn.textContent = '♥ liked'; rpLikeBtn.className = 'ar-like-btn liked'; }
  }
  saveLiked(liked);
  // Notify LikeSidebar instantly — replaces the old 1.5s polling loop
  window.dispatchEvent(new Event('ic:liked-changed'));
}

// ── Wire up ───────────────────────────────────────────────────────────────────
rpPlayBtn?.addEventListener('click', rpToggle);
rpSkipBtn?.addEventListener('click', () => rpNext());
rpLikeBtn?.addEventListener('click', rpLike);
rpStatus?.addEventListener('click', () => { if (!rpPlaying) rpInit(); });
arHistClear?.addEventListener('click', () => {
  saveHistory([]);
  renderHistory();
});

rpInit();
</script>
