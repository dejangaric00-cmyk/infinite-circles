---
// src/components/MediaSessionController.astro
// Wires up the browser MediaSession API so that:
//   - OS media keys (⏯ ⏭) control the engine
//   - Lockscreen / notification shade shows track info + cover
//   - Browser tab shows ▶ indicator while playing
// No service worker needed — MediaSession works in the foreground tab.
// All state comes from src/utils/player.ts, so this works on every page.
---

<script>
  import { subscribe, play, pause, seekBy, seekToPercent, getPosition, getState } from '../utils/player';
  import { requestNext } from '../utils/archive';

  if ('mediaSession' in navigator) {
    const ms = navigator.mediaSession;

    function syncPosition() {
      const { currentTime, duration } = getPosition();
      if (!isFinite(duration) || duration <= 0) return;
      try {
        ms.setPositionState({
          duration,
          playbackRate: 1,
          position: Math.min(currentTime, duration),
        });
      } catch { /* unsupported combination */ }
    }

    // ── Action handlers ───────────────────────────────────────────────────────
    ms.setActionHandler('play',  () => void play());
    ms.setActionHandler('pause', () => pause());
    ms.setActionHandler('stop',  () => pause());
    ms.setActionHandler('nexttrack', () => requestNext());

    // Not every browser supports all of these.
    try {
      ms.setActionHandler('previoustrack', () => seekToPercent(0));
      ms.setActionHandler('seekforward',  (d) => seekBy(d.seekOffset ?? 10));
      ms.setActionHandler('seekbackward', (d) => seekBy(-(d.seekOffset ?? 10)));
      ms.setActionHandler('seekto', (d) => {
        const { duration } = getPosition();
        if (d.seekTime == null || !isFinite(duration) || duration <= 0) return;
        seekToPercent((d.seekTime / duration) * 100);
      });
    } catch { /* ignore unsupported actions */ }

    // ── Metadata ──────────────────────────────────────────────────────────────
    subscribe((s) => {
      ms.playbackState = s.playing ? 'playing' : 'paused';
      if (!s.playing) return; // don't overwrite metadata on pause

      const fallbackTitle =
        s.source === 'archive'     ? 'Archive.org'
        : s.source === 'underground' ? (s.stationName || 'Underground Radio')
        : 'Soma FM';

      const album =
        s.source === 'archive'     ? 'infinite-circles.de · Archive'
        : s.source === 'underground' ? 'infinite-circles.de · Underground'
        : 'infinite-circles.de';

      const artwork: MediaImage[] = s.track.cover
        ? [{ src: s.track.cover, sizes: '512x512', type: 'image/jpeg' }]
        : [{ src: '/icon-512.png', sizes: '512x512', type: 'image/png' }];

      ms.metadata = new MediaMetadata({
        title: s.track.title && s.track.title !== '—' ? s.track.title : fallbackTitle,
        artist: s.track.artist || s.stationName || 'Live Radio',
        album,
        artwork,
      });

      syncPosition();
    });

    // Keep the lock screen scrubber honest while a finite track runs
    setInterval(() => { if (getState().playing) syncPosition(); }, 5000);
  }
</script>
