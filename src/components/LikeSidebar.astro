---
// src/components/LikeSidebar.astro
// Slide-in sidebar showing liked Archive.org tracks.
// Toggle via the ♥ button (bottom-left).
---

<!-- Toggle button (bottom-left) -->
<button class="like-toggle" id="like-toggle" aria-label="Liked Songs öffnen" title="Liked Songs">
  <span class="like-toggle-icon">♥</span>
  <span class="like-toggle-count" id="like-count" hidden>0</span>
</button>

<!-- Sidebar -->
<div class="like-sidebar" id="like-sidebar" aria-label="Liked Songs" hidden>
  <div class="ls-header">
    <span class="ls-title">♥ Liked</span>
    <button class="ls-close" id="ls-close" aria-label="Schließen">✕</button>
  </div>
  <div class="ls-body" id="ls-body">
    <p class="ls-empty" id="ls-empty">Noch keine Likes.<br>Drücke ♡ im Archive-Player.</p>
    <div class="ls-items" id="ls-items"></div>
  </div>
  <div class="ls-footer">
    <button class="ls-clear" id="ls-clear">Alle entfernen</button>
  </div>
</div>

<!-- Backdrop -->
<div class="like-backdrop" id="like-backdrop" hidden></div>

<style>
  .like-toggle {
    position: fixed;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 500;
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 0.6rem;
    border-radius: 20px;
    border: 0.5px solid var(--border-mid, rgba(255,255,255,0.15));
    background: var(--glass-bg, rgba(10,18,35,0.6));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: border-color 0.15s, background 0.15s;
  }
  .like-toggle:hover { border-color: #ff6ef7; background: var(--glass-bg-strong, rgba(10,18,35,0.85)); }
  .like-toggle-icon { font-size: 0.7rem; color: var(--text-dim, rgba(255,255,255,0.35)); line-height: 1; transition: color 0.15s; }
  .like-toggle:hover .like-toggle-icon { color: #ff6ef7; }
  .like-toggle.has-likes .like-toggle-icon { color: #ff6ef7; }
  .like-toggle-count { font-family: var(--font-mono); font-size: 0.62rem; color: #ff6ef7; line-height: 1; }

  .like-backdrop {
    position: fixed; inset: 0; z-index: 600;
    background: rgba(0,0,0,0.3);
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
    opacity: 0; transition: opacity 0.25s ease; pointer-events: none;
  }
  .like-backdrop:not([hidden]) { opacity: 1; pointer-events: auto; }
  .like-backdrop[hidden] { display: block !important; opacity: 0; pointer-events: none; }

  .like-sidebar {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 700;
    width: 280px; max-width: 85vw;
    display: flex; flex-direction: column;
    background: var(--glass-bg-strong, rgba(8,14,28,0.97));
    border-right: 0.5px solid var(--border-mid, rgba(255,255,255,0.1));
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .like-sidebar:not([hidden]) { transform: translateX(0); }
  .like-sidebar[hidden] { display: flex !important; transform: translateX(-100%); pointer-events: none; }

  .ls-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1rem 0.75rem;
    border-bottom: 0.5px solid var(--border-mid, rgba(255,255,255,0.08));
    flex-shrink: 0;
  }
  .ls-title { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #ff6ef7; }
  .ls-close { all: unset; cursor: pointer; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-dim, rgba(255,255,255,0.4)); padding: 2px 4px; border-radius: 4px; transition: color 0.15s; }
  .ls-close:hover { color: var(--text-deep, #fff); }

  .ls-body { flex: 1; overflow-y: auto; padding: 0.75rem 0; }
  .ls-empty { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim, rgba(255,255,255,0.3)); line-height: 1.7; text-align: center; padding: 2rem 1rem; margin: 0; }
  .ls-items { display: flex; flex-direction: column; }

  .ls-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1rem; cursor: pointer; transition: background 0.12s; border-bottom: 0.5px solid var(--border-mid, rgba(255,255,255,0.06)); }
  .ls-item:last-child { border-bottom: none; }
  .ls-item:hover { background: rgba(255,110,247,0.06); }

  .ls-item-play { all: unset; cursor: pointer; width: 22px; height: 22px; border-radius: 50%; border: 0.5px solid rgba(255,110,247,0.3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #ff6ef7; font-size: 0.5rem; transition: background 0.12s, border-color 0.12s; }
  .ls-item-play:hover { background: rgba(255,110,247,0.15); border-color: #ff6ef7; }

  .ls-item-info { flex: 1; min-width: 0; }
  .ls-item-title { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-deep, #fff); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.4; }
  .ls-item-artist { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-dim, rgba(255,255,255,0.4)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.3; }

  .ls-item-remove { all: unset; cursor: pointer; font-size: 0.65rem; color: var(--text-dim, rgba(255,255,255,0.25)); padding: 2px 4px; border-radius: 3px; flex-shrink: 0; line-height: 1; transition: color 0.12s; }
  .ls-item-remove:hover { color: #ff6ef7; }

  .ls-footer { padding: 0.6rem 1rem; border-top: 0.5px solid var(--border-mid, rgba(255,255,255,0.08)); flex-shrink: 0; }
  .ls-clear { all: unset; cursor: pointer; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.06em; color: var(--text-dim, rgba(255,255,255,0.3)); transition: color 0.15s; }
  .ls-clear:hover { color: #ff6ef7; }

  @media (max-width: 400px) { .like-toggle { bottom: 0.75rem; left: 0.75rem; } }
</style>

<script>
  import {
    playDoc, loadLiked, saveLiked, fmtAgo,
    LIKED_KEY, LIKED_CHANGED, type StoredTrack,
  } from '../utils/archive';

  const sidebar  = document.getElementById('like-sidebar')  as HTMLElement;
  const backdrop = document.getElementById('like-backdrop') as HTMLElement;
  const toggle   = document.getElementById('like-toggle')   as HTMLButtonElement;
  const closeBtn = document.getElementById('ls-close')      as HTMLButtonElement;
  const clearBtn = document.getElementById('ls-clear')      as HTMLButtonElement;
  const itemsEl  = document.getElementById('ls-items')      as HTMLElement;
  const emptyEl  = document.getElementById('ls-empty')      as HTMLElement;
  const countEl  = document.getElementById('like-count')    as HTMLElement;

  // Storage and formatting live in src/utils/archive.ts — see imports above.

  function openSidebar()  { sidebar.hidden = false; backdrop.hidden = false; render(); closeBtn.focus(); }
  function closeSidebar() { sidebar.hidden = true;  backdrop.hidden = true;  toggle.focus(); }

  toggle.addEventListener('click', () => sidebar.hidden ? openSidebar() : closeSidebar());
  closeBtn.addEventListener('click', closeSidebar);
  backdrop.addEventListener('click', closeSidebar);
  clearBtn.addEventListener('click', () => saveLiked([]));

  // ── XSS-safe DOM rendering (no innerHTML with user data) ──────────────────
  function render() {
    const liked = loadLiked();
    emptyEl.style.display = liked.length ? 'none' : 'block';
    itemsEl.innerHTML = '';
    if (!liked.length) return;

    liked.forEach((x: StoredTrack) => {
      const row = document.createElement('div');
      row.className = 'ls-item';

      const playBtn = document.createElement('button');
      playBtn.className = 'ls-item-play';
      playBtn.setAttribute('aria-label', 'Play');
      playBtn.textContent = '▶';
      playBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Straight to the engine — works on pages without the radio UI too.
        void playDoc({ identifier: x.id, title: x.title, creator: x.artist || '' });
        closeSidebar();
      });

      const info = document.createElement('div');
      info.className = 'ls-item-info';

      const titleEl = document.createElement('div');
      titleEl.className = 'ls-item-title';
      // textContent auto-escapes — safe against XSS
      titleEl.textContent = x.title.length > 32 ? x.title.slice(0, 32) + '…' : x.title;

      const artistEl = document.createElement('div');
      artistEl.className = 'ls-item-artist';
      artistEl.textContent = `${x.artist ? x.artist.slice(0, 24) : 'Archive.org'} · ${fmtAgo(x.ts)}`;

      info.append(titleEl, artistEl);

      const removeBtn = document.createElement('button');
      removeBtn.className = 'ls-item-remove';
      removeBtn.setAttribute('aria-label', 'Entfernen');
      removeBtn.textContent = '✕';
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const current = loadLiked();
        const idx = current.findIndex((item) => item.id === x.id);
        if (idx >= 0) current.splice(idx, 1);
        saveLiked(current);
      });

      row.append(playBtn, info, removeBtn);
      itemsEl.appendChild(row);
    });
  }

  // ── Badge ──────────────────────────────────────────────────────────────────
  function updateBadge() {
    const count = loadLiked().length;
    countEl.textContent = String(count);
    countEl.hidden = count === 0;
    toggle.classList.toggle('has-likes', count > 0);
  }
  updateBadge();

  window.addEventListener('storage', (e) => {
    if (e.key === LIKED_KEY) { updateBadge(); if (!sidebar.hidden) render(); }
  });
  // saveLiked() fires this, so every mutation repaints through one path.
  window.addEventListener(LIKED_CHANGED, () => {
    updateBadge();
    if (!sidebar.hidden) render();
  });
</script>
