---
// src/components/ArchiveEmbed.astro
interface Props {
  identifier: string;
  title: string;
  artist?: string;
  genre?: string;
  year?: string | number;
  note?: string;
}

const { identifier, title, artist, genre, year, note } = Astro.props;
const embedUrl = `https://archive.org/embed/${identifier}`;
const itemUrl  = `https://archive.org/details/${identifier}`;
---

<div class="archive-card">
  <div class="archive-meta">
    <div class="archive-info">
      <div class="archive-title">{title}</div>
      {artist && <div class="archive-artist">{artist}</div>}
      <div class="archive-chips">
        {genre && <span class="ac-chip ac-chip-accent">{genre}</span>}
        {year  && <span class="ac-chip">{year}</span>}
      </div>
    </div>
    <a href={itemUrl} target="_blank" rel="noopener" class="archive-link" aria-label="Auf Archive.org öffnen">
      <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 10L10 2M5 2h5v5"/>
      </svg>
    </a>
  </div>

  <iframe
    src={embedUrl}
    width="100%"
    height="60"
    frameborder="0"
    allow="autoplay"
    loading="lazy"
    title={`${title} – Archive.org Player`}
  ></iframe>

  {note && <div class="archive-note">{note}</div>}
</div>

<style>
.archive-card {
  border: 0.5px solid var(--border-mid);
  border-radius: 8px;
  overflow: hidden;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.archive-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.75rem 1rem 0.6rem;
  border-bottom: 0.5px solid var(--border-mid);
}

.archive-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.archive-title {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 400;
  color: var(--text-deep);
  letter-spacing: .04em;
}

.archive-artist {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--text-dim);
  letter-spacing: .04em;
}

.archive-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 4px;
}

.ac-chip {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 3px;
  background: transparent;
  color: var(--text-dim);
  border: 0.5px solid var(--border-mid);
  line-height: 1.4;
}

.ac-chip-accent {
  color: var(--accent);
  border-color: var(--accent);
  opacity: 0.7;
}

.archive-link {
  flex-shrink: 0;
  color: var(--text-dim);
  text-decoration: none;
  padding: 3px;
  border-radius: 3px;
  transition: color 0.15s;
  margin-top: 1px;
}

.archive-link:hover { color: var(--accent); }

.archive-card iframe {
  width: 100%;
  height: 60px;
  border: none;
  display: block;
}

.archive-note {
  padding: 0.45rem 1rem;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .04em;
  color: var(--text-dim);
  border-top: 0.5px solid var(--border-mid);
  line-height: 1.6;
}
</style>
