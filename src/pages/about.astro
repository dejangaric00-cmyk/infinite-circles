---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Über mich – Infinite Circles"
  description="Dejan aus Hannover. House, Tech House, Minimal, Dub Techno — und eine Seite, auf der das alles zusammenkommt."
>
  <main class="about-wrap">

    <div class="about-eyebrow">Über — Dejan</div>

    <h1 class="about-title">
      Sammeln.<br><em>Suchen.</em><br>Bauen.
    </h1>

    <p class="about-intro">Ich betreibe <em>Infinite Circles</em> — eine persönliche Seite.</p>

    <div class="about-grid">
      <div class="about-card">
        <div class="about-card-label">Ort</div>
        <div class="about-card-value">Hannover, DE</div>
      </div>
      <div class="about-card">
        <div class="about-card-label">Gebaut mit</div>
        <div class="about-card-value">Astro · GitHub · Netlify</div>
      </div>
    </div>

  </main>
</BaseLayout>

<style>
  .about-wrap {
    max-width: 680px;
    margin: 5rem auto;
    padding: 0 2rem;
    text-align: center;
  }

  .about-eyebrow {
    font-size: 9px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 2rem;
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 300;
    line-height: 1.05;
    color: var(--heading);
    margin-bottom: 2rem;
  }

  .about-title em {
    font-style: italic;
    color: inherit;
  }

  .about-intro {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 2;
    color: var(--text-deep);
    margin-bottom: 3rem;
  }

  .about-intro em {
    font-style: italic;
    color: var(--accent-ink);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 480px;
    margin: 0 auto;
  }

  .about-card {
    background: var(--glass-bg);
    border: 0.5px solid var(--glass-border);
    border-radius: 14px;
    padding: 1.5rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .about-card-label {
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
  }

  .about-card-value {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 300;
    color: var(--text-deep);
  }

  @media (max-width: 480px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
