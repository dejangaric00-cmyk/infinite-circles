---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const posts = await getCollection('journal');
const post = posts.find(p => p.id === slug);
if (!post) return Astro.redirect('/journal');

const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Infinite Circles`} description={post.data.description}>

  <div class="page-post">
    <div class="post-header reveal">
      <a href="/journal" class="back">← Journal</a>
      <div class="post-date">
        {post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
    </div>

    <div class="post-body reveal" style="transition-delay:.1s">
      <Content />
    </div>

    <div class="post-footer reveal" style="transition-delay:.2s">
      <a href="/journal" class="back">← Zurück zum Journal</a>
    </div>
  </div>

</BaseLayout>

<style>
  body { background: var(--sky-top); }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
    z-index: -2;
    pointer-events: none;
  }

  .page-post {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  .post-header {
    padding: 4rem 0 3rem;
    border-bottom: 0.5px solid var(--border-light);
    margin-bottom: 3rem;
  }

  .back {
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    transition: var(--t);
    display: inline-block;
    margin-bottom: 2rem;
  }
  .back:hover { color: var(--accent); }

  .post-date {
    font-size: 10px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text-deep);
    margin-bottom: 1rem;
  }

  .post-desc {
    font-size: 13px;
    color: var(--text-mid);
    line-height: 1.9;
  }

  .post-body {
    font-size: 14px;
    line-height: 2;
    color: var(--text-mid);
  }
  .post-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 300;
    color: var(--text-deep);
    margin: 2.5rem 0 1rem;
  }
  .post-body :global(p) { margin-bottom: 1.5rem; }
  .post-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .post-body :global(strong) { color: var(--text-deep); font-weight: 400; }
  .post-body :global(em) { font-family: var(--font-serif); font-style: italic; font-size: 1.1em; }

  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 0.5px solid var(--border-light);
  }

  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
    .page-post { padding: 0 1.5rem 4rem; }
    .post-header { padding: 3rem 0 2rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>