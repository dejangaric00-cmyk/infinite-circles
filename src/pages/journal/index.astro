---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Journal — Infinite Circles" description="Music journal, thoughts and notes.">

  <div class="page-journal">
    <section class="journal-header reveal">
      <div class="section-label">Journal</div>
      <h1>Thoughts, music &<br><em>fragments.</em></h1>
      <p class="header-desc">{posts.length} entries so far.</p>
    </section>

    <section class="cards-section">
      <div class="cards-grid">
        {posts.map((post, i) => (
          <a href={`/journal/${post.id}`} class="card reveal" style={`transition-delay:${i * 0.08}s`}>
            <div class="card-date">
              {post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'short', year: 'numeric' })}
            </div>
            <div class="card-title">{post.data.title}</div>
            <div class="card-desc">{post.data.description}</div>
            <div class="card-arrow">→</div>
          </a>
        ))}
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  body { background: var(--sky-top); }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
    z-index: -2;
    pointer-events: none;
  }

  .page-journal {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .journal-header {
    padding: 5rem 0 3.5rem;
    border-bottom: 0.5px solid var(--border-light);
    margin-bottom: 3.5rem;
  }

  .section-label {
    font-size: 9px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .section-label::before { content: '·'; margin-right: .45em; font-size: 1.4em; line-height: 0; vertical-align: middle; }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text-deep);
    margin-bottom: 1rem;
  }
  h1 em { font-style: italic; color: var(--accent); }

  .header-desc {
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: .06em;
  }

  .cards-section {
    padding-bottom: 5rem;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .card {
    background: var(--glass-bg);
    border: 0.5px solid var(--glass-border);
    border-radius: 14px;
    padding: 2rem;
    transition: var(--t);
    backdrop-filter: blur(16px);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: .6rem;
  }
  .card:hover {
    background: var(--glass-bg-strong);
    transform: translateY(-2px);
    border-color: var(--accent2);
  }
  .card-date {
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 300;
    line-height: 1.25;
    color: var(--text-deep);
  }
  .card-desc {
    font-size: 11px;
    color: var(--text-mid);
    line-height: 1.8;
    flex: 1;
  }
  .card-arrow {
    font-size: 14px;
    color: var(--text-dim);
    margin-top: .5rem;
    transition: var(--t);
  }
  .card:hover .card-arrow { color: var(--accent); transform: translateX(3px); }

  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
    .page-journal { padding: 0 1.5rem; }
    .journal-header { padding: 3rem 0 2.5rem; }
    .cards-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>