---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing – Infinite Circles" description="Texte von Dejan.">
  <main style="max-width: 680px; margin: 4rem auto; padding: 0 2rem;">
    <h1 style="font-family: var(--font-serif); font-size: 2.5rem; font-weight: 300; margin-bottom: 2.5rem; color: var(--text-deep);">Writing</h1>
    <ul style="list-style: none;">
      {entries.map(entry => (
        <li style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 0.5px solid var(--border-mid);">
          <a href={`/writing/${entry.id}`} style="text-decoration: none;">
            <span style="font-size: 11px; letter-spacing: .12em; color: var(--text-dim); font-family: var(--font-mono);">
              {entry.data.date.toISOString().slice(0, 10)}
            </span>
            <h2 style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 300; color: var(--text-deep); margin: 0.3rem 0;">{entry.data.title}</h2>
            {entry.data.description && (
              <p style="font-size: 13px; color: var(--text-mid);">{entry.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
<style>
body { background: var(--sky-top); position: relative; }
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
  z-index: -2;
  pointer-events: none;
}
</style>