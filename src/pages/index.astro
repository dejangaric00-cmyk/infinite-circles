---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Infinite Circles — Dejan">

  <canvas id="rainbow-canvas"></canvas>
  <div class="cloud-layer">
    <div class="cloud" style="width:220px;height:55px;top:8%;left:8%;animation-duration:11s;animation-direction:alternate"></div>
    <div class="cloud" style="width:180px;height:50px;top:5%;right:6%;animation-duration:9s;animation-direction:alternate"></div>
    <div class="cloud" style="width:260px;height:65px;top:20%;right:20%;animation-duration:13s;animation-direction:alternate-reverse"></div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div>
      <h1 class="reveal">Listening,<br><em>thinking,</em><br>making.</h1>
      <p class="hero-desc reveal" style="transition-delay:.1s">Personal site of Dejan. Curator, Explorer, Builder. Music as a starting point. Writing as a way through. Based in Hannover, Germany.</p>
    </div>
    <div class="hero-right reveal" style="transition-delay:.2s">
      <div class="tag-cloud">
        <span class="tag">Music</span>
        <span class="tag">Writing</span>
        <span class="tag">Curation</span>
        <span class="tag">52°N 9°E</span>
      </div>
      <div class="hero-meta">infinite-circles.de &ensp;—&ensp; est. 2026</div>
    </div>
  </section>

</BaseLayout>

<style is:global>
#rainbow-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1; pointer-events: none; opacity: 0.55;
}
.cloud-layer {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1; pointer-events: none; overflow: hidden;
}
.cloud {
  position: absolute;
  background: rgba(255,255,255,0.52);
  border-radius: 50px;
  filter: blur(12px);
  animation: cloudDrift linear infinite;
}
@keyframes cloudDrift {
  from { transform: translateX(-10px); }
  to   { transform: translateX(10px); }
}

.hero {
  padding: 5.5rem 4rem 4rem;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 6rem;
  align-items: end;
}
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 300;
  line-height: 1.03;
  margin-bottom: 1.5rem;
  color: var(--text-deep);
}
.hero h1 em { font-style: italic; color: var(--accent); }
.hero-desc {
  font-size: 11px;
  letter-spacing: .04em;
  line-height: 2.1;
  color: var(--text-mid);
  max-width: 340px;
}
.hero-right { display: flex; flex-direction: column; gap: 1.25rem; }
.tag-cloud { display: flex; gap: .5rem; flex-wrap: wrap; }
.tag {
  font-size: 9px; letter-spacing: .12em; text-transform: uppercase;
  padding: 5px 12px; background: var(--glass-bg);
  border: 0.5px solid var(--glass-border); color: var(--text-mid);
  border-radius: 20px; backdrop-filter: blur(10px);
}
.hero-meta { font-size: 10px; color: var(--text-dim); letter-spacing: .08em; }

.reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
.reveal.in { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; gap: 2rem; padding: 3rem 1.5rem 2.5rem; }
}
</style>

<script>
const observer = new IntersectionObserver(
  (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
  { threshold: 0.1 }
);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

const canvas = document.getElementById('rainbow-canvas') as HTMLCanvasElement;
if (canvas) {
  const ctx = canvas.getContext('2d')!;
  let t = 0;
  const resize = () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; };
  resize();
  window.addEventListener('resize', resize);
  const draw = () => {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < 3; i++) {
      const x = canvas.width * (0.2 + i * 0.3 + Math.sin(t * 0.0008 + i) * 0.1);
      const y = canvas.height * (0.3 + Math.sin(t * 0.0006 + i * 1.2) * 0.2);
      const r = canvas.width * 0.35;
      const g = ctx.createRadialGradient(x, y, 0, x, y, r);
      const colors = ['rgba(74,144,217,0.12)', 'rgba(135,206,235,0.08)', 'rgba(26,107,181,0.1)'];
      g.addColorStop(0, colors[i]);
      g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    t++;
    requestAnimationFrame(draw);
  };
  draw();
}
</script>