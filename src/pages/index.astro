---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Infinite Circles">
  <main>
    <h1>infinite-circles.de</h1>
    <p>Work in progress.</p>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    place-items: center;
    min-height: 100vh;
    padding: 2rem;
    text-align: center;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 300;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-muted);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }
</style>
