---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Infinite Circles — Dejan">

  <canvas id="circle-canvas"></canvas>

  <section class="hero">
    <div>
      <h1 class="reveal">Listening,<br><em>thinking,</em><br>making.</h1>
      <p class="hero-desc reveal" style="transition-delay:.1s">Personal site of Dejan. Curator, Explorer, Builder. Music as a starting point. Writing as a way through. Based in Hannover, Germany.</p>
    </div>
    <div class="hero-right reveal" style="transition-delay:.2s">

      <!-- DATA WIDGETS -->
      <div class="data-stack">

        <!-- SUN -->
        <div class="data-widget" id="widget-sun">
          <div class="widget-label">Sonne · Hannover</div>
          <div class="sun-arc-wrap">
            <canvas id="sun-arc" width="160" height="52"></canvas>
          </div>
          <div class="widget-sub" id="sun-times">—</div>
        </div>

        <!-- MOON -->
        <div class="data-widget" id="widget-moon">
          <div class="widget-label">Mondphase</div>
          <div class="moon-wrap">
            <canvas id="moon-canvas" width="28" height="28"></canvas>
            <span class="widget-value" id="moon-label">—</span>
          </div>
        </div>

        <!-- LOCATION -->
        <div class="data-widget">
          <div class="widget-label">Position</div>
          <div class="widget-value mono">52.3759° N &nbsp;9.7320° E</div>
          <div class="widget-sub">Hannover · UTC+2</div>
        </div>

        <!-- AIR QUALITY -->
        <div class="data-widget" id="widget-aqi">
          <div class="widget-label">Luftqualität</div>
          <div class="widget-value" id="aqi-value">—</div>
          <div class="widget-sub" id="aqi-label">wird geladen…</div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
#circle-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1;
  pointer-events: none;
}
.hero {
  padding: 5.5rem 4rem 4rem;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 6rem;
  align-items: start;
}
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 300;
  line-height: 1.03;
  margin-bottom: 1.5rem;
  color: var(--text-deep);
}
.hero h1 em { font-style: italic; color: var(--accent); }
.hero-desc {
  font-size: 11px;
  letter-spacing: .04em;
  line-height: 2.1;
  color: var(--text-mid);
  max-width: 340px;
}

/* DATA STACK */
.data-stack {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.data-widget {
  padding: 0.85rem 0;
  border-bottom: 0.5px solid var(--border-mid);
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.data-widget:first-child { border-top: 0.5px solid var(--border-mid); }
.widget-label {
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-dim);
}
.widget-value {
  font-size: 13px;
  color: var(--text-deep);
  letter-spacing: .04em;
}
.widget-value.mono {
  font-family: var(--font-mono);
  font-size: 11px;
}
.widget-sub {
  font-size: 9px;
  color: var(--text-mid);
  letter-spacing: .06em;
}

/* SUN ARC */
.sun-arc-wrap { line-height: 0; }
#sun-arc { display: block; }

/* MOON */
.moon-wrap {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
#moon-canvas { display: block; }

.reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
.reveal.in { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.5rem 2.5rem; }
}
</style>

<script>
// ── Reveal ──────────────────────────────────────────────
const observer = new IntersectionObserver(
  (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
  { threshold: 0.1 }
);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── Helpers ──────────────────────────────────────────────
const LAT = 52.3759;
const LNG = 9.7320;
const isDark = () => document.documentElement.classList.contains('dark');

function fmt(date: Date) {
  return date.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
}

// ── SunCalc inline (no import needed – pure math) ────────
// Simplified sun position + times calculation
function getSunTimes(date: Date, lat: number, lng: number) {
  const J1970 = 2440588, J2000 = 2451545;
  const rad = Math.PI / 180;
  const toJulian = (d: Date) => d.valueOf() / 86400000 - 0.5 + J1970;
  const toDays = (d: Date) => toJulian(d) - J2000;

  const n = toDays(date);
  const M = (357.5291 + 0.98560028 * n) * rad;
  const C = (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M)) * rad;
  const P = 102.9372 * rad;
  const lambda = M + C + P + Math.PI;
  const sinD = Math.sin(lambda) * Math.sin(23.45 * rad);
  const cosD = Math.cos(Math.asin(sinD));

  const Jnoon = J2000 + 0.0009 + ((-lng) / 360) + Math.round(n - (-lng) / 360);
  const w0 = Math.acos((Math.sin(-0.833 * rad) - Math.sin(lat * rad) * sinD) / (Math.cos(lat * rad) * cosD));
  const Jset = Jnoon + (w0 / (2 * Math.PI));
  const Jrise = Jnoon - (w0 / (2 * Math.PI));

  const fromJulian = (j: number) => new Date((j + 0.5 - J1970) * 86400000);
  return {
    sunrise: fromJulian(Jrise),
    sunset: fromJulian(Jset),
    noon: fromJulian(Jnoon),
  };
}

function getSunAltitude(date: Date, lat: number, lng: number): number {
  const rad = Math.PI / 180;
  const J1970 = 2440588, J2000 = 2451545;
  const toJulian = (d: Date) => d.valueOf() / 86400000 - 0.5 + J1970;
  const n = toJulian(date) - J2000;
  const M = (357.5291 + 0.98560028 * n) * rad;
  const C = (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M)) * rad;
  const P = 102.9372 * rad;
  const lambda = M + C + P + Math.PI;
  const sinD = Math.sin(lambda) * Math.sin(23.45 * rad);
  const cosD = Math.cos(Math.asin(sinD));
  const lw = -lng * rad;
  const phi = lat * rad;
  const J = toJulian(date);
  const Jtransit = J2000 + 0.0009 + (lw / (2 * Math.PI)) + Math.round(J - J2000 - 0.0009 - lw / (2 * Math.PI));
  const H = (J - Jtransit) * 2 * Math.PI;
  const altitude = Math.asin(Math.sin(phi) * sinD + Math.cos(phi) * cosD * Math.cos(H));
  return altitude / rad;
}

// ── Sun Arc Widget ───────────────────────────────────────
function drawSunArc() {
  const canvas = document.getElementById('sun-arc') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const now = new Date();
  const { sunrise, sunset } = getSunTimes(now, LAT, LNG);
  const dark = isDark();

  const W = 160, H = 52;
  ctx.clearRect(0, 0, W, H);

  const margin = 12;
  const cx = W / 2;
  const cy = H + 8;
  const r = H - 4;

  // Background arc (full path)
  ctx.beginPath();
  ctx.arc(cx, cy, r, Math.PI, 0);
  ctx.strokeStyle = dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
  ctx.lineWidth = 1;
  ctx.stroke();

  // Progress arc
  const total = sunset.getTime() - sunrise.getTime();
  const elapsed = Math.max(0, Math.min(total, now.getTime() - sunrise.getTime()));
  const progress = elapsed / total; // 0 to 1
  const startAngle = Math.PI;
  const endAngle = Math.PI + progress * Math.PI;

  ctx.beginPath();
  ctx.arc(cx, cy, r, startAngle, endAngle);
  ctx.strokeStyle = dark ? 'rgba(255,210,100,0.55)' : 'rgba(220,140,30,0.60)';
  ctx.lineWidth = 1.2;
  ctx.stroke();

  // Sun dot at current position
  const sunAngle = startAngle + progress * Math.PI;
  const sx = cx + Math.cos(sunAngle) * r;
  const sy = cy + Math.sin(sunAngle) * r;

  const glow = ctx.createRadialGradient(sx, sy, 0, sx, sy, 7);
  glow.addColorStop(0, dark ? 'rgba(255,220,100,0.95)' : 'rgba(255,180,0,0.95)');
  glow.addColorStop(1, 'rgba(255,200,50,0)');
  ctx.fillStyle = glow;
  ctx.beginPath();
  ctx.arc(sx, sy, 7, 0, Math.PI * 2);
  ctx.fill();

  // Dot center
  ctx.beginPath();
  ctx.arc(sx, sy, 2.5, 0, Math.PI * 2);
  ctx.fillStyle = dark ? '#ffe066' : '#e08000';
  ctx.fill();

  // Times label
  const timesEl = document.getElementById('sun-times');
  if (timesEl) {
    timesEl.textContent = `Aufgang ${fmt(sunrise)} · Untergang ${fmt(sunset)}`;
  }
}

// ── Moon Phase Widget ────────────────────────────────────
function getMoonPhase(date: Date): { phase: number; name: string } {
  const known = new Date(2000, 0, 6, 18, 14, 0); // known new moon
  const synodic = 29.530588853;
  const diff = (date.getTime() - known.getTime()) / (1000 * 60 * 60 * 24);
  const phase = ((diff % synodic) + synodic) % synodic;
  const frac = phase / synodic;

  let name = '';
  if (frac < 0.03 || frac > 0.97) name = 'Neumond';
  else if (frac < 0.22) name = 'Zunehmend';
  else if (frac < 0.28) name = 'Erstes Viertel';
  else if (frac < 0.47) name = 'Zunehmend (Gibbous)';
  else if (frac < 0.53) name = 'Vollmond';
  else if (frac < 0.72) name = 'Abnehmend (Gibbous)';
  else if (frac < 0.78) name = 'Letztes Viertel';
  else name = 'Abnehmend';

  return { phase: frac, name };
}

function drawMoon() {
  const canvas = document.getElementById('moon-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const { phase, name } = getMoonPhase(new Date());
  const dark = isDark();
  const size = 28, r = 11, cx = 14, cy = 14;

  ctx.clearRect(0, 0, size, size);

  // Moon body
  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.fillStyle = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
  ctx.fill();
  ctx.strokeStyle = dark ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.18)';
  ctx.lineWidth = 0.8;
  ctx.stroke();

  // Illuminated portion
  const angle = phase * Math.PI * 2;
  const illuminated = Math.cos(angle);
  ctx.save();
  ctx.beginPath();
  ctx.arc(cx, cy, r, Math.PI / 2, -Math.PI / 2, false);
  ctx.ellipse(cx, cy, Math.abs(r * illuminated), r, 0, -Math.PI / 2, Math.PI / 2, illuminated < 0);
  ctx.closePath();
  ctx.fillStyle = dark ? 'rgba(255,255,220,0.70)' : 'rgba(255,240,150,0.80)';
  ctx.fill();
  ctx.restore();

  const label = document.getElementById('moon-label');
  if (label) label.textContent = name;
}

// ── Air Quality ──────────────────────────────────────────
async function fetchAQI() {
  try {
    const url = `https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${LAT}&longitude=${LNG}&current=european_aqi`;
    const res = await fetch(url);
    const data = await res.json();
    const aqi = data?.current?.european_aqi;

    const valEl = document.getElementById('aqi-value');
    const lblEl = document.getElementById('aqi-label');
    if (!valEl || !lblEl || aqi == null) return;

    valEl.textContent = `AQI ${aqi}`;

    let label = '', color = '';
    if (aqi <= 20)      { label = 'Sehr gut';    color = '#4caf7d'; }
    else if (aqi <= 40) { label = 'Gut';          color = '#8bc34a'; }
    else if (aqi <= 60) { label = 'Mäßig';        color = '#ffc107'; }
    else if (aqi <= 80) { label = 'Schlecht';     color = '#ff7043'; }
    else                { label = 'Sehr schlecht'; color = '#e53935'; }

    lblEl.textContent = label;
    lblEl.style.color = color;
  } catch {
    const lblEl = document.getElementById('aqi-label');
    if (lblEl) lblEl.textContent = 'Nicht verfügbar';
  }
}

// ── Init ─────────────────────────────────────────────────
drawSunArc();
drawMoon();
fetchAQI();

// Redraw sun arc every minute
setInterval(drawSunArc, 60000);

// Redraw on dark mode toggle
const dmBtn = document.getElementById('dm-btn');
dmBtn?.addEventListener('click', () => {
  setTimeout(() => { drawSunArc(); drawMoon(); }, 50);
});

// ── Infinite Circles Canvas ───────────────────────────────
const canvas = document.getElementById('circle-canvas') as HTMLCanvasElement;
if (canvas) {
  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;
  const resize = () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; };
  resize();
  window.addEventListener('resize', resize);

  const rings = [
    { rf: 0.10, speed: 0.0018, offset: 0.00 },
    { rf: 0.18, speed: 0.0014, offset: 0.90 },
    { rf: 0.27, speed: 0.0011, offset: 1.80 },
    { rf: 0.37, speed: 0.0009, offset: 2.70 },
    { rf: 0.47, speed: 0.0007, offset: 3.60 },
    { rf: 0.58, speed: 0.0005, offset: 4.50 },
    { rf: 0.70, speed: 0.0004, offset: 5.40 },
  ];

  let t = 0;

  const draw = () => {
    ctx.clearRect(0, 0, W, H);
    const dark = isDark();
    const cx = W > 768 ? W * 0.72 : W * 0.5;
    const cy = H * 0.42;
    const base = Math.min(W, H);
    const ringAlphaBase = dark ? 0.12 : 0.18;

    for (let i = 0; i < rings.length; i++) {
      const ring = rings[i];
      const r = base * ring.rf;

      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(255,255,255,${ringAlphaBase - i * 0.01})`;
      ctx.lineWidth = 0.8;
      ctx.stroke();

      const angle = t * ring.speed + ring.offset;
      const dotX = cx + Math.cos(angle) * r;
      const dotY = cy + Math.sin(angle) * r;
      const dotSize = r * 0.08;

      const glow = ctx.createRadialGradient(dotX, dotY, 0, dotX, dotY, dotSize);
      if (dark) {
        glow.addColorStop(0,   'rgba(220,240,255,0.90)');
        glow.addColorStop(0.3, 'rgba(180,220,255,0.45)');
        glow.addColorStop(1,   'rgba(180,220,255,0)');
      } else {
        glow.addColorStop(0,   'rgba(255,255,255,0.95)');
        glow.addColorStop(0.3, 'rgba(220,235,255,0.40)');
        glow.addColorStop(1,   'rgba(220,235,255,0)');
      }
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(dotX, dotY, dotSize, 0, Math.PI * 2);
      ctx.fill();

      const trailLength = Math.PI * 0.35;
      const trailStart = angle - trailLength;
      const trail = ctx.createLinearGradient(
        cx + Math.cos(trailStart) * r, cy + Math.sin(trailStart) * r,
        dotX, dotY
      );
      const trailColor = dark ? '200,225,255' : '255,255,255';
      trail.addColorStop(0, `rgba(${trailColor},0)`);
      trail.addColorStop(1, `rgba(${trailColor},${dark ? 0.18 : 0.22})`);
      ctx.beginPath();
      ctx.arc(cx, cy, r, trailStart, angle);
      ctx.strokeStyle = trail;
      ctx.lineWidth = dark ? 1.2 : 1.4;
      ctx.stroke();
    }

    t++;
    requestAnimationFrame(draw);
  };

  draw();
}
</script>