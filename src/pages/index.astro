---
import BaseLayout from '../layouts/BaseLayout.astro';
import SomaPlayer from '../components/SomaPlayer.astro';
import ArchiveRadio from '../components/ArchiveRadio.astro';
import UndergroundStations from '../components/UndergroundStations.astro';
import { getLatestSotd } from '../utils/sotd';

const latestSotd = await getLatestSotd();
---

<BaseLayout title="Grooves & Rhythms — Infinite Circles">

  <!-- Infinite Circles Ringe — subtiler Hintergrund -->
  <canvas id="circle-canvas" aria-hidden="true"></canvas>

  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="music-hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        infinite&#8209;circles.de&nbsp;/&nbsp;music
      </p>
      <h1 class="hero-title">
        Grooves &amp;&nbsp;<em>Rhythms.</em>
      </h1>
      <p class="hero-sub">House. Tech House. Minimal. Dub Techno.</p>

      {latestSotd && (
        <a href={`/sotd/${latestSotd.id}`} class="sotd-hero-card">
          <span class="sotd-hero-label">· song of the day</span>
          <span class="sotd-hero-title">{latestSotd.data.title}</span>
          <span class="sotd-hero-artist">{latestSotd.data.artist}</span>
          {latestSotd.data.note && <span class="sotd-hero-note">&ldquo;{latestSotd.data.note}&rdquo;</span>}
        </a>
      )}
    </div>
  </section>

  <!-- ══ PLAYERS ═══════════════════════════════════════════════════════════ -->
  <div class="content-wrap">

    <div class="section-label">Live Radio</div>
    <div class="card-label">soma fm</div>
    <SomaPlayer />

    <div class="section-label" style="margin-top: 2rem;">Archive.org · Open Radio</div>
    <ArchiveRadio />

  </div>

  <!-- UndergroundStations bringt ihr eigenes "Entdecken"-Label mit -->
  <UndergroundStations />

  <!-- Globale Bedienelemente liegen jetzt im BaseLayout -->

</BaseLayout>

<!-- ── Ringe Canvas ────────────────────────────────────────────────────────── -->
<script>
  import { onPage, disposer } from '../utils/lifecycle';
  onPage(() => {
    const bgCanvas = document.getElementById('circle-canvas') as HTMLCanvasElement;
    if (bgCanvas) {
      const ctx = bgCanvas.getContext('2d')!;
      const off = disposer();
      let W = 0, H = 0;
      const resize = () => { W = bgCanvas.width = window.innerWidth; H = bgCanvas.height = window.innerHeight; };
      resize();
      off.listen(window, 'resize', resize, { passive: true });

      const isDark = () => document.documentElement.classList.contains('dark');

      const rings = [
        { rf: 0.10, speed: 0.0018, offset: 0.00 },
        { rf: 0.18, speed: 0.0014, offset: 0.90 },
        { rf: 0.27, speed: 0.0011, offset: 1.80 },
        { rf: 0.37, speed: 0.0009, offset: 2.70 },
        { rf: 0.47, speed: 0.0007, offset: 3.60 },
        { rf: 0.58, speed: 0.0005, offset: 4.50 },
        { rf: 0.70, speed: 0.0004, offset: 5.40 },
      ];

      let t = 0;
      let rafId = 0;
      let stopped = false;

      const draw = () => {
        if (stopped) return;
        ctx.clearRect(0, 0, W, H);
        const dark  = isDark();
        const cx    = W > 768 ? W * 0.72 : W * 0.5;
        const cy    = H * 0.32;
        const base  = Math.min(W, H);
        const ringAlpha = dark ? 0.13 : 0.14;
        const dotColor  = dark ? '180,215,255' : '255,255,255';
        const trailColor= dark ? '160,200,255' : '255,255,255';
        const trailAlpha= dark ? 0.20 : 0.20;

        for (const ring of rings) {
          const r = base * ring.rf;

          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.strokeStyle = dark
            ? `rgba(140,190,255,${ringAlpha})`
            : `rgba(255,255,255,${ringAlpha})`;
          ctx.lineWidth = 0.7;
          ctx.stroke();

          const angle = t * ring.speed + ring.offset;
          const dx = cx + Math.cos(angle) * r;
          const dy = cy + Math.sin(angle) * r;
          const dotR = r * 0.07;
          const glow = ctx.createRadialGradient(dx, dy, 0, dx, dy, dotR);
          glow.addColorStop(0,   `rgba(${dotColor},${dark ? 0.95 : 0.92})`);
          glow.addColorStop(0.3, `rgba(${dotColor},${dark ? 0.45 : 0.35})`);
          glow.addColorStop(1,   'rgba(180,220,255,0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(dx, dy, dotR, 0, Math.PI * 2);
          ctx.fill();

          const trailLen   = Math.PI * 0.32;
          const trailStart = angle - trailLen;
          const trail = ctx.createLinearGradient(
            cx + Math.cos(trailStart) * r, cy + Math.sin(trailStart) * r, dx, dy
          );
          trail.addColorStop(0, `rgba(${trailColor},0)`);
          trail.addColorStop(1, `rgba(${trailColor},${trailAlpha})`);
          ctx.beginPath();
          ctx.arc(cx, cy, r, trailStart, angle);
          ctx.strokeStyle = trail;
          ctx.lineWidth = dark ? 1.2 : 1.3;
          ctx.stroke();
        }

        t++;
        rafId = requestAnimationFrame(draw);
      };

      // Pause rAF when tab is hidden to save CPU/GPU
      off.listen(document, 'visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(rafId);
        } else {
          rafId = requestAnimationFrame(draw);
        }
      });

      rafId = requestAnimationFrame(draw);
      off.add(() => { stopped = true; cancelAnimationFrame(rafId); });

      return off.run;
    }
  });
</script>

<style>
  #circle-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0.7;
  }

  /* ── Hero ── */
  .music-hero {
    width: 100%;
    padding: 4rem 0 2.5rem;
  }
  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }
  .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text-deep);
    margin: 0 0 0.75rem;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent);
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin: 0 0 1.5rem;
  }

  .sotd-hero-card {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
    text-decoration: none;
    padding: 0.75rem 1.1rem;
    border: 0.5px solid var(--glass-border);
    border-radius: 10px;
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.15s, background 0.15s;
    max-width: 360px;
  }
  .sotd-hero-card:hover {
    border-color: var(--accent);
    background: var(--glass-bg-strong);
  }
  .sotd-hero-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
  }
  .sotd-hero-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 300;
    color: var(--text-deep);
    line-height: 1.2;
  }
  .sotd-hero-artist {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
  }
  .sotd-hero-note {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-dim);
    margin-top: 2px;
  }

  /* ── Content ── */
  .content-wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    opacity: 0.6;
    text-align: center;
    margin-bottom: 0.9rem;
  }
  .card-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 600px) {
    .music-hero { padding: 2.5rem 0 1.5rem; }
  }
</style>
