---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestSotd } from '../utils/sotd';
import { relativeDayLabel } from '../utils/date';
import { getCollection } from 'astro:content';

const latestSotd = await getLatestSotd();

const journal = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestJournal = journal[0];

// [data-rel-date] is recomputed client-side by BaseLayout, so the value has to
// be YYYY-MM-DD — the journal schema coerces to Date.
const latestJournalIso = latestJournal
  ? latestJournal.data.date.toISOString().slice(0, 10)
  : '';
---

<BaseLayout title="Grooves & Rhythms — Infinite Circles">

  <!-- ══ HERO ══════════════════════════════════════════════════════════════ -->
  <section class="home-hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        infinite&#8209;circles.de
      </p>
      <h1 class="hero-title">
        Grooves &amp;&nbsp;<em>Rhythms.</em>
      </h1>
      <p class="hero-sub">Musikjournal, Radio, Texte. Aus Hannover.</p>
    </div>
  </section>

  <!-- ══ WEGE ══════════════════════════════════════════════════════════════ -->
  <nav class="ways" aria-label="Bereiche">

    <a href="/radio" class="way">
      <span class="way-label">// radio</span>
      <span class="way-title">Live &amp; Archive.</span>
      <span class="way-note">Soma FM, Archive.org und Underground-Sender. Läuft weiter, während du liest.</span>
    </a>

    <a href="/sotd" class="way">
      <span class="way-label">· song of the day</span>
      {latestSotd ? (
        <>
          <span class="way-title">{latestSotd.data.title}</span>
          <span class="way-meta">{latestSotd.data.artist}</span>
          {latestSotd.data.note && <span class="way-note">&ldquo;{latestSotd.data.note}&rdquo;</span>}
        </>
      ) : (
        <span class="way-title">Ein Song pro Tag.</span>
      )}
    </a>

    <a href="/journal" class="way">
      <span class="way-label">// journal</span>
      {latestJournal ? (
        <>
          <span class="way-title">{latestJournal.data.title}</span>
          <span class="way-meta" data-rel-date={latestJournalIso}>{relativeDayLabel(latestJournalIso)}</span>
        </>
      ) : (
        <span class="way-title">Notizen.</span>
      )}
    </a>

  </nav>

</BaseLayout>

<style>
  /* ── Hero ── */
  .home-hero {
    width: 100%;
    padding: 5rem 0 3rem;
  }
  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }
  .eyebrow-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text-deep);
    margin: 0 0 0.75rem;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent);
  }
  .hero-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin: 0;
  }

  /* ── Wege ── */
  .ways {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  .way {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-decoration: none;
    padding: 1.1rem 1.2rem 1.3rem;
    border-radius: var(--r-card);
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 0.5px var(--glass-border-dim);
    transition:
      background 0.35s var(--ease-ios),
      box-shadow 0.35s var(--ease-ios),
      transform 0.2s var(--ease-ios);
  }
  .way:hover {
    background: var(--glass-bg-strong);
    box-shadow:
      inset 0 0.5px 0 var(--glass-hairline),
      inset 0 0 0 0.5px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .way:active { transform: scale(0.99); }
  .way:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .way-label {
    font-family: var(--font-mono);
    /* 8px war unter der Lesbarkeitsgrenze, und die Zeile trägt Information. */
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
    margin-bottom: 2px;
  }
  .way-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--text-deep);
    line-height: 1.25;
  }
  .way-meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.7;
  }
  .way-note {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-style: italic;
    color: var(--text-dim);
    line-height: 1.5;
    margin-top: 3px;
  }

  @media (max-width: 760px) {
    .ways { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .home-hero { padding: 3rem 0 2rem; }
  }
</style>
