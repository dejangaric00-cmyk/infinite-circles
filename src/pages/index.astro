---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Infinite Circles — Dejan">

  <canvas id="circle-canvas"></canvas>

  <section class="hero">
    <div>
      <h1 class="reveal">Listening,<br><em>thinking,</em><br>making.</h1>
      <p class="hero-desc reveal" style="transition-delay:.1s">Personal site of Dejan. Curator, Explorer, Builder. Music as a starting point. Writing as a way through. Based in Hannover, Germany.</p>
    </div>
    <div class="hero-right reveal" style="transition-delay:.2s">

      <div class="signal-panel">
        <div class="panel-header">52°N 9°E · Hannover</div>

        <!-- SUN -->
        <div class="sig-block">
          <div class="sig-label">Sonne</div>
          <div class="sun-arc-wrap">
            <canvas id="sun-arc"></canvas>
          </div>
          <div class="sig-val" id="sun-times">—</div>
          <div class="sig-val" id="sun-daylength">—</div>
          <div class="sig-val" id="sun-countdown">—</div>
        </div>

        <div class="sig-divider"></div>

        <!-- MOON -->
        <div class="sig-block">
          <div class="sig-label">Mond</div>
          <div class="moon-wrap">
            <canvas id="moon-canvas" width="28" height="28"></canvas>
            <div>
              <div class="sig-val" id="moon-name">—</div>
              <div class="sig-val" id="moon-pct">—</div>
            </div>
          </div>
        </div>

        <div class="sig-divider"></div>

        <!-- AQI -->
        <div class="sig-block">
          <div class="sig-label">Luftqualität</div>
          <div class="sig-val" id="aqi-value">—</div>
          <div class="sig-val" id="aqi-label">wird geladen…</div>
        </div>

        <div class="sig-divider"></div>

        <!-- POSITION -->
        <div class="sig-block">
          <div class="sig-label">Position</div>
          <div class="sig-val">52.3759° N &nbsp; 9.7320° E</div>
          <div class="sig-val">UTC+2 · CEST</div>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>

<style is:global>
#circle-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1;
  pointer-events: none;
}
.hero {
  padding: 5.5rem 4rem 4rem;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 6rem;
  align-items: start;
}
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 300;
  line-height: 1.03;
  margin-bottom: 1.5rem;
  color: var(--text-deep);
}
.hero h1 em { font-style: italic; color: var(--accent); }
.hero-desc {
  font-size: 11px;
  letter-spacing: .04em;
  line-height: 2.1;
  color: var(--text-mid);
  max-width: 340px;
}

/* SIGNAL PANEL — vollständig transparent */
.signal-panel {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.panel-header {
  font-size: 8px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-dim);
  font-family: var(--font-mono);
  margin-bottom: 1.25rem;
}

.sig-block {
  display: flex;
  flex-direction: column;
  gap: 0.22rem;
  padding: 0.7rem 0;
}

.sig-divider {
  width: 28px;
  height: 0.5px;
  background: currentColor;
  opacity: 0.15;
}

.sig-label {
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-dim);
  font-family: var(--font-mono);
  margin-bottom: 0.3rem;
}

.sig-val {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 400;
  color: var(--text-deep);
  line-height: 1.7;
  letter-spacing: .03em;
}

/* Sun arc — fluid width */
.sun-arc-wrap {
  width: 100%;
  margin: 4px 0 2px;
}
#sun-arc {
  display: block;
  width: 100%;
  height: auto;
}

.moon-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 2px;
}
#moon-canvas { display: block; flex-shrink: 0; }

.reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
.reveal.in { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.5rem 2.5rem; }
}
</style>

<script>
const observer = new IntersectionObserver(
  (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
  { threshold: 0.1 }
);
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

const LAT = 52.3759, LNG = 9.7320;
const isDark = () => document.documentElement.classList.contains('dark');

function fmt(d: Date) {
  return d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
}
function fmtDuration(ms: number) {
  const totalSec = Math.round(ms / 1000);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  return { h, m };
}

function getSunTimes(date: Date, lat: number, lng: number) {
  const J1970 = 2440588, J2000 = 2451545, rad = Math.PI / 180;
  const toJ = (d: Date) => d.valueOf() / 86400000 - 0.5 + J1970;
  const n = toJ(date) - J2000;
  const M = (357.5291 + 0.98560028 * n) * rad;
  const C = (1.9148 * Math.sin(M) + 0.02 * Math.sin(2 * M) + 0.0003 * Math.sin(3 * M)) * rad;
  const P = 102.9372 * rad;
  const lambda = M + C + P + Math.PI;
  const sinD = Math.sin(lambda) * Math.sin(23.45 * rad);
  const cosD = Math.cos(Math.asin(sinD));
  const Jnoon = J2000 + 0.0009 + ((-lng) / 360) + Math.round(n - (-lng) / 360);
  const w0 = Math.acos((Math.sin(-0.833 * rad) - Math.sin(lat * rad) * sinD) / (Math.cos(lat * rad) * cosD));
  const fromJ = (j: number) => new Date((j + 0.5 - J1970) * 86400000);
  return {
    sunrise: fromJ(Jnoon - w0 / (2 * Math.PI)),
    sunset:  fromJ(Jnoon + w0 / (2 * Math.PI)),
  };
}

// Vollständiges Tagesspektrum (f: 0=Aufgang, 1=Untergang)
function dayColor(f: number): [number, number, number] {
  const stops: Array<[number, [number,number,number]]> = [
    [0.00, [180,  60, 120]], // Morgenrot tief
    [0.08, [255, 100,  50]], // Aufgang orange
    [0.18, [255, 170,  60]], // goldene Morgenstunde
    [0.30, [255, 210, 100]], // helles Gold
    [0.45, [160, 210, 255]], // Tagblau
    [0.50, [185, 225, 255]], // Mittagshell
    [0.55, [160, 210, 255]], // Tagblau
    [0.70, [255, 200,  80]], // Nachmittagsgold
    [0.82, [255, 140,  50]], // Abendsonne
    [0.92, [220,  70,  90]], // Abendrot
    [1.00, [130,  30, 100]], // Dämmerung
  ];
  for (let i = 0; i < stops.length - 1; i++) {
    const [f0, c0] = stops[i];
    const [f1, c1] = stops[i + 1];
    if (f >= f0 && f <= f1) {
      const t = (f - f0) / (f1 - f0);
      return [
        Math.round(c0[0] + (c1[0] - c0[0]) * t),
        Math.round(c0[1] + (c1[1] - c0[1]) * t),
        Math.round(c0[2] + (c1[2] - c0[2]) * t),
      ];
    }
  }
  return stops[stops.length - 1][1];
}

function drawSunArc() {
  const canvas = document.getElementById('sun-arc') as HTMLCanvasElement;
  if (!canvas) return;

  const wrap = canvas.parentElement!;
  const W = wrap.clientWidth || 220;
  const H = Math.round(W * 0.38);
  canvas.width  = W;
  canvas.height = H;

  const ctx = canvas.getContext('2d')!;
  const now = new Date();
  const dark = isDark();
  const { sunrise, sunset } = getSunTimes(now, LAT, LNG);

  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);
  const { sunrise: ysr, sunset: yss } = getSunTimes(yesterday, LAT, LNG);
  const todayLen = sunset.getTime() - sunrise.getTime();
  const yestLen  = yss.getTime() - ysr.getTime();
  const diff     = todayLen - yestLen;

  const cx = W / 2;
  const cy = H + Math.round(H * 0.12);
  const r  = Math.round(W * 0.43);

  ctx.clearRect(0, 0, W, H);

  const steps = 160;
  const total   = sunset.getTime() - sunrise.getTime();
  const elapsed = Math.max(0, Math.min(total, now.getTime() - sunrise.getTime()));
  const prog    = elapsed / total;
  const pSteps  = Math.round(prog * steps);

  // Dim arc
  for (let i = 0; i < steps; i++) {
    const f  = i / steps;
    const a1 = Math.PI + f * Math.PI;
    const a2 = Math.PI + ((i + 1) / steps) * Math.PI;
    const [rc, gc, bc] = dayColor(f);
    ctx.beginPath();
    ctx.arc(cx, cy, r, a1, a2);
    ctx.strokeStyle = `rgba(${rc},${gc},${bc},${dark ? 0.15 : 0.18})`;
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  // Bright progress arc mit Glow
  for (let i = 0; i < pSteps; i++) {
    const f  = i / steps;
    const a1 = Math.PI + f * Math.PI;
    const a2 = Math.PI + ((i + 1) / steps) * Math.PI;
    const [rc, gc, bc] = dayColor(f);

    // Glow layer
    ctx.beginPath();
    ctx.arc(cx, cy, r, a1, a2);
    ctx.strokeStyle = `rgba(${rc},${gc},${bc},${dark ? 0.22 : 0.28})`;
    ctx.lineWidth = 5;
    ctx.stroke();

    // Core
    ctx.beginPath();
    ctx.arc(cx, cy, r, a1, a2);
    ctx.strokeStyle = `rgba(${rc},${gc},${bc},${dark ? 0.82 : 0.95})`;
    ctx.lineWidth = 1.8;
    ctx.stroke();
  }

  // Sonnenpunkt
  const sa = Math.PI + prog * Math.PI;
  const sx = cx + Math.cos(sa) * r;
  const sy = cy + Math.sin(sa) * r;
  const [cr, cg, cb] = dayColor(prog);

  // Äußerer Glow
  const g2 = ctx.createRadialGradient(sx, sy, 0, sx, sy, 16);
  g2.addColorStop(0,   `rgba(${cr},${cg},${cb},0.50)`);
  g2.addColorStop(0.5, `rgba(${cr},${cg},${cb},0.15)`);
  g2.addColorStop(1,   `rgba(${cr},${cg},${cb},0)`);
  ctx.fillStyle = g2;
  ctx.beginPath(); ctx.arc(sx, sy, 16, 0, Math.PI * 2); ctx.fill();

  // Innerer Glow
  const g1 = ctx.createRadialGradient(sx, sy, 0, sx, sy, 7);
  g1.addColorStop(0,   'rgba(255,245,210,0.98)');
  g1.addColorStop(0.6, `rgba(${cr},${cg},${cb},0.60)`);
  g1.addColorStop(1,   `rgba(${cr},${cg},${cb},0)`);
  ctx.fillStyle = g1;
  ctx.beginPath(); ctx.arc(sx, sy, 7, 0, Math.PI * 2); ctx.fill();

  // Kern
  ctx.beginPath(); ctx.arc(sx, sy, 2, 0, Math.PI * 2);
  ctx.fillStyle = '#fff';
  ctx.fill();

  // Texte
  const tEl  = document.getElementById('sun-times');
  const dlEl = document.getElementById('sun-daylength');
  const cdEl = document.getElementById('sun-countdown');

  if (tEl) tEl.textContent = `Aufgang ${fmt(sunrise)} · Untergang ${fmt(sunset)}`;

  if (dlEl) {
    const { h, m } = fmtDuration(todayLen);
    const dSec = Math.round(diff / 1000);
    const sign = dSec >= 0 ? '+' : '−';
    const absSec = Math.abs(dSec);
    const dm = Math.floor(absSec / 60);
    const ds = absSec % 60;
    const diffStr = dm > 0 ? `${sign}${dm}min ${ds}sek` : `${sign}${ds}sek`;
    dlEl.textContent = `Tageslänge ${h}h ${m}min · ${diffStr} ggü. gestern`;
  }

  if (cdEl) {
    const msLeft = sunset.getTime() - now.getTime();
    if (msLeft > 0) {
      const { h, m } = fmtDuration(msLeft);
      cdEl.textContent = h > 0 ? `Untergang in ${h}h ${m}min` : `Untergang in ${m}min`;
    } else {
      const msToRise = sunrise.getTime() + 86400000 - now.getTime();
      const { h, m } = fmtDuration(msToRise);
      cdEl.textContent = `Aufgang in ${h}h ${m}min`;
    }
  }
}

function getMoonPhase(date: Date) {
  const known = new Date(2000, 0, 6, 18, 14, 0);
  const syn = 29.530588853;
  const diff = (date.getTime() - known.getTime()) / (1000 * 60 * 60 * 24);
  const frac = ((diff % syn) + syn) % syn / syn;
  let name = '';
  if      (frac < 0.03 || frac > 0.97) name = 'Neumond';
  else if (frac < 0.22) name = 'Zunehmende Sichel';
  else if (frac < 0.28) name = 'Erstes Viertel';
  else if (frac < 0.47) name = 'Zunehmender Mond';
  else if (frac < 0.53) name = 'Vollmond';
  else if (frac < 0.72) name = 'Abnehmender Mond';
  else if (frac < 0.78) name = 'Letztes Viertel';
  else                  name = 'Abnehmende Sichel';
  return { frac, name };
}

function drawMoon() {
  const canvas = document.getElementById('moon-canvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  const { frac, name } = getMoonPhase(new Date());
  const dark = isDark();
  const r = 12, cx = 14, cy = 14;
  ctx.clearRect(0, 0, 28, 28);
  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.fillStyle = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
  ctx.fill();
  ctx.strokeStyle = dark ? 'rgba(255,255,255,0.20)' : 'rgba(0,0,0,0.12)';
  ctx.lineWidth = 0.7; ctx.stroke();
  const angle = frac * Math.PI * 2;
  const ill = Math.cos(angle);
  ctx.save();
  ctx.beginPath();
  ctx.arc(cx, cy, r, Math.PI / 2, -Math.PI / 2, false);
  ctx.ellipse(cx, cy, Math.abs(r * ill), r, 0, -Math.PI / 2, Math.PI / 2, ill < 0);
  ctx.closePath();
  ctx.fillStyle = dark ? 'rgba(255,250,200,0.75)' : 'rgba(255,230,110,0.88)';
  ctx.fill();
  ctx.restore();

  const nameEl = document.getElementById('moon-name');
  const pctEl  = document.getElementById('moon-pct');
  if (nameEl) nameEl.textContent = name;
  if (pctEl)  pctEl.textContent  = `${Math.round(Math.abs(Math.cos(frac * Math.PI * 2)) * 100)}% beleuchtet`;
}

async function fetchAQI() {
  try {
    const res  = await fetch(`https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${LAT}&longitude=${LNG}&current=european_aqi`);
    const data = await res.json();
    const aqi  = data?.current?.european_aqi;
    const valEl = document.getElementById('aqi-value');
    const lblEl = document.getElementById('aqi-label') as HTMLElement | null;
    if (!valEl || !lblEl || aqi == null) return;
    valEl.textContent = `AQI ${aqi}`;
    let label = '', color = '';
    if      (aqi <= 20) { label = 'Sehr gut';     color = '#4caf7d'; }
    else if (aqi <= 40) { label = 'Gut';           color = '#8bc34a'; }
    else if (aqi <= 60) { label = 'Mäßig';         color = '#ffc107'; }
    else if (aqi <= 80) { label = 'Schlecht';      color = '#ff7043'; }
    else                { label = 'Sehr schlecht'; color = '#e53935'; }
    lblEl.textContent = label;
    lblEl.style.color = color;
  } catch {
    const lblEl = document.getElementById('aqi-label');
    if (lblEl) lblEl.textContent = 'Nicht verfügbar';
  }
}

// Init
drawSunArc();
drawMoon();
fetchAQI();
setInterval(drawSunArc, 60000);
window.addEventListener('resize', drawSunArc);

document.getElementById('dm-btn')?.addEventListener('click', () => {
  setTimeout(() => { drawSunArc(); drawMoon(); }, 50);
});

// ── Infinite Circles Canvas ──────────────────────────────
const canvas = document.getElementById('circle-canvas') as HTMLCanvasElement;
if (canvas) {
  const ctx2 = canvas.getContext('2d')!;
  let W = 0, H = 0;
  const resize = () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; };
  resize();
  window.addEventListener('resize', resize);

  const rings = [
    { rf: 0.10, speed: 0.0018, offset: 0.00 },
    { rf: 0.18, speed: 0.0014, offset: 0.90 },
    { rf: 0.27, speed: 0.0011, offset: 1.80 },
    { rf: 0.37, speed: 0.0009, offset: 2.70 },
    { rf: 0.47, speed: 0.0007, offset: 3.60 },
    { rf: 0.58, speed: 0.0005, offset: 4.50 },
    { rf: 0.70, speed: 0.0004, offset: 5.40 },
  ];

  let t = 0;
  const draw = () => {
    ctx2.clearRect(0, 0, W, H);
    const dark = isDark();
    const cx = W > 768 ? W * 0.72 : W * 0.5;
    const cy = H * 0.42;
    const base = Math.min(W, H);
    const ringAlphaBase = dark ? 0.12 : 0.18;

    for (let i = 0; i < rings.length; i++) {
      const ring = rings[i];
      const r = base * ring.rf;
      ctx2.beginPath(); ctx2.arc(cx, cy, r, 0, Math.PI * 2);
      ctx2.strokeStyle = `rgba(255,255,255,${ringAlphaBase - i * 0.01})`;
      ctx2.lineWidth = 0.8; ctx2.stroke();

      const angle = t * ring.speed + ring.offset;
      const dotX = cx + Math.cos(angle) * r;
      const dotY = cy + Math.sin(angle) * r;
      const dotSize = r * 0.08;

      const glow = ctx2.createRadialGradient(dotX, dotY, 0, dotX, dotY, dotSize);
      if (dark) {
        glow.addColorStop(0,   'rgba(220,240,255,0.90)');
        glow.addColorStop(0.3, 'rgba(180,220,255,0.45)');
        glow.addColorStop(1,   'rgba(180,220,255,0)');
      } else {
        glow.addColorStop(0,   'rgba(255,255,255,0.95)');
        glow.addColorStop(0.3, 'rgba(220,235,255,0.40)');
        glow.addColorStop(1,   'rgba(220,235,255,0)');
      }
      ctx2.fillStyle = glow;
      ctx2.beginPath(); ctx2.arc(dotX, dotY, dotSize, 0, Math.PI * 2); ctx2.fill();

      const trailLength = Math.PI * 0.35;
      const trailStart = angle - trailLength;
      const trail = ctx2.createLinearGradient(
        cx + Math.cos(trailStart) * r, cy + Math.sin(trailStart) * r, dotX, dotY
      );
      const tc = dark ? '200,225,255' : '255,255,255';
      trail.addColorStop(0, `rgba(${tc},0)`);
      trail.addColorStop(1, `rgba(${tc},${dark ? 0.18 : 0.22})`);
      ctx2.beginPath(); ctx2.arc(cx, cy, r, trailStart, angle);
      ctx2.strokeStyle = trail;
      ctx2.lineWidth = dark ? 1.2 : 1.4; ctx2.stroke();
    }

    t++;
    requestAnimationFrame(draw);
  };
  draw();
}
</script>