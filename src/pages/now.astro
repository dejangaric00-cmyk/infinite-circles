---
// src/pages/now.astro
//
// War eine Musikseite: Song of the Day, letzte Stücke, ein "Jetzt"-Abschnitt.
// Das steht alles schon auf /sotd. Jetzt eine Linkliste — Orte und Werkzeuge,
// die ich wirklich benutze.
//
// Neue Einträge kommen in LINK_GROUPS. Reihenfolge = Reihenfolge auf der Seite.
import BaseLayout from '../layouts/BaseLayout.astro';
import { relativeDayLabel } from '../utils/date';

interface LinkItem {
  name: string;
  url: string;
  /** Ein Halbsatz, keine Rezension. */
  note?: string;
  /** Rechts außen, klein: Art, Ort, Sprache — was gerade passt. */
  meta?: string;
}
interface LinkGroup {
  label: string;
  items: LinkItem[];
}

const LINK_GROUPS: LinkGroup[] = [
  {
    label: 'Musik',
    items: [
      {
        name: 'Strudel',
        url: 'https://strudel.cc',
        note: 'Live-Coding im Browser. Läuft weiter unten direkt auf dieser Seite.',
        meta: 'live coding · web audio',
      },
    ],
  },
];

// Datum der letzten Handpflege dieser Seite.
const NOW_UPDATED = '2026-08-15';
---

<BaseLayout
  title="Now — Infinite Circles"
  description="Orte und Werkzeuge, die ich benutze. Manuell gepflegt."
>
<div class="now-wrap">

  <header class="now-header">
    <p class="now-eyebrow">Now — Dejan</p>
    <h1 class="now-title">Now.</h1>
    <p class="now-location">
      Zuletzt aktualisiert <span data-rel-date={NOW_UPDATED}>{relativeDayLabel(NOW_UPDATED)}</span> &middot; Hannover
    </p>
  </header>

  {LINK_GROUPS.map((group) => (
    <section class="now-section">
      <p class="zone-label">{group.label}</p>
      <div class="link-list" role="list">
        {group.items.map((item) => (
          <a class="link-row" href={item.url} target="_blank" rel="noopener noreferrer" role="listitem">
            <span class="lr-name">{item.name}</span>
            <span class="lr-note">{item.note}</span>
            <span class="lr-meta">{item.meta} <span class="lr-arrow">&#8599;</span></span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="now-section">
    <p class="zone-label">Strudel</p>
    {/* loading="lazy" statt sofort: der REPL bringt seine ganze Audio-Maschine
        mit, die soll nicht bei jedem Seitenaufruf ungefragt laden. Der Rahmen
        holt sie erst, wenn er in die Nähe des Sichtfensters kommt.
        strudel.cc erlaubt das Einbetten — nachgesehen, kein X-Frame-Options.
        frame-src steht in netlify.toml. */}
    <div class="strudel-frame">
      <iframe
        src="https://strudel.cc/?embed=1"
        title="Strudel REPL"
        loading="lazy"
        allow="autoplay"
      ></iframe>
    </div>
    <p class="strudel-note">
      Fremder Code in einem eigenen Rahmen. Ton gibt es erst nach einem Klick auf{' '}
      <em>play</em>, und <a href="https://strudel.cc" target="_blank" rel="noopener noreferrer">strudel.cc</a>{' '}
      hat mehr Platz.
    </p>
  </section>

  <p class="now-footer">
    Dies ist eine <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now Seite</a>.
    Manuell aktualisiert wenn sich etwas ändert.
  </p>

</div>
</BaseLayout>

<style>
  .now-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  /* ── Kopf ── */
  .now-header {
    margin-bottom: 4rem;
    text-align: center;
  }
  .now-eyebrow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 1rem;
  }
  .now-title {
    font-family: var(--font-serif);
    font-size: clamp(56px, 8vw, 90px);
    font-weight: 300;
    line-height: 1;
    margin: 0 0 0.75rem;
    /* color steht ausdrücklich da: bei reduzierter Bewegung friert der globale
       Block die Animation ein, dann trägt diese Farbe die Überschrift. */
    color: var(--heading);
  }
  .now-location {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    color: var(--text-dim);
    margin: 0;
  }

  /* ── Abschnitt ── */
  .now-section {
    border-top: 0.5px solid var(--border-light);
    padding-top: 2rem;
    margin-bottom: 3rem;
  }
  .zone-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 1.5rem;
  }

  /* ── Linkliste ──
     Dasselbe Muster wie "Labels & Ressourcen" auf der Radioseite: Name,
     Halbsatz, Randnotiz an einer Haarlinie. */
  .link-list { display: flex; flex-direction: column; }
  .link-row {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.8rem 0.2rem;
    border-bottom: 0.5px solid var(--border-mid);
    text-decoration: none;
    transition: background 0.2s;
  }
  .link-row:hover { background: var(--glass-bg); }
  .link-row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lr-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.1;
    color: var(--text-deep);
  }
  .lr-note {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .lr-meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .lr-arrow { color: var(--accent-ink); }

  /* ── Strudel ── */
  .strudel-frame {
    border: 1px solid var(--border-mid);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--glass-bg);
  }
  .strudel-frame iframe {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
  }
  .strudel-note {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.75;
    color: var(--text-dim);
    margin: 0.9rem 0 0;
  }
  .strudel-note em { font-family: var(--font-serif); font-size: 0.85rem; font-style: italic; }
  .strudel-note a { color: var(--accent-ink); }

  /* ── Fuß ── */
  .now-footer {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.75;
    color: var(--text-dim);
    text-align: center;
    margin: 0;
  }
  .now-footer a { color: var(--accent-ink); }

  @media (max-width: 700px) {
    .now-wrap { padding: 3rem 1.5rem 4rem; }
    .link-row { grid-template-columns: 1fr; gap: 0.3rem; }
    .lr-meta { white-space: normal; }
    .strudel-frame iframe { height: 360px; }
  }
</style>
