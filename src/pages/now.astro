---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Now – Infinite Circles">
  <main style="max-width: 680px; margin: 4rem auto; padding: 0 2rem;">
    <h1 style="font-family: var(--font-serif); font-size: 2.5rem; font-weight: 300; margin-bottom: 0.5rem; color: var(--text-deep);">Now</h1>
    <p style="font-size: 11px; color: var(--text-dim); letter-spacing: .08em; margin-bottom: 3rem;">Updated April 2026 · Hannover</p>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;">Listening</h2>
      <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; line-height: 1.9; color: var(--text-deep);">One song a day on display.</p>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;">Playing</h2>
      <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; line-height: 1.9; color: var(--text-deep);">Pixels</p>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;">Building</h2>
      <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; line-height: 1.9; color: var(--text-deep);">Slowly figuring out my personal context window.</p>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;">Context Window</h2>
      <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; line-height: 1.9; color: var(--text-deep);">47K tokens · <em>expanding</em></p>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem;">Reading</h2>
      <p style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 300; line-height: 1.9; color: var(--text-deep);">The Web. Favourites and books coming — the good ones take time to surface.</p>
    </section>

    <p style="font-size: 10px; color: var(--text-dim); margin-top: 3rem;">This is a <a href="https://nownownow.com/about" target="_blank" style="color: var(--accent); text-decoration: none;">/now page</a>. Updated manually when things change.</p>
  </main>
</BaseLayout>

<style>
body { background: var(--sky-top); position: relative; }
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 40%, var(--sky-bot) 100%);
  z-index: -2;
  pointer-events: none;
}
</style>