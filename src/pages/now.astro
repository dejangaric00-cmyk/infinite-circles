---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedSotd } from '../utils/sotd';
import { getMoodDot } from '../utils/mood';

const sorted = await getSortedSotd();
const latest = sorted[0];
const recent = sorted.slice(1, 7);

const totalTracks = sorted.length;
const totalLabels = [...new Set(sorted.map(e => e.data.label).filter(Boolean))].length;
const years = sorted.map(e => e.data.year).filter(Boolean) as number[];
const yearRange = years.length > 0 ? Math.min(...years) + '–' + Math.max(...years) : '';

// Update this date whenever you manually update the /now page
const NOW_UPDATED = '2026-04-01';
---

<BaseLayout title="Now – Infinite Circles">
<div class="now-wrap">

  <header class="now-header">
    <div class="now-eyebrow">Now — Dejan</div>
    <h1 class="now-title">Now.</h1>
    <p class="now-location" id="updated-line">Hannover</p>
  </header>

  <section class="now-section">
    <div class="zone-label">Musik</div>

    <div class="sotd-stats-row">
      <div class="stat-pill">{totalTracks} tracks</div>
      {totalLabels > 0 && <div class="stat-pill">{totalLabels} labels</div>}
      {yearRange && <div class="stat-pill">{yearRange}</div>}
      <a href="/sotd/rss.xml" class="stat-pill stat-pill-rss">RSS</a>
    </div>

    {latest && (
      <a href={`/sotd/${latest.id}`} class="now-latest-track">
        <div class="nlt-label">heute</div>
        <div class="nlt-title">{latest.data.title}</div>
        <div class="nlt-artist">{latest.data.artist}</div>
        {latest.data.note && <div class="nlt-note">{latest.data.note}</div>}
      </a>
    )}

    <div class="recent-list">
      {recent.map(entry => (
        <a href={`/sotd/${entry.id}`} class="recent-item">
          <span class="recent-dot" style={`background: ${getMoodDot(entry.data.mood)}`}></span>
          <span class="recent-date">{entry.data.date}</span>
          <span class="recent-title">{entry.data.title}</span>
          <span class="recent-artist">{entry.data.artist}</span>
        </a>
      ))}
    </div>

    <a href="/sotd" class="all-link">Alle Songs →</a>
  </section>

  <section class="now-section">
    <div class="zone-label">Jetzt</div>
    <div class="now-items">
      <div class="now-item">
        <div class="now-item-label">Lernend</div>
        <div class="now-item-text">Strudel &mdash; Coding Music.</div>
      </div>
      <div class="now-item">
        <div class="now-item-label">N&auml;chstes Ziel</div>
        <div class="now-item-text">Mittelmeer.</div>
      </div>
    </div>
  </section>

  <section class="now-section">
    <div class="zone-label">Site Puls</div>
    <div class="umami-grid">
      <div class="umami-card">
        <div class="umami-val" id="val-views">—</div>
        <div class="umami-key">Pageviews · 7 Tage</div>
      </div>
      <div class="umami-card">
        <div class="umami-val" id="val-visitors">—</div>
        <div class="umami-key">Besucher · 7 Tage</div>
      </div>
      <div class="umami-card">
        <div class="umami-val" id="val-sotd">—</div>
        <div class="umami-key">SOTD-Aufrufe · 7 Tage</div>
      </div>
      <div class="umami-card">
        <div class="umami-val umami-val-sm" id="val-top">—</div>
        <div class="umami-key">Beliebteste Seite</div>
      </div>
    </div>
    <div class="umami-status" id="umami-status">Lade Daten…</div>
  </section>

  <p class="now-footer">
    Dies ist eine <a href="https://nownownow.com/about" target="_blank" rel="noopener">/now Seite</a>.
    Manuell aktualisiert wenn sich etwas ändert.
  </p>

</div>
</BaseLayout>

<style is:global>
.now-wrap {
  max-width: 640px;
  margin: 0 auto;
  padding: 4rem 2rem 6rem;
}
.now-header {
  margin-bottom: 4rem;
  text-align: center;
}
.now-eyebrow {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}
.now-title {
  font-family: var(--font-serif);
  font-size: clamp(56px, 8vw, 90px);
  font-weight: 300;
  line-height: 1;
  margin-bottom: 0.75rem;
  animation: color-breathe 3.8s ease-in-out infinite;
}
.now-location {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--text-dim);
}
@keyframes color-breathe {
  0%   { color: #1a6bb5; }
  50%  { color: #87ceeb; }
  100% { color: #1a6bb5; }
}
html.dark .now-title {
  animation-name: color-breathe-dark;
}
@keyframes color-breathe-dark {
  0%   { color: #7ab8f0; }
  50%  { color: #b8dff8; }
  100% { color: #7ab8f0; }
}
.now-section {
  border-top: 0.5px solid var(--border-light);
  padding-top: 2rem;
  margin-bottom: 3rem;
}
.zone-label {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--accent);
  opacity: 0.7;
  margin-bottom: 1.5rem;
}
.sotd-stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 1.5rem;
}
.stat-pill {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .08em;
  padding: 3px 10px;
  border: 0.5px solid var(--border-mid);
  border-radius: 20px;
  color: var(--text-dim);
  text-decoration: none;
}
.stat-pill-rss {
  color: var(--accent);
  border-color: var(--accent);
  opacity: 0.7;
}
.now-latest-track {
  display: block;
  text-decoration: none;
  padding: 1rem 1.25rem;
  border: 0.5px solid var(--glass-border);
  border-radius: 10px;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  margin-bottom: 1.25rem;
  transition: border-color 0.15s, background 0.15s;
}
.now-latest-track:hover {
  border-color: var(--accent);
  background: var(--glass-bg-strong);
}
.nlt-label {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--accent);
  opacity: 0.7;
  margin-bottom: 0.4rem;
}
.nlt-title {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 300;
  color: var(--text-deep);
  line-height: 1.2;
  margin-bottom: 2px;
}
.nlt-artist {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
  opacity: 0.8;
  margin-bottom: 0.4rem;
}
.nlt-note {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  font-style: italic;
  color: var(--text-dim);
}
.recent-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 1rem;
}
.recent-item {
  display: grid;
  grid-template-columns: 10px 90px 1fr auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.55rem 0;
  border-bottom: 0.5px solid var(--border-light);
  text-decoration: none;
  transition: opacity 0.15s;
}
.recent-item:hover { opacity: 0.7; }
.recent-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}
.recent-date {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .08em;
  color: var(--text-dim);
  white-space: nowrap;
}
.recent-title {
  font-family: var(--font-serif);
  font-size: 0.95rem;
  font-weight: 300;
  color: var(--text-deep);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.recent-artist {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-dim);
  white-space: nowrap;
}
.all-link {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .1em;
  color: var(--text-dim);
  text-decoration: none;
  transition: color 0.15s;
  display: inline-block;
  margin-top: 0.5rem;
}
.all-link:hover { color: var(--accent); }
.now-items {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.now-item-label {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.3rem;
}
.now-item-text {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  font-weight: 300;
  color: var(--text-deep);
  line-height: 1.5;
}
.now-item-text em { font-style: italic; color: var(--accent); }
.umami-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 0.5px solid var(--border-mid);
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 0.75rem;
}
.umami-card {
  padding: 1.1rem 1.25rem;
  background: var(--glass-bg);
  display: flex;
  flex-direction: column;
  gap: 4px;
  border-right: 0.5px solid var(--border-mid);
  border-bottom: 0.5px solid var(--border-mid);
}
.umami-card:nth-child(even) { border-right: none; }
.umami-card:nth-last-child(1),
.umami-card:nth-last-child(2) { border-bottom: none; }
.umami-val {
  font-family: var(--font-serif);
  font-size: 2rem;
  font-weight: 300;
  color: var(--text-deep);
  line-height: 1;
}
.umami-val-sm {
  font-size: 1rem;
  line-height: 1.3;
}
.umami-key {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-dim);
}
.umami-status {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--text-dim);
  opacity: 0.5;
  text-align: center;
}
.now-footer {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .05em;
  color: var(--text-dim);
  text-align: center;
  margin-top: 2rem;
  border-top: 0.5px solid var(--border-light);
  padding-top: 2rem;
}
.now-footer a {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 0.5px solid currentColor;
  padding-bottom: 1px;
}
@media (max-width: 600px) {
  .now-wrap { padding: 2.5rem 1.5rem 4rem; }
  .umami-grid { grid-template-columns: 1fr; }
  .umami-card { border-right: none !important; }
  .umami-card:nth-last-child(2) { border-bottom: 0.5px solid var(--border-mid) !important; }
  .recent-item { grid-template-columns: 10px 1fr auto; }
  .recent-date { display: none; }
}
</style>

<script define:vars={{ NOW_UPDATED }}>
const el = document.getElementById('updated-line');
if (el) {
  const updated = new Date(NOW_UPDATED);
  const now = new Date();
  const days = Math.floor((now.getTime() - updated.getTime()) / (1000*60*60*24));
  const rel = days === 0 ? 'heute' : days === 1 ? 'gestern' : days < 7 ? `vor ${days} Tagen` : days < 14 ? 'vor einer Woche' : days < 30 ? `vor ${Math.floor(days/7)} Wochen` : `vor ${Math.floor(days/30)} Monaten`;
  el.textContent = `Zuletzt aktualisiert ${rel} · Hannover`;
}

async function loadUmami() {
  const status = document.getElementById('umami-status');
  try {
    const now = Date.now();
    const weekAgo = now - 7*24*60*60*1000;
    const id = '65f41a88-359f-4090-ac4e-82be88099cbd';
    // NOTE: API key should ideally be proxied via an Astro endpoint.
    // For now kept client-side; replace with a /api/stats endpoint when possible.
    const key = 'api_zmZNQXF9MVaQKCIvaPTCobtlYfEwjH6S';

    const [statsRes, pagesRes] = await Promise.all([
      fetch(`https://api.umami.is/v1/websites/${id}/stats?startAt=${weekAgo}&endAt=${now}`, { headers: { 'x-umami-api-key': key } }),
      fetch(`https://api.umami.is/v1/websites/${id}/metrics?startAt=${weekAgo}&endAt=${now}&type=url&limit=10`, { headers: { 'x-umami-api-key': key } }),
    ]);

    if (statsRes.ok) {
      const stats = await statsRes.json();
      const vv = document.getElementById('val-views');
      const vvs = document.getElementById('val-visitors');
      if (vv)  vv.textContent  = (stats.pageviews?.value  ?? 0).toLocaleString('de-DE');
      if (vvs) vvs.textContent = (stats.visitors?.value   ?? 0).toLocaleString('de-DE');
    }

    if (pagesRes.ok) {
      const pages = await pagesRes.json();
      const sotd = pages.filter((p) => p.x?.startsWith('/sotd/') && p.x !== '/sotd');
      const vs = document.getElementById('val-sotd');
      if (vs) vs.textContent = sotd.reduce((s, p) => s + (p.y ?? 0), 0).toLocaleString('de-DE');
      const top = pages[0];
      const vt = document.getElementById('val-top');
      if (vt && top) vt.textContent = top.x ?? '—';
    }

    if (status) status.textContent = 'Umami Analytics · letzte 7 Tage';
  } catch {
    if (status) status.textContent = 'Statistiken konnten nicht geladen werden.';
  }
}

loadUmami();
</script>
