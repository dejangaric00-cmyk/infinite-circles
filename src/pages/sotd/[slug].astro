---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('sotd');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, artist, album, link, mood, note, date, tags } = entry.data;

function getYouTubeId(url: string): string | null {
  const m = url.match(/(?:v=|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  return m ? m[1] : null;
}

const vid = link ? getYouTubeId(link) : null;

const allEntries = await getCollection('sotd');
const sorted = allEntries.sort((a, b) => b.data.date.localeCompare(a.data.date));
const idx = sorted.findIndex(e => e.id === entry.id);
const prev = sorted[idx + 1] ?? null;
const next = sorted[idx - 1] ?? null;
---

<BaseLayout title={`${title} — ${artist} · SOTD`} description={note ?? `${title} by ${artist}`}>
  <div class="sotd-single">

    <div class="back-row">
      <a href="/sotd" class="back-link">← Song of the Day</a>
      <span class="entry-date">{date}</span>
    </div>

    <div class="track-layout">

      <!-- LEFT: Visual -->
      <div class="track-visual">
        {vid ? (
          <div class="yt-wrap">
            <div class="yt-thumb" id="yt-thumb">
              <img src={`https://img.youtube.com/vi/${vid}/maxresdefault.jpg`} alt={title} />
              <div class="play-overlay">
                <div class="play-btn"><div class="play-tri"></div></div>
              </div>
            </div>
            <div class="yt-player" id="yt-player"></div>
          </div>
        ) : (
          <div class="no-thumb">
            <span class="no-thumb-initial">{artist[0]}</span>
          </div>
        )}

        <!-- Nav between tracks -->
        <div class="track-nav">
          {prev && (
            <a href={`/sotd/${prev.id}`} class="track-nav-btn">
              <span class="nav-dir">← früher</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a href={`/sotd/${next.id}`} class="track-nav-btn track-nav-right">
              <span class="nav-dir">später →</span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          )}
        </div>
      </div>

      <!-- RIGHT: Info -->
      <div class="track-info">
        <div class="track-meta-top">
          {mood && <span class="mood-tag">{mood}</span>}
          {tags && tags.map(t => <span class="mood-tag tag-secondary">{t}</span>)}
        </div>

        <h1 class="track-title">{title}</h1>
        <div class="track-artist">{artist}</div>
        {album && <div class="track-album">{album}</div>}

        {note && (
          <div class="track-note-wrap">
            <div class="note-label">Notiz</div>
            <p class="track-note">{note}</p>
          </div>
        )}

        {link && (
          <a href={link} target="_blank" rel="noopener" class="yt-link">
            Auf YouTube öffnen ↗
          </a>
        )}
      </div>

    </div>
  </div>
</BaseLayout>

<style is:global>
.sotd-single {
  max-width: 1000px;
  margin: 0 auto;
  padding: 3rem 2rem 6rem;
}

.back-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rem;
}

.back-link {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--text-dim);
  text-decoration: none;
  transition: var(--t);
}
.back-link:hover { color: var(--accent); }

.entry-date {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-dim);
}

/* Layout */
.track-layout {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: start;
}

/* Visual side */
.track-visual { display: flex; flex-direction: column; gap: 2rem; }

.yt-wrap { width: 100%; }
.yt-thumb {
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
  background: #000;
  aspect-ratio: 16/9;
  border: 0.5px solid var(--glass-border);
}
.yt-thumb img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: opacity .25s;
}
.yt-thumb:hover img { opacity: .7; }
.play-overlay {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none;
}
.play-btn {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(255,255,255,.92);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 20px rgba(0,0,0,.3);
  transition: transform .15s;
}
.yt-thumb:hover .play-btn { transform: scale(1.08); }
.play-tri {
  width: 0; height: 0; border-style: solid;
  border-width: 9px 0 9px 16px;
  border-color: transparent transparent transparent #111;
  margin-left: 3px;
}
.yt-player { display: none; width: 100%; border-radius: 10px; overflow: hidden; background: #000; }
.yt-player.open { display: block; }
.yt-player iframe { width: 100%; border: none; display: block; }

.no-thumb {
  aspect-ratio: 16/9;
  border-radius: 10px;
  background: var(--glass-bg);
  border: 0.5px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
}
.no-thumb-initial {
  font-family: var(--font-serif);
  font-size: 80px;
  font-weight: 300;
  color: var(--text-dim);
}

/* Track nav */
.track-nav {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
}
.track-nav-btn {
  display: flex;
  flex-direction: column;
  gap: 2px;
  text-decoration: none;
  max-width: 45%;
}
.track-nav-right { align-items: flex-end; text-align: right; }
.nav-dir {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text-dim);
  transition: var(--t);
}
.nav-title {
  font-family: var(--font-serif);
  font-size: 14px;
  font-weight: 300;
  color: var(--text-mid);
  transition: var(--t);
  line-height: 1.3;
}
.track-nav-btn:hover .nav-dir,
.track-nav-btn:hover .nav-title { color: var(--accent); }

/* Info side */
.track-info {
  padding-top: 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.track-meta-top {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-bottom: 1.5rem;
}
.mood-tag {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: 3px 10px;
  border: 0.5px solid var(--glass-border);
  border-radius: 20px;
  color: var(--text-dim);
}
.tag-secondary {
  border-color: var(--border-mid);
}

.track-title {
  font-family: var(--font-serif);
  font-size: clamp(36px, 5vw, 58px);
  font-weight: 300;
  line-height: 1.05;
  color: var(--text-deep);
  margin-bottom: 0.6rem;
}

.track-artist {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.25rem;
}

.track-album {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-dim);
  margin-bottom: 1rem;
}

.track-note-wrap {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid var(--border-light);
}
.note-label {
  font-family: var(--font-mono);
  font-size: 8px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 0.75rem;
}
.track-note {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 2;
  color: var(--text-mid);
}

.yt-link {
  display: inline-block;
  margin-top: 2rem;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .08em;
  color: var(--text-dim);
  text-decoration: none;
  transition: var(--t);
  border-bottom: 0.5px solid transparent;
  padding-bottom: 1px;
}
.yt-link:hover { color: var(--accent); border-bottom-color: var(--accent); }

@media (max-width: 768px) {
  .track-layout { grid-template-columns: 1fr; gap: 2rem; }
  .sotd-single { padding: 2rem 1.5rem 4rem; }
}
</style>

<script>
const thumb = document.getElementById('yt-thumb') as HTMLElement | null;
const player = document.getElementById('yt-player') as HTMLElement | null;

thumb?.addEventListener('click', () => {
  const vid = thumb.querySelector('img')?.src.match(/\/vi\/([^/]+)\//)?.[1];
  if (!vid || !player) return;
  const w = thumb.offsetWidth;
  const h = Math.round(w * 9 / 16);
  player.style.height = h + 'px';
  player.innerHTML = `<iframe width="${w}" height="${h}" src="https://www.youtube.com/embed/${vid}?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
  player.classList.add('open');
  thumb.style.display = 'none';
});
</script>