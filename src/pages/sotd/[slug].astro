---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedSotd } from '../../utils/sotd';
import { getYouTubeId } from '../../utils/youtube';

export async function getStaticPaths() {
  // Use shared util — single source of truth for sort order
  const sorted = await getSortedSotd();
  return sorted.map((entry, idx) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[idx + 1] ?? null,
      next: sorted[idx - 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { title, artist, album, link, mood, note, date, tags, year, label } = entry.data;
const vid = link ? getYouTubeId(link) : null;

// Use YouTube thumbnail as og:image when available, fallback to site icon
const ogImage = vid
  ? `https://img.youtube.com/vi/${vid}/hqdefault.jpg`
  : 'https://infinite-circles.de/icon-512.png';

const canonical = `https://infinite-circles.de/sotd/${entry.id}`;

const schema = {
  '@type': 'MusicRecording',
  '@id': `${canonical}#recording`,
  name: title,
  url: canonical,
  byArtist: { '@type': 'MusicGroup', name: artist },
  ...(album && { inAlbum: { '@type': 'MusicAlbum', name: album } }),
  ...(label && { recordLabel: { '@type': 'Organization', name: label } }),
  ...(year && { datePublished: String(year) }),
  ...(mood && { genre: mood }),
  ...(note && { description: note }),
  ...(vid && { image: `https://img.youtube.com/vi/${vid}/maxresdefault.jpg` }),
  ...(link && { sameAs: link }),
  isPartOf: { '@id': 'https://infinite-circles.de/#website' },
};
---

<BaseLayout
  title={`${title} — ${artist} · SOTD`}
  description={note ?? `${title} von ${artist}`}
  ogImage={ogImage}
  ogType="music.song"
  schema={schema}
>
  <div class="sotd-single">

    <div class="back-row">
      <a href="/sotd" class="back-link">← Song of the Day</a>
      <span class="entry-date">{date}</span>
    </div>

    <div class="track-layout">

      <!-- LEFT: Visual -->
      <div class="track-visual">
        {vid ? (
          <div class="yt-wrap">
            <div class="yt-thumb" id="yt-thumb" data-vid={vid}>
              <!-- maxresdefault with onerror fallback to hqdefault -->
              <img
                src={`https://img.youtube.com/vi/${vid}/maxresdefault.jpg`}
                alt={title}
                width="640" height="360"
                onerror={`this.src='https://img.youtube.com/vi/${vid}/hqdefault.jpg'`}
              />
              <div class="play-overlay">
                <div class="play-btn"><div class="play-tri"></div></div>
              </div>
            </div>
            <div class="yt-player" id="yt-player"></div>
          </div>
        ) : (
          <div class="no-thumb">
            <span class="no-thumb-initial">{artist[0]}</span>
          </div>
        )}

        <!-- Nav between tracks -->
        <div class="track-nav">
          {prev && (
            <a href={`/sotd/${prev.id}`} class="track-nav-btn">
              <span class="nav-dir">← früher</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          )}
          {next && (
            <a href={`/sotd/${next.id}`} class="track-nav-btn track-nav-right">
              <span class="nav-dir">später →</span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          )}
        </div>
      </div>

      <!-- RIGHT: Info -->
      <div class="track-info">
        <div class="track-meta-top">
          {mood && <span class="mood-tag">{mood}</span>}
          {tags && tags.map(t => <span class="mood-tag tag-secondary">{t}</span>)}
        </div>

        <h1 class="track-title">{title}</h1>
        <div class="track-artist">{artist}</div>
        {album && <div class="track-album">{album}</div>}
        {(year || label) && (
          <div class="track-detail-meta">
            {[year, label].filter(Boolean).join(' · ')}
          </div>
        )}

        {note && (
          <div class="track-note-wrap">
            <div class="note-label">Notiz</div>
            <p class="track-note">{note}</p>
          </div>
        )}

        {link && (
          <a href={link} target="_blank" rel="noopener" class="yt-link">
            Auf YouTube öffnen ↗
          </a>
        )}
      </div>

    </div>
  </div>
</BaseLayout>

<style>
.sotd-single {
  max-width: 1000px;
  margin: 0 auto;
  padding: 3rem 2rem 6rem;
}

.back-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rem;
}

.back-link {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: .1em;
  color: var(--text-dim);
  text-decoration: none;
  transition: var(--t);
}
.back-link:hover { color: var(--accent); }

.entry-date {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-dim);
}

.track-layout {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 4rem;
  align-items: start;
}

.track-visual { display: flex; flex-direction: column; gap: 2rem; }

.yt-wrap { width: 100%; }
.yt-thumb {
  position: relative; border-radius: 10px; overflow: hidden; cursor: pointer;
  background: #000; aspect-ratio: 16/9; border: 0.5px solid var(--glass-border);
}
.yt-thumb img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; transition: opacity .25s;
}
.yt-thumb:hover img { opacity: .7; }
.play-overlay {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center; pointer-events: none;
}
.play-btn {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(255,255,255,.92);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 20px rgba(0,0,0,.3); transition: transform .15s;
}
.yt-thumb:hover .play-btn { transform: scale(1.08); }
.play-tri {
  width: 0; height: 0; border-style: solid;
  border-width: 9px 0 9px 16px;
  border-color: transparent transparent transparent #111; margin-left: 3px;
}
.yt-player { display: none; width: 100%; border-radius: 10px; overflow: hidden; background: #000; }
.yt-player.open { display: block; }
.yt-player iframe { width: 100%; border: none; display: block; }

.no-thumb {
  aspect-ratio: 16/9; border-radius: 10px;
  background: var(--glass-bg); border: 0.5px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
}
.no-thumb-initial {
  font-family: var(--font-serif); font-size: 80px; font-weight: 300; color: var(--text-dim);
}

.track-nav { display: flex; justify-content: space-between; gap: 1rem; }
.track-nav-btn {
  display: flex; flex-direction: column; gap: 2px;
  text-decoration: none; max-width: 45%;
}
.track-nav-right { align-items: flex-end; text-align: right; }
.nav-dir {
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--text-dim); transition: var(--t);
}
.nav-title {
  font-family: var(--font-serif); font-size: 14px; font-weight: 300;
  color: var(--text-mid); transition: var(--t); line-height: 1.3;
}
.track-nav-btn:hover .nav-dir,
.track-nav-btn:hover .nav-title { color: var(--accent); }

.track-info { padding-top: 0.5rem; display: flex; flex-direction: column; gap: 0; }

.track-meta-top { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 1.5rem; }
.mood-tag {
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .14em;
  text-transform: uppercase; padding: 3px 10px;
  border: 0.5px solid var(--glass-border); border-radius: 20px; color: var(--text-dim);
}
.tag-secondary { border-color: var(--border-mid); }

.track-title {
  font-family: var(--font-serif); font-size: clamp(36px, 5vw, 58px); font-weight: 300;
  line-height: 1.05; color: var(--text-deep); margin-bottom: 0.6rem;
}

.track-artist {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em;
  text-transform: uppercase; color: var(--accent); margin-bottom: 0.25rem;
}

.track-album { font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); margin-bottom: 0.25rem; }
.track-detail-meta {
  font-family: var(--font-mono); font-size: 8.5px; letter-spacing: .08em;
  color: var(--text-dim); opacity: 0.55; margin-bottom: 1rem;
}

.track-note-wrap { margin-top: 2rem; padding-top: 1.5rem; border-top: 0.5px solid var(--border-light); }
.note-label {
  font-family: var(--font-mono); font-size: 8px; letter-spacing: .18em;
  text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.75rem;
}
.track-note {
  font-family: var(--font-serif); font-size: clamp(18px, 3vw, 26px); font-weight: 300;
  font-style: italic; line-height: 1.6; color: var(--text-deep);
}

.yt-link {
  display: inline-block; margin-top: 2rem;
  font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em;
  color: var(--text-dim); text-decoration: none; transition: var(--t);
  border-bottom: 0.5px solid transparent; padding-bottom: 1px;
}
.yt-link:hover { color: var(--accent); border-bottom-color: var(--accent); }

@media (max-width: 768px) {
  .track-layout { grid-template-columns: 1fr; gap: 2rem; }
  .sotd-single { padding: 2rem 1.5rem 4rem; }
}
</style>

<script>
const thumb = document.getElementById('yt-thumb') as HTMLElement | null;
const player = document.getElementById('yt-player') as HTMLElement | null;

thumb?.addEventListener('click', () => {
  const vid = thumb.dataset.vid;
  if (!vid || !player) return;
  const w = thumb.offsetWidth;
  const h = Math.round(w * 9 / 16);
  player.style.height = h + 'px';
  player.innerHTML = `<iframe width="${w}" height="${h}" src="https://www.youtube.com/embed/${vid}?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
  player.classList.add('open');
  thumb.style.display = 'none';
});

// J/K keyboard navigation
document.addEventListener('keydown', (e) => {
  if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
  const prevLink = document.querySelector<HTMLAnchorElement>('.track-nav-btn:not(.track-nav-right)');
  const nextLink = document.querySelector<HTMLAnchorElement>('.track-nav-btn.track-nav-right');
  if (e.key === 'j' || e.key === 'J') nextLink && (window.location.href = nextLink.href);
  if (e.key === 'k' || e.key === 'K') prevLink && (window.location.href = prevLink.href);
});
</script>
