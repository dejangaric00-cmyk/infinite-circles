---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedSotd } from '../../utils/sotd';
import { getYouTubeId } from '../../utils/youtube';
import { getMoodColor } from '../../utils/mood';
import { relativeDayLabel } from '../../utils/date';

const sorted = await getSortedSotd();

const moods = [...new Set(sorted.map(e => e.data.mood).filter(Boolean))].sort() as string[];
const artists = [...new Set(sorted.map(e => e.data.artist))].sort();
const decades = [...new Set(sorted.map(e => e.data.year).filter(Boolean).map(y => `${Math.floor(y! / 10) * 10}s`))].sort();

// Computed in frontmatter — no IIFE in template
const years = sorted.map(e => e.data.year).filter(Boolean) as number[];
const yearRange = years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : '';
const uniqueLabels = [...new Set(sorted.map(e => e.data.label).filter(Boolean))].length;

// Gruppierung nach Monat
type SotdEntry = typeof sorted[0];
const grouped = sorted.reduce<Record<string, SotdEntry[]>>((acc, entry) => {
  // Explicit UTC parsing to avoid timezone off-by-one
  const [y, m] = entry.data.date.split('-').map(Number);
  const key = new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('de-DE', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(entry);
  return acc;
}, {});
---

<BaseLayout title="Song of the Day — Infinite Circles" description="Jeden Tag ein Song.">
<div class="page-sotd">

  <section class="sotd-header reveal">
    <div class="section-label">Song of the Day</div>
    <h1>Ein Song,<br><em>jeden Tag.</em></h1>
    <p class="header-desc">
      {sorted.length} Tracks
      {uniqueLabels > 0 && <>&middot; {uniqueLabels} Labels</>}
      {yearRange && <>&middot; {yearRange}</>}
    </p>
    <button class="random-btn" id="random-btn">Zufälliger Track ↝</button>
  </section>

  {/* FEATURED PLAYER */}
  {(() => {
    const latest = sorted[0];
    const vid = latest?.data.link ? getYouTubeId(latest.data.link) : null;
    if (!latest) return null;
    return (
      <div class="featured reveal" style="transition-delay:.05s">
        <div class="featured-inner">
          <div class="featured-info">
            <div class="featured-eyebrow" data-rel-date={latest.data.date}>{relativeDayLabel(latest.data.date)}</div>
            <a href={`/sotd/${latest.id}`} class="featured-title-link">
              <div class="featured-title">{latest.data.title} · {latest.data.artist}</div>
            </a>
          </div>
          {vid ? (
            <div class="featured-video">
              <div class="featured-thumb" id="featured-thumb" data-vid={vid}>
                <img
                  src={`https://img.youtube.com/vi/${vid}/hqdefault.jpg`}
                  alt={latest.data.title}
                  width="480" height="360"
                />
                <div class="featured-play">
                  <div class="featured-play-btn"><div class="featured-play-tri"></div></div>
                </div>
              </div>
              <div class="featured-player" id="featured-player"></div>
            </div>
          ) : (
            <div class="featured-no-video">
              <span>{latest.data.artist[0]}</span>
            </div>
          )}
        </div>
      </div>
    );
  })()}

  {/* FILTER BAR */}
  <div class="filter-bar reveal" style="transition-delay:.08s">
    <div class="filter-group">
      <span class="filter-label">Mood</span>
      <div class="filter-pills" id="mood-pills">
        <button class="pill pill-active" data-filter="mood" data-value="">Alle</button>
        {moods.map(m => (
          <button class="pill" data-filter="mood" data-value={m}>{m}</button>
        ))}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">Artist</span>
      <div class="filter-pills" id="artist-pills">
        <button class="pill pill-active" data-filter="artist" data-value="">Alle</button>
        {artists.map(a => (
          <button class="pill" data-filter="artist" data-value={a}>{a}</button>
        ))}
      </div>
    </div>
    {decades.length > 0 && (
      <div class="filter-group">
        <span class="filter-label">Dekade</span>
        <div class="filter-pills" id="decade-pills">
          <button class="pill pill-active" data-filter="decade" data-value="">Alle</button>
          {decades.map(d => (
            <button class="pill" data-filter="decade" data-value={d}>{d}</button>
          ))}
        </div>
      </div>
    )}
  </div>

  <section class="sotd-list" id="sotd-list">
    {Object.entries(grouped).map(([month, monthEntries]) => (
      <div class="sotd-month-group">
        <div class="sotd-month-label">{month}</div>
        {monthEntries.map((entry, i) => {
          const vid = entry.data.link ? getYouTubeId(entry.data.link) : null;
          return (
            <div
              class="sotd-item reveal"
              style={`transition-delay:${i * 0.04}s`}
              data-mood={entry.data.mood ?? ''}
              data-artist={entry.data.artist}
              data-id={entry.id}
              data-decade={entry.data.year ? `${Math.floor(entry.data.year / 10) * 10}s` : ''}
            >
              <div class="sotd-item-left" style={`background: ${getMoodColor(entry.data.mood)}; border-radius: 8px; padding: 0.75rem;`}>
                <div class="sotd-item-date">{entry.data.date}</div>
                {vid && (
                  <a href={`/sotd/${entry.id}`} class="yt-thumb-link">
                    <div class="yt-thumb">
                      <img
                        src={`https://img.youtube.com/vi/${vid}/mqdefault.jpg`}
                        alt={entry.data.title}
                        loading="lazy"
                        width="320" height="180"
                      />
                      <div class="yt-thumb-play">
                        <div class="yt-thumb-btn"><div class="yt-thumb-tri"></div></div>
                      </div>
                    </div>
                  </a>
                )}
              </div>
              <div class="sotd-item-right">
                <a href={`/sotd/${entry.id}`} class="sotd-title-link">
                  <div class="sotd-item-title">{entry.data.title}</div>
                </a>
                <div class="sotd-item-artist">{entry.data.artist}</div>
                {entry.data.album && <div class="sotd-item-album">{entry.data.album}</div>}
                {(entry.data.year || entry.data.label || entry.data.mood) && (
                  <div class="sotd-item-meta">
                    {[entry.data.year, entry.data.label, entry.data.mood].filter(Boolean).join(' · ')}
                  </div>
                )}
                <div class="sotd-badges">
                  {entry.data.mood && <span class="sotd-item-mood">{entry.data.mood}</span>}
                  {entry.data.tags && entry.data.tags.map(t => <span class="sotd-item-mood sotd-tag">{t}</span>)}
                </div>
                {entry.data.note && <p class="sotd-item-note">{entry.data.note}</p>}
              </div>
            </div>
          );
        })}
      </div>
    ))}
  </section>

  <div class="no-results" id="no-results" style="display:none">
    <span>Keine Einträge für diesen Filter.</span>
  </div>

</div>
</BaseLayout>

<style>
.page-sotd {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2rem;
}
.sotd-header {
  padding: 5rem 0 3.5rem;
  border-bottom: 0.5px solid var(--border-light);
  margin-bottom: 2.5rem;
}
.section-label {
  font-size: 9px;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--accent-ink);
  margin-bottom: 1.5rem;
}
.section-label::before { content: '·'; margin-right: .45em; font-size: 1.4em; line-height: 0; vertical-align: middle; }
h1 {
  font-family: var(--font-serif);
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 300;
  line-height: 1.05;
  color: var(--heading);
  margin-bottom: 1rem;
}
h1 em { font-style: italic; color: inherit; }
.header-desc {
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: .06em;
  margin-bottom: 1.25rem;
}
.random-btn {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  padding: 6px 16px;
  border: 0.5px solid var(--glass-border);
  border-radius: 20px;
  background: transparent;
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.15s ease;
  display: inline-block;
}
.random-btn:hover { color: var(--accent-ink); border-color: var(--accent); }

/* FEATURED */
.featured { margin-bottom: 2.5rem; }
.featured-inner {
  display: flex; flex-direction: column; gap: 1.25rem;
  padding: 2rem 0; border-bottom: 0.5px solid var(--border-light);
}
.featured-video { width: 100%; }
.featured-thumb {
  position: relative; border-radius: 10px; overflow: hidden; cursor: pointer;
  background: #000; aspect-ratio: 16/9; border: 0.5px solid var(--glass-border);
}
.featured-thumb img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; transition: opacity .25s;
}
.featured-thumb:hover img { opacity: .7; }
.featured-play {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center; pointer-events: none;
}
.featured-play-btn {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(255,255,255,.92);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 20px rgba(0,0,0,.3); transition: transform .15s;
}
.featured-thumb:hover .featured-play-btn { transform: scale(1.08); }
.featured-play-tri {
  width: 0; height: 0; border-style: solid;
  border-width: 9px 0 9px 16px;
  border-color: transparent transparent transparent #111; margin-left: 3px;
}
.featured-player { display: none; width: 100%; border-radius: 10px; overflow: hidden; background: #000; }
.featured-player.open { display: block; }
.featured-player iframe { width: 100%; border: none; display: block; }
.featured-no-video {
  aspect-ratio: 16/9; border-radius: 10px;
  background: var(--glass-bg); border: 0.5px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-serif); font-size: 60px; color: var(--text-dim);
}
.featured-info {
  display: flex; flex-direction: row; align-items: baseline;
  justify-content: center; flex-wrap: wrap; gap: 0.5rem 1.5rem; text-align: center;
}
.featured-eyebrow {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .22em;
  text-transform: uppercase; color: var(--accent-ink); margin-bottom: 0.4rem;
}
.featured-title-link { text-decoration: none; }
.featured-title {
  font-family: var(--font-serif); font-size: 28px; font-weight: 300;
  line-height: 1.05; color: var(--text-deep); transition: color 0.15s;
}
.featured-title-link:hover .featured-title { color: var(--accent-ink); }

/* FILTER */
.filter-bar {
  display: flex; flex-direction: column; gap: 0.75rem;
  margin-bottom: 3rem; padding-bottom: 2rem;
  border-bottom: 0.5px solid var(--border-light);
}
.filter-group { display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
.filter-label {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .18em;
  text-transform: uppercase; color: var(--text-dim); padding-top: 4px; min-width: 40px;
}
.filter-pills { display: flex; flex-wrap: wrap; gap: 5px; }
.pill {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .08em;
  padding: 3px 11px; border-radius: 20px; border: 0.5px solid var(--glass-border);
  background: transparent; color: var(--text-dim); cursor: pointer;
  transition: all 0.15s ease; line-height: 1.6;
}
.pill:hover { color: var(--text-deep); border-color: var(--accent); }
.pill-active { background: var(--accent); border-color: var(--accent); color: #fff; }

/* List */
.sotd-list { display: flex; flex-direction: column; gap: 0; padding-bottom: 5rem; }
.sotd-month-group { margin-bottom: 1rem; }
.sotd-month-label {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .22em;
  text-transform: uppercase; color: var(--accent-ink); opacity: 0.7;
  padding: 1.5rem 0 0.75rem; border-top: 0.5px solid var(--border-light);
}
.sotd-item {
  display: grid; grid-template-columns: 220px 1fr; gap: 2rem;
  padding: 2rem 0; border-bottom: 0.5px solid var(--border-light);
  transition: opacity 0.2s ease;
}
.sotd-item.hidden { display: none; }
.sotd-item-date {
  font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
  color: var(--text-dim); margin-bottom: .75rem;
}
.yt-thumb-link { display: block; text-decoration: none; }
.yt-thumb {
  position: relative; border-radius: 8px; overflow: hidden; cursor: pointer;
  background: #000; width: 100%; aspect-ratio: 16/9; border: 0.5px solid var(--glass-border);
}
.yt-thumb img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; transition: opacity .2s;
}
.yt-thumb:hover img { opacity: .75; }
.yt-thumb-play {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center; pointer-events: none;
}
.yt-thumb-btn {
  width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.9);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,.3); transition: transform .15s;
}
.yt-thumb:hover .yt-thumb-btn { transform: scale(1.1); }
.yt-thumb-tri {
  width: 0; height: 0; border-style: solid; border-width: 6px 0 6px 11px;
  border-color: transparent transparent transparent #1a1a1a; margin-left: 2px;
}
.sotd-title-link { text-decoration: none; }
.sotd-item-title {
  font-family: var(--font-serif); font-size: 26px; font-weight: 300;
  color: var(--text-deep); line-height: 1.2; margin-bottom: .2rem; transition: color 0.15s;
}
.sotd-title-link:hover .sotd-item-title { color: var(--accent-ink); }
.sotd-item-artist {
  font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  color: var(--accent-ink); margin-bottom: .2rem;
}
.sotd-item-album { font-size: 10px; color: var(--text-dim); margin-bottom: .5rem; }
.sotd-item-meta {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: .08em;
  color: var(--text-dim); opacity: 0.6; margin-bottom: .4rem;
}
.sotd-badges { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: .75rem; margin-top: .4rem; }
.sotd-item-mood {
  font-size: 9px; letter-spacing: .12em; text-transform: uppercase;
  padding: 3px 10px; border: 0.5px solid var(--glass-border); border-radius: 20px;
  color: var(--text-dim); display: inline-block;
}
.sotd-tag { border-color: var(--border-mid); }
.sotd-item-note { font-size: 11px; color: var(--text-mid); line-height: 1.8; margin-top: .5rem; }

.no-results {
  padding: 3rem 0; font-family: var(--font-mono); font-size: 11px;
  color: var(--text-dim); letter-spacing: .06em; text-align: center;
}

@media (max-width: 768px) {
  .page-sotd { padding: 0 1.5rem; }
  .sotd-header { padding: 3rem 0 2.5rem; }
  .sotd-item { grid-template-columns: 1fr; gap: 1rem; }
  .filter-group { flex-direction: column; gap: 0.5rem; }
}
</style>

<script>

import { onPage, disposer } from '../../utils/lifecycle';
import { initReveal } from '../../utils/reveal';


onPage(() => {
  const off = disposer();

  off.add(initReveal());

  const featuredThumb = document.getElementById('featured-thumb') as HTMLElement | null;
  const featuredPlayer = document.getElementById('featured-player') as HTMLElement | null;
  featuredThumb?.addEventListener('click', () => {
    const vid = featuredThumb.dataset.vid;
    if (!vid || !featuredPlayer) return;
    const w = featuredThumb.offsetWidth;
    const h = Math.round(w * 9 / 16);
    featuredPlayer.style.height = h + 'px';
    featuredPlayer.innerHTML = `<iframe width="${w}" height="${h}" src="https://www.youtube.com/embed/${vid}?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
    featuredPlayer.classList.add('open');
    featuredThumb.style.display = 'none';
  });

  let activeMood = '';
  let activeArtist = '';
  let activeDecade = '';

  function applyFilter() {
    const items = document.querySelectorAll<HTMLElement>('.sotd-item');
    const groups = document.querySelectorAll<HTMLElement>('.sotd-month-group');
    let visible = 0;
    items.forEach(item => {
      const mood   = item.dataset.mood   ?? '';
      const artist = item.dataset.artist ?? '';
      const decade = item.dataset.decade ?? '';
      const ok = (!activeMood || mood === activeMood)
              && (!activeArtist || artist === activeArtist)
              && (!activeDecade || decade === activeDecade);
      item.classList.toggle('hidden', !ok);
      if (ok) visible++;
    });
    groups.forEach(group => {
      group.style.display = group.querySelector('.sotd-item:not(.hidden)') ? '' : 'none';
    });
    const noResults = document.getElementById('no-results');
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  }

  function bindPills(containerId: string, filterKey: 'mood' | 'artist' | 'decade') {
    const container = document.getElementById(containerId);
    container?.querySelectorAll<HTMLButtonElement>('.pill').forEach(btn => {
      btn.addEventListener('click', () => {
        container.querySelectorAll('.pill').forEach(p => p.classList.remove('pill-active'));
        btn.classList.add('pill-active');
        if (filterKey === 'mood')   activeMood   = btn.dataset.value ?? '';
        if (filterKey === 'artist') activeArtist = btn.dataset.value ?? '';
        if (filterKey === 'decade') activeDecade = btn.dataset.value ?? '';
        applyFilter();
      });
    });
  }

  bindPills('mood-pills',   'mood');
  bindPills('artist-pills', 'artist');
  bindPills('decade-pills', 'decade');

  const randomBtn = document.getElementById('random-btn');
  randomBtn?.addEventListener('click', () => {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.sotd-item:not(.hidden)'));
    if (!items.length) return;
    const pick = items[Math.floor(Math.random() * items.length)];
    const id = pick.dataset.id;
    if (id) window.location.href = `/sotd/${id}`;
  });

  return off.run;
});
</script>
