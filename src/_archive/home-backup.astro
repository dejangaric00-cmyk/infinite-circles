---
// src/pages/home-backup.astro
// BACKUP der alten Homepage — nicht aktiv, nur zur Sicherung.
// Enthält: Hero "Listening, thinking, making.", Sonne/Mond/AQI-Panel, Stack-Tags.
// Für späteres Redesign von about.astro oder als Referenz.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Infinite Circles — Dejan">

  <canvas id="circle-canvas"></canvas>

  <section class="hero">
    <div>
      <h1 class="h1-reveal">
        <span class="word" style="--i:0">Listening,</span><br>
        <em class="word shimmer-em" style="--i:1">thinking,</em><br>
        <span class="word" style="--i:2">making.</span>
      </h1>
      <p class="hero-tagline reveal" style="transition-delay:.45s">
        Building with AI as collaborator.<span class="cursor">█</span>
      </p>

      <div class="hero-tags reveal" style="transition-delay:.55s">

        <div class="tags-section">
          <div class="tags-label">Stack</div>
          <div class="tags-row">
            <span class="tag tag-blue"><span class="dot"></span>Claude</span>
            <span class="tag tag-blue"><span class="dot"></span>Cursor</span>
            <span class="tag tag-blue-mid"><span class="dot"></span>Astro</span>
            <span class="tag tag-blue-mid"><span class="dot"></span>VS Code</span>
            <span class="tag tag-slate"><span class="dot"></span>Git</span>
          </div>
        </div>

        <div class="tags-section">
          <div class="tags-label">Sprachen</div>
          <div class="tags-row">
            <span class="tag tag-blue-mid"><span class="dot"></span>HTML</span>
            <span class="tag tag-blue-mid"><span class="dot"></span>CSS</span>
            <span class="tag tag-blue"><span class="dot"></span>JavaScript</span>
            <span class="tag tag-slate"><span class="dot"></span>Python · 12%</span>
          </div>
        </div>

        <div class="tags-section">
          <div class="tags-label">Interessen</div>
          <div class="tags-row">
            <span class="tag tag-blue"><span class="dot"></span>Music curation</span>
            <span class="tag tag-blue-mid"><span class="dot"></span>Generative art</span>
            <span class="tag tag-amber-soft"><span class="dot"></span>Writing</span>
            <span class="tag tag-gray"><span class="dot"></span>Hannover</span>
          </div>
        </div>

      </div>
    </div>
    <div class="hero-right reveal" style="transition-delay:.35s">

      <div class="signal-panel">
        <div class="panel-header">52°N 9°E · Hannover</div>

        <div class="sig-block">
          <div class="sig-label">Sonne</div>
          <div class="sun-arc-wrap">
            <canvas id="sun-arc"></canvas>
          </div>
          <div class="sig-val" id="sun-times">—</div>
          <div class="sig-val" id="sun-daylength">—</div>
          <div class="sig-val" id="sun-countdown">—</div>
        </div>

        <div class="sig-divider"></div>

        <div class="sig-block">
          <div class="sig-label">Mond</div>
          <div class="moon-wrap">
            <canvas id="moon-canvas" width="28" height="28"></canvas>
            <div>
              <div class="sig-val" id="moon-name">—</div>
              <div class="sig-val" id="moon-pct">—</div>
            </div>
          </div>
        </div>

        <div class="sig-divider"></div>

        <div class="sig-block">
          <div class="sig-label">Luftqualität</div>
          <div class="sig-val" id="aqi-value">—</div>
          <div class="sig-val" id="aqi-label">wird geladen…</div>
        </div>

        <div class="sig-divider"></div>

        <div class="sig-block">
          <div class="sig-label">Position</div>
          <div class="sig-val">Hannover · 52.3759° N · 9.7320° E</div>
          <div class="sig-val">UTC+2 · CEST</div>
        </div>

      </div>

    </div>
  </section>

</BaseLayout>

<style is:global>
#circle-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: -1;
  pointer-events: none;
}
.hero {
  padding: 5.5rem 4rem 4rem;
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 6rem;
  align-items: start;
}
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(48px, 6vw, 80px);
  font-weight: 300;
  line-height: 1.03;
  margin-bottom: 1.5rem;
  color: var(--text-deep);
}
.word {
  display: inline-block;
  opacity: 0;
  transform: translateY(18px);
  transition: opacity .55s ease, transform .55s ease;
  transition-delay: calc(var(--i) * 0.13s);
}
.hero h1.in .word { opacity: 1; transform: translateY(0); }

@keyframes shimmer-flow {
  0%   { background-position: -200% center; }
  100% { background-position:  200% center; }
}
.shimmer-em {
  font-style: italic;
  background: linear-gradient(110deg, var(--accent) 0%, var(--accent2) 30%, #a8d4ff 50%, var(--accent2) 70%, var(--accent) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer-flow 4s linear infinite;
}
html.dark .shimmer-em {
  background: linear-gradient(110deg, #7ab8f0 0%, #b8d8f8 30%, #e0f0ff 50%, #b8d8f8 70%, #7ab8f0 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer-flow 4s linear infinite;
}
.hero-tagline {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: .06em;
  color: var(--text-deep);
  margin-bottom: 1.8rem;
  opacity: 0.85;
  display: flex;
  align-items: baseline;
  gap: 3px;
}
@keyframes blink { 0%,49%{opacity:1} 50%,100%{opacity:0} }
.cursor { font-size:9px; color:var(--accent); animation:blink 1.1s step-end infinite; line-height:1; margin-left:1px; }

.hero-tags { display:flex; flex-direction:column; gap:0.9rem; }
.tags-section { display:flex; flex-direction:column; gap:0.3rem; }
.tags-label { font-family:var(--font-mono); font-size:8px; letter-spacing:.16em; text-transform:uppercase; color:var(--text-dim); margin-bottom:0.15rem; }
.tags-row { display:flex; flex-wrap:wrap; gap:5px; }
.tag { display:inline-flex; align-items:center; gap:4px; font-size:10px; letter-spacing:.03em; padding:3px 9px; border-radius:4px; font-family:var(--font-mono); line-height:1; transition:transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease; }
.tag:hover { transform:translateY(-1px); filter:brightness(1.06); }
.tag .dot { width:5px; height:5px; border-radius:50%; flex-shrink:0; }
.tag-blue     { background:#E6F1FB; color:#0C447C; }
.tag-blue:hover { box-shadow:0 2px 10px rgba(55,138,221,0.25); }
.tag-blue .dot { background:#378ADD; }
.tag-blue-mid { background:#dceefb; color:#185FA5; }
.tag-blue-mid:hover { box-shadow:0 2px 10px rgba(55,138,221,0.20); }
.tag-blue-mid .dot { background:#378ADD; }
.tag-slate    { background:#f0f2f5; color:#4a5060; }
.tag-slate:hover { box-shadow:0 2px 8px rgba(72,80,96,0.15); }
.tag-slate .dot { background:#8890a0; }
.tag-gray     { background:#F1EFE8; color:#5F5E5A; }
.tag-gray:hover { box-shadow:0 2px 8px rgba(95,94,90,0.15); }
.tag-gray .dot { background:#B4B2A9; }
.tag-amber-soft { background:#fdf3e3; color:#7a5010; }
.tag-amber-soft:hover { box-shadow:0 2px 10px rgba(200,133,14,0.22); }
.tag-amber-soft .dot { background:#c8850e; }
html.dark .tag-blue     { background:rgba(55,138,221,0.15); color:#7ab8f0; }
html.dark .tag-blue-mid { background:rgba(55,138,221,0.10); color:#5a9fd4; }
html.dark .tag-slate    { background:rgba(255,255,255,0.06); color:#8890a0; }
html.dark .tag-gray     { background:rgba(255,255,255,0.05); color:#9b9994; }
html.dark .tag-amber-soft { background:rgba(200,133,14,0.12); color:#d4a060; }

.signal-panel { display:flex; flex-direction:column; gap:0; }
.panel-header { font-size:8px; letter-spacing:.18em; text-transform:uppercase; color:var(--text-dim); font-family:var(--font-mono); margin-bottom:1.25rem; }
.sig-block { display:flex; flex-direction:column; gap:0.22rem; padding:0.7rem 0; }
@keyframes divider-grow { from{width:0;opacity:0} to{width:28px;opacity:0.15} }
.sig-divider { width:28px; height:0.5px; background:currentColor; opacity:0.15; animation:divider-grow 0.6s ease forwards; animation-play-state:paused; }
.hero-right.in .sig-divider { animation-play-state:running; }
.hero-right.in .sig-divider:nth-of-type(1) { animation-delay:0.1s; }
.hero-right.in .sig-divider:nth-of-type(2) { animation-delay:0.25s; }
.hero-right.in .sig-divider:nth-of-type(3) { animation-delay:0.40s; }
.sig-label { font-size:8px; letter-spacing:.16em; text-transform:uppercase; color:var(--text-dim); font-family:var(--font-mono); margin-bottom:0.3rem; }
.sig-val { font-family:var(--font-mono); font-size:10px; font-weight:400; color:var(--text-deep); line-height:1.7; letter-spacing:.03em; }
.sun-arc-wrap { margin:4px 0 2px; }
#sun-arc { display:block; }
.moon-wrap { display:flex; align-items:center; gap:10px; margin-top:2px; }
#moon-canvas { display:block; flex-shrink:0; }
.reveal { opacity:0; transform:translateY(14px); transition:opacity .5s ease, transform .5s ease; }
.reveal.in { opacity:1; transform:translateY(0); }
.h1-reveal { opacity:1; transform:none; }
@media (max-width: 768px) {
  .hero { grid-template-columns:1fr; gap:2.5rem; padding:3rem 1.5rem 2.5rem; }
}
</style>

<script>
const observer = new IntersectionObserver(
  (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
  { threshold: 0.1 }
);
document.querySelectorAll('.reveal, .h1-reveal').forEach(el => observer.observe(el));

const LAT = 52.3759, LNG = 9.7320;
const isDark = () => document.documentElement.classList.contains('dark');
function fmt(d) { return d.toLocaleTimeString('de-DE', { hour:'2-digit', minute:'2-digit' }); }
function fmtDuration(ms) { const s=Math.round(ms/1000); return { h:Math.floor(s/3600), m:Math.floor((s%3600)/60) }; }

function getSunTimes(date, lat, lng) {
  const J1970=2440588, J2000=2451545, rad=Math.PI/180;
  const toJ = d => d.valueOf()/86400000 - 0.5 + J1970;
  const n = toJ(date) - J2000;
  const M = (357.5291 + 0.98560028*n)*rad;
  const C = (1.9148*Math.sin(M) + 0.02*Math.sin(2*M) + 0.0003*Math.sin(3*M))*rad;
  const P = 102.9372*rad;
  const lambda = M+C+P+Math.PI;
  const sinD = Math.sin(lambda)*Math.sin(23.45*rad);
  const cosD = Math.cos(Math.asin(sinD));
  const Jnoon = J2000 + 0.0009 + ((-lng)/360) + Math.round(n-(-lng)/360);
  const w0 = Math.acos((Math.sin(-0.833*rad) - Math.sin(lat*rad)*sinD)/(Math.cos(lat*rad)*cosD));
  const fromJ = j => new Date((j+0.5-J1970)*86400000);
  return { sunrise: fromJ(Jnoon - w0/(2*Math.PI)), sunset: fromJ(Jnoon + w0/(2*Math.PI)) };
}

function dayColor(f) {
  const stops = [[0,[180,60,120]],[0.08,[255,100,50]],[0.18,[255,170,60]],[0.30,[255,210,100]],[0.45,[160,210,255]],[0.50,[185,225,255]],[0.55,[160,210,255]],[0.70,[255,200,80]],[0.82,[255,140,50]],[0.92,[220,70,90]],[1,[130,30,100]]];
  for (let i=0;i<stops.length-1;i++) {
    const [f0,c0]=stops[i],[f1,c1]=stops[i+1];
    if (f>=f0&&f<=f1) { const t=(f-f0)/(f1-f0); return [Math.round(c0[0]+(c1[0]-c0[0])*t),Math.round(c0[1]+(c1[1]-c0[1])*t),Math.round(c0[2]+(c1[2]-c0[2])*t)]; }
  }
  return stops[stops.length-1][1];
}

function drawSunArc() {
  const canvas = document.getElementById('sun-arc');
  if (!canvas) return;
  const W=200, r=88, H=r+22;
  canvas.width=W; canvas.height=H; canvas.style.width=W+'px'; canvas.style.height=H+'px';
  const ctx=canvas.getContext('2d');
  const now=new Date(), dark=isDark();
  const {sunrise,sunset}=getSunTimes(now,LAT,LNG);
  const yesterday=new Date(now); yesterday.setDate(yesterday.getDate()-1);
  const {sunrise:ysr,sunset:yss}=getSunTimes(yesterday,LAT,LNG);
  const todayLen=sunset.getTime()-sunrise.getTime(), yestLen=yss.getTime()-ysr.getTime(), diff=todayLen-yestLen;
  const cx=W/2, cy=H-6, steps=160;
  const total=sunset.getTime()-sunrise.getTime();
  const elapsed=Math.max(0,Math.min(total,now.getTime()-sunrise.getTime()));
  const prog=elapsed/total, pSteps=Math.round(prog*steps);
  ctx.clearRect(0,0,W,H);
  for (let i=0;i<steps;i++) {
    const f=i/steps,a1=Math.PI+f*Math.PI,a2=Math.PI+((i+1)/steps)*Math.PI;
    const [rc,gc,bc]=dayColor(f);
    ctx.beginPath(); ctx.arc(cx,cy,r,a1,a2);
    ctx.strokeStyle=`rgba(${rc},${gc},${bc},${dark?0.12:0.14})`; ctx.lineWidth=1.2; ctx.stroke();
  }
  for (let i=0;i<pSteps;i++) {
    const f=i/steps,a1=Math.PI+f*Math.PI,a2=Math.PI+((i+1)/steps)*Math.PI;
    const [rc,gc,bc]=dayColor(f);
    ctx.beginPath(); ctx.arc(cx,cy,r,a1,a2);
    ctx.strokeStyle=`rgba(${rc},${gc},${bc},${dark?0.22:0.28})`; ctx.lineWidth=5; ctx.stroke();
    ctx.beginPath(); ctx.arc(cx,cy,r,a1,a2);
    ctx.strokeStyle=`rgba(${rc},${gc},${bc},${dark?0.82:0.95})`; ctx.lineWidth=1.8; ctx.stroke();
  }
  const sa=Math.PI+prog*Math.PI, sx=cx+Math.cos(sa)*r, sy=cy+Math.sin(sa)*r;
  const [cr,cg,cb]=dayColor(prog);
  const g2=ctx.createRadialGradient(sx,sy,0,sx,sy,16);
  g2.addColorStop(0,`rgba(${cr},${cg},${cb},0.50)`); g2.addColorStop(0.5,`rgba(${cr},${cg},${cb},0.15)`); g2.addColorStop(1,`rgba(${cr},${cg},${cb},0)`);
  ctx.fillStyle=g2; ctx.beginPath(); ctx.arc(sx,sy,16,0,Math.PI*2); ctx.fill();
  const g1=ctx.createRadialGradient(sx,sy,0,sx,sy,7);
  g1.addColorStop(0,'rgba(255,245,210,0.98)'); g1.addColorStop(0.6,`rgba(${cr},${cg},${cb},0.60)`); g1.addColorStop(1,`rgba(${cr},${cg},${cb},0)`);
  ctx.fillStyle=g1; ctx.beginPath(); ctx.arc(sx,sy,7,0,Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(sx,sy,2,0,Math.PI*2); ctx.fillStyle='#fff'; ctx.fill();
  const tEl=document.getElementById('sun-times'), dlEl=document.getElementById('sun-daylength'), cdEl=document.getElementById('sun-countdown');
  if (tEl) tEl.textContent=`Aufgang ${fmt(sunrise)} · Untergang ${fmt(sunset)}`;
  if (dlEl) {
    const {h,m}=fmtDuration(todayLen), dSec=Math.round(diff/1000), sign=dSec>=0?'+':'−', abs=Math.abs(dSec), dm=Math.floor(abs/60), ds=abs%60;
    dlEl.textContent=`Tageslänge ${h}h ${m}min · ${dm>0?`${sign}${dm}min ${ds}sek`:`${sign}${ds}sek`} ggü. gestern`;
  }
  if (cdEl) {
    const msLeft=sunset.getTime()-now.getTime();
    if (msLeft>0) { const {h,m}=fmtDuration(msLeft); cdEl.textContent=h>0?`Untergang in ${h}h ${m}min`:`Untergang in ${m}min`; }
    else { const {h,m}=fmtDuration(sunrise.getTime()+86400000-now.getTime()); cdEl.textContent=`Aufgang in ${h}h ${m}min`; }
  }
}

function getMoonPhase(date) {
  const known=new Date(2000,0,6,18,14,0), syn=29.530588853;
  const diff=((date.getTime()-known.getTime())/(1000*60*60*24)%syn+syn)%syn/syn;
  let name='';
  if (diff<0.03||diff>0.97) name='Neumond';
  else if (diff<0.22) name='Zunehmende Sichel';
  else if (diff<0.28) name='Erstes Viertel';
  else if (diff<0.47) name='Zunehmender Mond';
  else if (diff<0.53) name='Vollmond';
  else if (diff<0.72) name='Abnehmender Mond';
  else if (diff<0.78) name='Letztes Viertel';
  else name='Abnehmende Sichel';
  return { frac:diff, name };
}

function drawMoon() {
  const canvas=document.getElementById('moon-canvas'); if(!canvas)return;
  const ctx=canvas.getContext('2d'), {frac,name}=getMoonPhase(new Date()), dark=isDark();
  const r=12,cx=14,cy=14;
  ctx.clearRect(0,0,28,28);
  ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2);
  ctx.fillStyle=dark?'rgba(255,255,255,0.06)':'rgba(0,0,0,0.06)'; ctx.fill();
  ctx.strokeStyle=dark?'rgba(255,255,255,0.20)':'rgba(0,0,0,0.12)'; ctx.lineWidth=0.7; ctx.stroke();
  const angle=frac*Math.PI*2, ill=Math.cos(angle);
  ctx.save(); ctx.beginPath(); ctx.arc(cx,cy,r,Math.PI/2,-Math.PI/2,false);
  ctx.ellipse(cx,cy,Math.abs(r*ill),r,0,-Math.PI/2,Math.PI/2,ill<0); ctx.closePath();
  ctx.fillStyle=dark?'rgba(255,250,200,0.75)':'rgba(255,230,110,0.88)'; ctx.fill(); ctx.restore();
  const nameEl=document.getElementById('moon-name'), pctEl=document.getElementById('moon-pct');
  if (nameEl) nameEl.textContent=name;
  if (pctEl) pctEl.textContent=`${Math.round(Math.abs(Math.cos(frac*Math.PI*2))*100)}% beleuchtet`;
}

async function fetchAQI() {
  try {
    const res=await fetch(`https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${LAT}&longitude=${LNG}&current=european_aqi`);
    const data=await res.json(), aqi=data?.current?.european_aqi;
    const valEl=document.getElementById('aqi-value'), lblEl=document.getElementById('aqi-label');
    if (!valEl||!lblEl||aqi==null) return;
    valEl.textContent=`AQI ${aqi}`;
    let label='',color='';
    if (aqi<=20){label='Sehr gut';color='#4caf7d';}
    else if(aqi<=40){label='Gut';color='#8bc34a';}
    else if(aqi<=60){label='Mäßig';color='#ffc107';}
    else if(aqi<=80){label='Schlecht';color='#ff7043';}
    else{label='Sehr schlecht';color='#e53935';}
    lblEl.textContent=label; lblEl.style.color=color;
  } catch { const l=document.getElementById('aqi-label'); if(l)l.textContent='Nicht verfügbar'; }
}

drawSunArc(); drawMoon(); fetchAQI();
setInterval(drawSunArc, 60000);
document.getElementById('dm-btn')?.addEventListener('click',()=>{ setTimeout(()=>{drawSunArc();drawMoon();},50); });

// Infinite Circles Canvas
const canvas=document.getElementById('circle-canvas');
if (canvas) {
  const ctx2=canvas.getContext('2d');
  let W=0,H=0;
  const resize=()=>{W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;};
  resize(); window.addEventListener('resize',resize);
  const isDarkFn=()=>document.documentElement.classList.contains('dark');
  const rings=[{rf:0.10,speed:0.0018,offset:0.00},{rf:0.18,speed:0.0014,offset:0.90},{rf:0.27,speed:0.0011,offset:1.80},{rf:0.37,speed:0.0009,offset:2.70},{rf:0.47,speed:0.0007,offset:3.60},{rf:0.58,speed:0.0005,offset:4.50},{rf:0.70,speed:0.0004,offset:5.40}];
  let t=0;
  const draw=()=>{
    ctx2.clearRect(0,0,W,H);
    const dark=isDarkFn(), cx=W>768?W*0.72:W*0.5, cy=H*0.42, base=Math.min(W,H), alpha=dark?0.12:0.18;
    for (const ring of rings) {
      const r=base*ring.rf;
      ctx2.beginPath(); ctx2.arc(cx,cy,r,0,Math.PI*2);
      ctx2.strokeStyle=`rgba(255,255,255,${alpha})`; ctx2.lineWidth=0.8; ctx2.stroke();
      const angle=t*ring.speed+ring.offset, dotX=cx+Math.cos(angle)*r, dotY=cy+Math.sin(angle)*r, dotSize=r*0.08;
      const glow=ctx2.createRadialGradient(dotX,dotY,0,dotX,dotY,dotSize);
      glow.addColorStop(0,dark?'rgba(220,240,255,0.90)':'rgba(255,255,255,0.95)');
      glow.addColorStop(0.3,dark?'rgba(180,220,255,0.45)':'rgba(220,235,255,0.40)');
      glow.addColorStop(1,'rgba(180,220,255,0)');
      ctx2.fillStyle=glow; ctx2.beginPath(); ctx2.arc(dotX,dotY,dotSize,0,Math.PI*2); ctx2.fill();
      const trailLen=Math.PI*0.35, trailStart=angle-trailLen;
      const trail=ctx2.createLinearGradient(cx+Math.cos(trailStart)*r,cy+Math.sin(trailStart)*r,dotX,dotY);
      const tc=dark?'200,225,255':'255,255,255';
      trail.addColorStop(0,`rgba(${tc},0)`); trail.addColorStop(1,`rgba(${tc},${dark?0.18:0.22})`);
      ctx2.beginPath(); ctx2.arc(cx,cy,r,trailStart,angle);
      ctx2.strokeStyle=trail; ctx2.lineWidth=dark?1.2:1.4; ctx2.stroke();
    }
    t++; requestAnimationFrame(draw);
  };
  draw();
}
</script>
